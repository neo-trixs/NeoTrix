#!/bin/bash
# NeoTrix pre-commit hook (激活于 core.hooksPath=.githooks)。
# 两层门禁:
#   1) AGENTS.md 指针守恒 — 拒绝把 cycle 正文/增长区写回 AGENTS.md。
#   2) P0 编译卡点 — 拒绝把红构建(comlib 或测试编译失败)提交入库。
#
# 注意: 本 hook 仅拦"走 hook"的提交。openhands 等绕过 --no-verify / libgit2 的提交
# 仍会绕过此处 —— 权威门禁是 CI (.github/workflows/ci.yml, push/PR 跑 cargo check+test)
# 配合 main 分支的 branch protection + required status checks。pre-push (.githooks/pre-push)
# 为推送级二次防线。
set -uo pipefail

# ---------- 1) AGENTS.md 指针守恒门禁 ----------
MAX_LINES=130
MAX_BYTES=22000
AGENTS="AGENTS.md"

if [ -f "$AGENTS" ] && git diff --cached --name-only | grep -qx "$AGENTS"; then
  LINES=$(git show ":$AGENTS" 2>/dev/null | wc -l | tr -d ' ')
  BYTES=$(git show ":$AGENTS" 2>/dev/null | wc -c | tr -d ' ')
  FAIL=0
  if [ "$LINES" -gt "$MAX_LINES" ]; then
    echo "✗ [AGENTS-GUARD] AGENTS.md would exceed $MAX_LINES lines ($LINES). Cycle bodies belong in KB, not here."
    FAIL=1
  fi
  if [ "$BYTES" -gt "$MAX_BYTES" ]; then
    echo "✗ [AGENTS-GUARD] AGENTS.md would exceed $MAX_BYTES bytes ($BYTES). Violation of pointer-conservation HARD RULE."
    FAIL=1
  fi
  if git show ":$AGENTS" 2>/dev/null | grep -q "^## .*Cycle.*"; then
    echo "✗ [AGENTS-GUARD] AGENTS.md contains cycle-body sections. Must be moved to KB via experience-tree."
    FAIL=1
  fi
  if [ "$FAIL" -ne 0 ]; then
    echo "  Pointers live in KB: python3 ~/.agents/skills/experience-tree/scripts/absorb_session.py hub"
    echo "  Then revert AGENTS.md to HEAD and commit only pointer/rule changes."
    exit 1
  fi
fi

# ---------- 2) P0 编译卡点 ----------
# 仅当本次提交触及 Rust 源码时才跑, 避免纯文档/脚本提交被当前红构建卡死。
# --tests 覆盖 lib + 测试目标, 能拦住 "lib 绿但测试编译红" 的回归
# (本仓库曾出现 LlmResponse 字面量漏字段导致测试编译失败却入库的情况)。
if git diff --cached --name-only | grep -qE '\.rs$'; then
  echo -e "\033[1;33m🔨 P0 pre-commit gate: cargo check --tests -p neotrix ...\033[0m"
  # SIM-23: -j4 caps rustc parallelism; default -j10 OOM-kills on 10c/low-mem boxes
  # (Killed: 9, 2026-09-21). Same check, lower peak memory. See NT-STD NTS-D01.
  if ! cargo check --tests -p neotrix -j4 >/tmp/precommit-cargo-check.log 2>&1; then
    echo -e "\033[0;31m❌ BUILD GATE FAILED: neotrix 未通过编译(test), 拒绝提交\033[0m"
    echo -e "\033[1;33m   详见 /tmp/precommit-cargo-check.log; 加 --no-verify 可绕过 (不推荐, 会破坏 P0)\033[0m"
    exit 1
  fi
  echo -e "\033[0;32m✅ Build gate passed\033[0m"
fi

# ---------- 2.5) task-index 自门（blocking）----------
# .neotrix/task-index.json 是「日常任务该跑哪个工具」的唯一机器索引。
# 它会漂移：脚本改名/删除后索引仍指向旧路径 ⇒ agent 照着跑会 command not found，
# 且**静默失败**（比报错更贵）。故每次提交校验工具路径确实存在。
if [ -f .neotrix/task-index.json ] && [ -f scripts/ops/nt_find.py ]; then
  # Context Manifest 自门：file:line 证据是否还指向实文件/有效行。
  # 依据 R-DISK-8「测逻辑 ≠ 测可达性」的同类教训：记了 file:line ≠ 它还指在那里。
  if [ -f .neotrix/context-manifest.json ] && ! python3 scripts/ops/nt_manifest.py audit >/tmp/nt-manifest-audit.log 2>&1; then
    echo -e "\033[0;31m❌ CONTEXT-MANIFEST GATE: file:line 证据已失效\033[0m"
    sed 's|^|   |' /tmp/nt-manifest-audit.log
    echo -e "\033[1;33m   行号漂移或文件被删 ⇒ 那是**假证据**。修 manifest 或重验结论\033[0m"
    exit 1
  fi
  # 扫描面守门：脚本引用的扫描根若已消失，扫描器会输出**看似正常的 0**
  # （路径不存在 ≠ 该面为空）。blocking，防新增死引用。
  if [ -f scripts/ops/nt_scan_surface.py ]; then
    if ! python3 scripts/ops/nt_scan_surface.py >/tmp/nt-scan-surface.log 2>&1; then
      echo -e "\033[0;31m❌ SCAN-SURFACE GATE: 扫描器引用了已消失的面\033[0m"
      sed 's|^|   |' /tmp/nt-scan-surface.log
      echo -e "\033[1;33m   后果：该扫描器会输出 0，而你以为「扫过了确实没有」\033[0m"
      echo -e "\033[1;33m   修法：删死引用并记因由，或改指新位置（KNOWN-GONE 需在脚本里登记）\033[0m"
      exit 1
    fi
  fi
  if ! python3 scripts/ops/nt_find.py --audit >/tmp/nt-find-audit.log 2>&1; then
    echo -e "\033[0;31m❌ TASK-INDEX GATE: .neotrix/task-index.json 指向不存在的工具\033[0m"
    sed 's|^|   |' /tmp/nt-find-audit.log
    echo -e "\033[1;33m   修法：跑 make find-audit 看详情，然后更新索引或恢复脚本\033[0m"
    exit 1
  fi
fi

# ---------- 2.6) 覆盖率洞提示位（R-COV-1; advisory, 永不拦门）----------
# 依据 R-P79 的自反版本：「工具写好了但没人调用」和「函数写好了但没人调用」
# 是**同一类**缺陷。2026-09-29 实测：`nt_coverage_gaps.py` 造好后被 0 个门引用，
# 而它当场就报出 `prune_best_effort` 零生产调用（R-P79 违规）——
# 尺子自己也是「没人用的尺子」。故在此接线。
#
# 为什么 advisory 而非 blocking：存量基线是 4455 洞（neotrix-core 24%），
# blocking 会让本门永久红 ⇒ 门一旦恒红就等于没有门（R-SCAN-3 同理）。
# 只对**本次改动**的 .rs 跑增量模式，提示新增洞，死代码直接点名。
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -n "$STAGED_RS" ] && [ -f scripts/ops/nt_coverage_gaps.py ]; then
  for crate_src in crates/neotrix-neobot/src neotrix-core/src; do
    [ -d "$crate_src" ] || continue
    only=""
    for f in $STAGED_RS; do
      case "$f" in
        "$crate_src"/*) only="${only:+$only,}${f#"$crate_src"/}" ;;
      esac
    done
    [ -n "$only" ] || continue
    out=$(python3 scripts/ops/nt_coverage_gaps.py "$crate_src" --only "$only" 2>/dev/null) || true
    # 2026-09-29 自修：`holeds` 曾写成 `[ "$holeds" -gt 0 ] && ...` 的短路形式，
    # 而上一条 `grep -cE ... || true` 在**无匹配时返回 1** ⇒ `set -u` 下
    # `holeds` 从未被赋值就���读取 ⇒ `unbound variable` ⇒ 整段门**静默不执行**。
    # 教训（已记入 R-P79 自反条款）：门脚本里「赋值」不许出现在 `&&` 右侧。
    holeds=$(echo "$out" | grep -cE '^[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+\S+\.rs$' || true)
    deads=$(echo "$out" | grep -cE '^[[:space:]]+☠ ' || true)
    if [ "${holeds:-0}" -gt 0 ] || [ "${deads:-0}" -gt 0 ]; then
      echo -e "\033[1;33m📊 coverage-gaps advisory（$crate_src:\033[0m"
      echo "$out" | grep -E '^[[:space:]]+☠ ' | head -5 | sed 's|^|   |'
      [ "${holeds:-0}" -gt 0 ] && echo "   （完整清单：python3 scripts/ops/nt_coverage_gaps.py ${crate_src})"
      echo -e "\033[1;33m   ☠ = 零真实调用者（死代码候选）；其余为「测试从未触碰」的入口\033[0m"
    fi
  done
fi

# ---------- 3) doc-drift 提示位 (SIM-42/EQ-12; advisory, 永不拦门) ----------
# check-doc-drift.sh 基线 111 (2026-09-21)。只提示不阻断：基线变化靠 CI audit-all 裁决。
if [ -x scripts/check-doc-drift.sh ]; then
  echo -e "\033[1;33m📝 doc-drift advisory:\033[0m"
  scripts/check-doc-drift.sh 2>&1 | tail -2 || true
fi

exit 0
