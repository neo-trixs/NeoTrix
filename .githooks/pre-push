#!/usr/bin/env bash
# Pre-push compile gate (P0 defense-in-depth): 拒绝把红构建推送到远程。
# 即使本地 WIP 提交绕过 pre-commit hook (--no-verify / libgit2), 也绝不离开本机。
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo -e "\033[1;33m🔨 P0 pre-push gate: cargo check -p neotrix --lib ...\033[0m"
if ! cargo check -p neotrix --lib >/tmp/prepush-cargo-check.log 2>&1; then
    echo -e "\033[0;31m❌ BUILD GATE FAILED: neotrix lib 未通过编译, 拒绝推送\033[0m"
    echo -e "\033[1;33m   详见 /tmp/prepush-cargo-check.log; 加 --no-verify 可绕过 (不推荐)\033[0m"
    exit 1
fi
echo -e "\033[0;32m✅ Build gate passed\033[0m"

echo -e "\033[1;33m🔨 P0 pre-push gate: egress privacy guard regression ...\033[0m"
if ! cargo test -p neotrix --lib egress_guard >/tmp/prepush-egress-test.log 2>&1; then
    echo -e "\033[0;31m❌ EGRESS GATE FAILED: egress_privacy_guard 测试未通过, 拒绝推送\033[0m"
    echo -e "\033[1;33m   详见 /tmp/prepush-egress-test.log; 加 --no-verify 可绕过 (不推荐)\033[0m"
    exit 1
fi
echo -e "\033[0;32m✅ Egress guard gate passed\033[0m"

# ---------- 收工门：worktree 与未提交改动泄漏检查 ----------
# 依据 2026-09-28 实测：22 个 worktree 占 28G、850 处未提交改动不在任何提交里，
# 全靠事后大扫除才救回来（且那次扫除误删了 ratchet，靠 patch 才恢复）。
# 推送是「一个 agent 认为自己做完了」的自然信号点，故在此拦。
# 只拦**明确违规**：存在脏 worktree 且既没兜底也没声明弃用。advisory 不拦。
echo -e "\033[1;33m🔨 P0 pre-push gate: worktree 收工检查 ...\033[0m"
WT_CODE=0
WT_OUT=""
# `set -e` 下用 `||` 承接退出码，不能用 `$(...)` 捕获 $?（赋值本身会清掉）
if WT_OUT=$(sh scripts/ops/nt_worktree_gate.sh check 2>/dev/null); then
    WT_CODE=0
else
    WT_CODE=$?
fi
LEAK=0
case "$WT_CODE" in
    4) LEAK=1 ;;
    3) echo -e "\033[1;33m   ♻️  worktree target 累计偏大，建议 push 前跑 nt_worktree_gate.sh clean\033[0m" ;;
esac
if [ "$LEAK" -eq 1 ]; then
    echo -e "\033[0;31m❌ WORKTREE GATE: 存在带未提交改动的 worktree\033[0m"
    echo "$WT_OUT" | grep -E 'worktree=|未提交改动' | sed 's|^|   |'
    echo -e "\033[1;33m   这些改动**不在任何提交里**，删目录即永久丢失。收工三选一：\033[0m"
    echo -e "\033[1;33m   1) 提交：cd <worktree> && git add -A && git commit\033[0m"
    echo -e "\033[1;33m   2) 兜底：sh scripts/ops/nt_worktree_gate.sh prune --force（导出 patch 后移除）\033[0m"
    echo -e "\033[1;33m   3) 明确弃用：在 sessions/handoff-*.md §8.2 写明理由\033[0m"
    echo -e "\033[1;33m   若确认是**他窗**活跃 worktree，加 --no-verify 并在 handoff 注明\033[0m"
    exit 1
fi
echo -e "\033[0;32m✅ Worktree 收工检查通过\033[0m"
