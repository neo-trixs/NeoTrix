<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>NeoTrix · 液态玻璃</title>
<style>
  :root {
    /* ════════════════════════════════════════════════
       NeoTrix Design System v2 — "Consciousness Glass"
       Layer 1: Base Tokens (raw values)

       核心设计原则: 逆时针 (CCW)
       ─────────────────────────────────
       所有旋转动画统一为逆时针方向，象征:
       · 时间回溯 — 元认知回头看自己
       · 意识自省 — L9 超验层只读不写
       · E8 状态反转 — 推理可逆性
       禁止出现顺时针旋转。
       ════════════════════════════════════════════════ */

    /* ---- Brand Palette ---- */
    --red: #E85454;
    --green: #4CAF50;
    --yellow: #FFC107;
    --pri: #E85454;
    --pri2: #D04040;
    --pri3: #F26B6B;
    --orange: #FF9800;

    /* ---- Neutral Scale ---- */
    --white: #FFFFFF;
    --gray-50: #F5F5F7;
    --gray-100: #E8E8EC;
    --gray-200: #D4D4D8;
    --gray-300: #B0B0B8;
    --gray-400: #909098;
    --gray-500: #707078;
    --gray-600: #5A5A62;
    --gray-700: #3A3A42;
    --gray-800: #2A2A30;
    --gray-900: #1A1A20;
    --black: #0A0A0E;

    /* ---- Semantic Aliases ---- */
    --des: var(--red);
    --suc: var(--green);
    --war: var(--yellow);

    /* ---- Spacing Scale (4px base) ---- */
    --sp-0: 0px;    --sp-1: 2px;    --sp-2: 4px;    --sp-3: 6px;
    --sp-4: 8px;    --sp-5: 10px;   --sp-6: 12px;   --sp-7: 14px;
    --sp-8: 16px;   --sp-10: 20px;  --sp-12: 24px;  --sp-14: 28px;
    --sp-16: 32px;  --sp-20: 40px;  --sp-24: 48px;

    /* ---- Radius Scale ---- */
    --r-xs: 4px;   --r-sm: 8px;    --r-md: 12px;
    --r-lg: 16px;  --r-xl: 20px;   --r-2xl: 24px;

    /* ---- Typography ---- */
    --ff: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Inter", "Noto Sans SC", sans-serif;
    --ff-serif: Georgia, Cambria, "Times New Roman", "Noto Serif SC", serif;
    --fm: "SF Mono", "JetBrains Mono", "Source Code Pro", Menlo, monospace;

    --fs-caption: 10px; --fs-small: 11px; --fs-body: 13px; --fs-body-lg: 14px;
    --fs-heading: 15px; --fs-display: 20px; --fs-hero: 28px;

    --fw-regular: 400; --fw-medium: 500; --fw-semibold: 600; --fw-bold: 700;
    --lh-tight: 1.3; --lh-normal: 1.5; --lh-loose: 1.55; --lh-code: 1.4;

    /* ---- Shadow Map (opacity ∝ depth) ---- */
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.04);
    --shadow-md: 0 4px 16px rgba(0,0,0,0.06);
    --shadow-lg: 0 12px 40px rgba(0,0,0,0.07);
    --shadow-xl: 0 24px 60px rgba(0,0,0,0.08);

    /* ---- Motion ---- */
    --ease-out-expo: cubic-bezier(0.22,1,0.36,1);
    --ease-in-out: cubic-bezier(0.4,0,0.2,1);
    --ease-out: cubic-bezier(0,0,0.2,1);
    --dur-f: 0.15s; --dur-n: 0.25s; --dur-s: 0.4s; --dur-l: 0.6s;
    --tr: var(--dur-n) var(--ease-out-expo);

    /* ════════════════════════════════════════════════
       Layer 2: Semantic Tokens (purpose-bound)
       ════════════════════════════════════════════════ */

    /* ---- Glass Depth System (L0 = deepest, L4 = closest) ---- */
    --glass-L0-bg: rgba(255,255,255,0.30);
    --glass-L0-blur: blur(8px) saturate(160%);

    --glass-L1-bg: rgba(255,255,255,0.40);
    --glass-L1-blur: blur(16px) saturate(180%);

    --glass-L2-bg: rgba(255,255,255,0.50);
    --glass-L2-blur: blur(20px) saturate(200%);

    --glass-L3-bg: rgba(255,255,255,0.62);
    --glass-L3-blur: blur(24px) saturate(200%);

    --glass-L4-bg: rgba(255,255,255,0.75);
    --glass-L4-blur: blur(32px) saturate(220%);

    /* ---- Surface Tokens ---- */
    --bg-base: var(--gray-50);
    --bg-surface: var(--glass-L2-bg);
    --bg-elevated: var(--glass-L2-bg);
    --bg-raised: var(--glass-L3-bg);
    --bg-glass: var(--glass-L2-bg);

    /* ---- Border Tokens ---- */
    --bd: rgba(0,0,0,0.06);       /* subtle */
    --bd2: rgba(0,0,0,0.10);      /* medium */
    --bd-glass: rgba(255,255,255,0.25);  /* specular highlight — glass edge */

    /* ---- Interaction Tokens ---- */
    --ghost: rgba(0,0,0,0.03);
    --ghost-hover: rgba(0,0,0,0.06);
    --accent-bg: rgba(232,84,84,0.08);
    --accent-glow: rgba(232,84,84,0.06);

    /* ---- Text Tokens ---- */
    --tx: var(--gray-900);        /* primary */
    --tx2: var(--gray-600);       /* secondary */
    --tx3: var(--gray-400);       /* tertiary */
    --tx-meta: var(--gray-300);   /* metadata */
    --tx-inverse: var(--white);   /* on primary */

    /* ---- Layout ---- */
    --sw: 250px;
    --rw: 280px;

    /* ════════════════════════════════════════════════
       Layer 3: Component Tokens (pre-composed)
       ════════════════════════════════════════════════ */

    --blur-generic: var(--glass-L2-blur);

    /* ════════════════════════════════════════════════
       Layer 4: Z-index Map
       ════════════════════════════════════════════════ */
    --z-bg: -1;
    --z-sidebar-float: 100;
    --z-traffic: 150;
    --z-overlay: 200;
    --z-popover: 300;
    --z-toast: 400;
    --z-tooltip: 500;
  }

  [data-theme="dark"] {
    /* ---- Brand Palette (brighter for dark) ---- */
    --red: #FF6B6B;
    --green: #66BB6A;
    --yellow: #FFD54F;
    --pri: #FF6B6B;
    --pri2: #E85555;
    --pri3: #FF8888;
    --orange: #FFB74D;

    /* ---- Neutral Scale (inverted) ---- */
    --gray-900: #EDEDED;
    --gray-800: #C0C0C8;
    --gray-700: #A0A0A8;
    --gray-600: #808088;
    --gray-500: #606068;
    --gray-400: #505058;
    --gray-300: #404048;
    --gray-200: #303038;
    --gray-100: #202028;
    --gray-50: #181820;
    --white: #101018;
    --black: #08080E;

    /* ---- Glass Depth — darker base + less transparency ---- */
    --glass-L0-bg: rgba(16,16,24,0.50);
    --glass-L1-bg: rgba(20,20,28,0.55);
    --glass-L2-bg: rgba(26,26,34,0.62);
    --glass-L3-bg: rgba(32,32,42,0.70);
    --glass-L4-bg: rgba(40,40,52,0.80);

    /* ---- Border (lighter for dark) ---- */
    --bd: rgba(255,255,255,0.06);
    --bd2: rgba(255,255,255,0.10);
    --bd-glass: rgba(255,255,255,0.12);

    /* ---- Interaction ---- */
    --ghost: rgba(255,255,255,0.03);
    --ghost-hover: rgba(255,255,255,0.06);
    --accent-bg: rgba(255,107,107,0.10);
    --accent-glow: rgba(255,107,107,0.08);

    /* ---- Shadow (deeper for dark) ---- */
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.3);
    --shadow-md: 0 4px 16px rgba(0,0,0,0.35);
    --shadow-lg: 0 12px 40px rgba(0,0,0,0.4);
    --shadow-xl: 0 24px 60px rgba(0,0,0,0.5);
  }

  [data-theme="light"] {
    /* --bg-base overrides: warm cream canvas for light mode */
    --bg-base: #F5F2EC;
  }

  * { margin:0; padding:0; box-sizing:border-box; }
  html,body { height:100%; overflow:hidden; }
  body {
    font-family: var(--ff); font-size: var(--fs-body); font-weight: var(--fw-regular);
    line-height: var(--lh-loose); color: var(--tx);
    background: var(--bg-base);
    -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    display:flex; align-items:center; justify-content:center; padding:16px;
    position:relative; overflow:hidden;
  }
  body::before {
    content:''; position:fixed; inset:0; z-index:var(--z-bg);
    background:
      radial-gradient(ellipse 60% 50% at 20% 80%, rgba(232,84,84,0.08) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 85% 20%, rgba(232,84,84,0.05) 0%, transparent 55%),
      radial-gradient(ellipse 40% 40% at 50% 50%, rgba(120,80,200,0.03) 0%, transparent 50%);
    animation: nebulaDrift 20s ease-in-out infinite alternate;
    transition: background 0.3s;
  }
  @keyframes nebulaDrift {
    0%{ transform:scale(1) rotate(0deg); }
    100%{ transform:scale(1.15) rotate(-3deg); }
  }
  /* Star field */
  body::after {
    content:''; position:fixed; inset:0; z-index:var(--z-bg);
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1px 1px at 30% 60%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 50% 10%, rgba(255,255,255,0.7) 0%, transparent 100%),
      radial-gradient(1px 1px at 70% 40%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 90% 80%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 15% 85%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1px 1px at 45% 30%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 65% 70%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 25% 15%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 80% 55%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1px 1px at 40% 90%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 95% 25%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 5% 50%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 60% 15%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1px 1px at 75% 90%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 35% 45%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 88% 10%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 55% 80%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1px 1px at 20% 40%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 72% 60%, rgba(255,255,255,0.5) 0%, transparent 100%);
    animation: starTwinkle 4s ease-in-out infinite alternate;
    transition: opacity 0.3s;
  }
  @keyframes starTwinkle {
    0%{ opacity:0.6; }
    100%{ opacity:1; }
  }
  [data-theme="dark"] body::before {
    background:
      radial-gradient(ellipse 60% 50% at 20% 80%, rgba(255,107,107,0.15) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 85% 20%, rgba(255,107,107,0.10) 0%, transparent 55%),
      radial-gradient(ellipse 40% 40% at 50% 50%, rgba(140,90,220,0.08) 0%, transparent 50%);
  }
  [data-theme="light"] body::before {
    background:
      radial-gradient(ellipse 60% 50% at 20% 80%, rgba(196,148,74,0.06) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 85% 20%, rgba(196,148,74,0.04) 0%, transparent 55%);
  }
  [data-theme="light"] body::after {
    opacity: 0.3;
  }
  ::selection { background:var(--pri); color:#fff; }

  .app {
    width:1280px; max-width:calc(100vw - 32px);
    height:760px; max-height:calc(100vh - 32px);
    display:flex; flex-direction:column;
    border-radius:var(--r-xl);
    background: var(--glass-L4-bg);
    backdrop-filter: var(--glass-L4-blur);
    -webkit-backdrop-filter: var(--glass-L4-blur);
    border:1px solid var(--bd-glass);
    box-shadow:
      0 0 0 0.5px rgba(0,0,0,0.02),
      0 8px 32px rgba(0,0,0,0.3),
      inset 0 1px 0 rgba(255,255,255,0.15);
    overflow:hidden; position:relative;
    animation: appDrift 30s ease-in-out infinite alternate;
  }
  @keyframes appDrift {
    0%{ transform:rotate(0deg); }
    100%{ transform:rotate(-0.6deg); }
  }
  .ab { flex:1; display:flex; min-height:0; position:relative; }

  /* ===== SIDEBAR — Liquid Glass ===== */
  .sb {
    width:var(--sw); flex-shrink:0; display:flex; flex-direction:column;
    background: var(--glass-L2-bg);
    backdrop-filter: var(--glass-L2-blur);
    -webkit-backdrop-filter: var(--glass-L2-blur);
    border-right:1px solid var(--bd);
    position:relative;
    box-shadow: inset -1px 0 0 var(--bd-glass);
  }
  .sb-top { padding:14px 14px 0; display:flex; flex-direction:column; gap:14px; }
  .sb-header {
    display:flex; align-items:center; justify-content:flex-end; height:28px;
  }
  .sb-header-actions { display:flex; align-items:center; gap:6px; }

  /* Traffic lights — always visible, no blur */
  .traffic { position:fixed; left:12px; top:14px; display:flex; gap:6px; z-index:var(--z-traffic); }
  .t-dot { width:10px; height:10px; border-radius:50%; }
  .t-c { background:#ff5f57; } .t-m { background:#febc2e; } .t-x { background:#28c840; }

  /* Traffic light close — uniform with window dots */
  .tlg-close { display:flex; align-items:center; gap:6px; flex-shrink:0; }
  .tlg-dot { width:10px; height:10px; border-radius:50%; cursor:pointer; transition:var(--tr); }
  .tlg-dot:hover { filter:brightness(1.3); }
  .tlg-r { background:#ff5f57; }
  .tlg-y { background:#febc2e; }
  .tlg-g { background:#28c840; }
  .sbn {
    width:24px; height:24px; display:flex; align-items:center; justify-content:center;
    border-radius:var(--r-sm); border:none; cursor:pointer;
    background:transparent; color:var(--tx3); transition:var(--tr);
  }
  .sbn:hover { background:var(--ghost); color:var(--tx); }
  .sbn svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }

  /* Sidebar Collapse — floating toggle button */
  .sb.collapsed { width:0; min-width:0; overflow:hidden; border-right:none; }
  .sb.collapsed .sb-top,
  .sb.collapsed .sf { display:none; }
  .sb.collapsed + .traffic + .sb-float { opacity:1; pointer-events:auto; }
  .sb.collapsed + .traffic + .sb-float + .ma { border-radius:12px 0 0 12px; }
  .sb-float {
    position:absolute; left:58px; top:14px; z-index:var(--z-sidebar-float);
    width:28px; height:28px; border-radius:8px; border:1px solid var(--bd2);
    display:flex; align-items:center; justify-content:center;
    background:var(--glass-L3-bg); backdrop-filter:var(--glass-L2-blur); -webkit-backdrop-filter:var(--glass-L2-blur);
    color:var(--tx2); cursor:pointer; opacity:0; pointer-events:none;
    transition:opacity 0.2s;
  }
  .sb-float:hover { background:var(--ghost); color:var(--tx); }
  .sb-float svg { width:14px; height:14px; }

  /* Segmented Tabs — Icon-only consciousness modes */
  .seg {
    display:flex; padding:3px; border-radius:10px;
    background: var(--glass-L3-bg);
    backdrop-filter: var(--glass-L0-blur);
    -webkit-backdrop-filter: var(--glass-L0-blur);
  }
  .segb {
    flex:1; text-align:center; padding:6px 0; font-size:var(--fs-caption);
    font-weight:var(--fw-medium); color:var(--tx3); border-radius:7px;
    cursor:pointer; transition:var(--tr); border:none; background:transparent; font-family:var(--ff);
    display:flex; align-items:center; justify-content:center; gap:4px;
  }
  .segb:hover { color:var(--tx2); }
  .segb.on {
    background: var(--glass-L3-bg);
    backdrop-filter: var(--glass-L0-blur);
    -webkit-backdrop-filter: var(--glass-L0-blur);
    color:var(--pri); box-shadow:0 0 16px rgba(232,84,84,0.15);
    font-weight:var(--fw-semibold);
    animation: pulseGlow 3s ease-in-out infinite;
  }
  @keyframes pulseGlow {
    0%,100%{ box-shadow:0 0 12px rgba(232,84,84,0.12); }
    50%{ box-shadow:0 0 24px rgba(232,84,84,0.25); }
  }
  [data-theme="dark"] .segb.on {
    background: rgba(232,84,84,0.12);
    box-shadow:0 0 20px rgba(232,84,84,0.08);
  }
  .segb svg { width:16px; height:16px; stroke:currentColor; stroke-linecap:round; stroke-linejoin:round; transition:transform 0.4s cubic-bezier(0.22,1,0.36,1); }
  .segb:hover svg { transform:rotate(-72deg) scale(1.1); }
  .segb.on svg { }

  /* Nav List */
  .nav-list { display:flex; flex-direction:column; gap:1px; }
  .nl {
    display:flex; align-items:center; gap:10px; padding:7px 10px;
    border-radius:var(--r-sm); cursor:pointer; transition:var(--tr);
    font-size:var(--fs-body); font-weight:var(--fw-medium); color:var(--tx2);
    position:relative;
  }
  .nl:hover { background:var(--ghost); color:var(--tx); }
  .nl.on { background:var(--accent-bg); color:var(--pri); font-weight:var(--fw-semibold); }
  .nl.on::before {
    content:''; position:absolute; left:-10px; top:50%; transform:translateY(-50%);
    width:3px; height:18px; border-radius:3px; background:var(--pri);
  }
  .nl svg { width:15px; height:15px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; transition:transform 0.3s ease, stroke-width 0.2s; }
  .nl:hover svg { transform:rotate(-72deg) scale(1.15); }
  .nl.on svg { stroke-width:2.2; }

  /* Recents */
  .re { padding:0 10px; }
  .re-h { font-size:10px; font-weight:var(--fw-semibold); text-transform:uppercase; letter-spacing:0.8px; color:var(--tx-meta); margin-bottom:4px; padding:0 2px; }
  .re-i {
    display:flex; align-items:center; gap:8px; padding:6px 6px;
    border-radius:var(--r-sm); cursor:pointer; transition:var(--tr);
    font-size:var(--fs-small); color:var(--tx2);
  }
  .re-i:hover { background:var(--ghost); color:var(--tx); }
  .re-i.ghost { opacity:0.45; cursor:default; pointer-events:none; }
  .re-i.ghost .t { font-style:italic; }
  .re-i .dot { width:4px; height:4px; border-radius:50%; background:var(--pri); flex-shrink:0; }
  .re-i .circle { width:6px; height:6px; border-radius:50%; border:1.5px solid var(--tx-meta); flex-shrink:0; }
  .re-i .t { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .re-time { font-size:9px; color:var(--tx3); flex-shrink:0; }

  /* User Bar — Liquid Glass */
  .sf {
    position:relative; padding:8px 10px; display:flex; align-items:center; gap:8px;
    border-top:1px solid var(--bd);
    background: var(--glass-L2-bg);
    backdrop-filter: var(--glass-L2-blur);
    -webkit-backdrop-filter: var(--glass-L2-blur);
    margin-top:auto;
    box-shadow: inset 0 1px 0 var(--bd-glass);
  }
  .sa {
    width:24px; height:24px; border-radius:6px;
    background:linear-gradient(135deg,var(--pri),var(--pri2));
    display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:var(--fw-bold);
    color:#fff; flex-shrink:0;
  }
  .su-info { flex:1; min-width:0; }
  .su-name { font-size:var(--fs-body); font-weight:var(--fw-medium); color:var(--tx); }
  .su-plan { font-size:9px; color:var(--tx-meta); }
  .sf-actions { display:flex; align-items:center; gap:2px; }
  .sf-btn {
    width:26px; height:26px; display:flex; align-items:center; justify-content:center;
    border-radius:var(--r-sm); border:none; cursor:pointer;
    background:transparent; color:var(--tx3); transition:var(--tr);
  }
  .sf-btn:hover { background:var(--ghost); color:var(--tx); }
  .sf-btn svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }

  /* ===== MAIN — Liquid Glass ===== */
  .ma { flex:1; display:flex; flex-direction:column; min-width:0;
    background: var(--glass-L1-bg); backdrop-filter: var(--glass-L1-blur);
    -webkit-backdrop-filter: var(--glass-L1-blur); position:relative; }

  /* ===== RIGHT SIDEBAR — File Tree + Agent Trace + Preview ===== */
  .rb {
    width:var(--rw); flex-shrink:0; display:flex; flex-direction:column;
    background: var(--glass-L2-bg);
    backdrop-filter: var(--glass-L2-blur);
    -webkit-backdrop-filter: var(--glass-L2-blur);
    border-left:1px solid var(--bd);
    box-shadow: inset 1px 0 0 var(--bd-glass);
    transition:width 0.35s var(--ease-out-expo), min-width 0.35s var(--ease-out-expo), opacity 0.2s;
    position:relative;
  }

  /* ── Auto-hide: collapsed by default, expands on hover ── */
  .rb.auto-hide {
    width:0; min-width:0; overflow:hidden; border-left:none; opacity:0;
  }
  .rb.auto-hide .rb-float { opacity:1; pointer-events:auto; }
  .rb.auto-hide:hover,
  .rb.auto-hide.rb-hover {
    width:var(--rw); min-width:var(--rw); overflow:visible; border-left:1px solid var(--bd); opacity:1;
  }
  .rb.auto-hide:hover .rb-float,
  .rb.auto-hide.rb-hover .rb-float { opacity:0; pointer-events:none; }
  .rb.auto-hide:hover .rb-content,
  .rb.auto-hide.rb-hover .rb-content { opacity:1; }

  /* ── When collapsed (forced via .collapsed) ── */
  .rb.collapsed { width:0; min-width:0; overflow:hidden; border-left:none; opacity:0; }
  .rb.collapsed .rb-float { opacity:1; pointer-events:auto; right:0; }

  .rb-float {
    position:absolute; right:0; top:50%; z-index:var(--z-sidebar-float); transform:translateY(-50%);
    width:20px; height:48px; border-radius:6px 0 0 6px; border:1px solid var(--bd2);
    display:flex; align-items:center; justify-content:center;
    background:var(--glass-L3-bg); backdrop-filter:var(--glass-L2-blur);
    color:var(--tx3); cursor:pointer; transition:var(--tr); opacity:0; pointer-events:none;
  }
  .rb-float:hover { background:var(--ghost); color:var(--tx); }
  .rb-float svg { width:8px; height:8px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }

  .rb-content {
    flex:1; overflow-y:auto; padding:6px 8px; min-height:0;
    display:flex; flex-direction:column; gap:4px;
  }

  /* File Tree */
  .ft-item {
    display:flex; align-items:center; gap:5px; padding:2px 4px;
    border-radius:4px; cursor:pointer; font-size:var(--fs-small);
    color:var(--tx2); transition:var(--tr); white-space:nowrap;
  }
  .ft-item:hover { background:var(--ghost); color:var(--tx); }
  .ft-item .fic { width:13px; height:13px; flex-shrink:0; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
  .ft-item .chev { width:9px; height:9px; flex-shrink:0; transition:transform 0.2s; }
  .ft-item .chev.open { transform:rotate(-90deg); }
  .ft-children { display:none; padding-left:14px; }
  .ft-children.open { display:block; }
  .ft-file { color:var(--tx3); }
  .ft-file:hover { color:var(--tx); background:var(--ghost); }
  .ft-active { background:var(--accent-bg); color:var(--pri) !important; }

  /* ════════════════════════════════════════════════
     Artifact Pane (unified preview pane)
     — Claude-style: view toggle | title | actions
     — Unified format tabs: Raw / Rendered / WeChat /
       Zhihu / Juejin / Web
     ════════════════════════════════════════════════ */
  .ap {
    border:1px solid var(--bd); border-radius:8px;
    background:var(--glass-L1-bg);
    overflow:hidden; flex-shrink:0;
    transition:min-height 0.3s, max-height 0.3s;
    display:flex; flex-direction:column; min-height:0;
  }
  .ap.mini { min-height:36px; max-height:36px; cursor:pointer; flex-shrink:0; }
  .ap.mini .ap-tabs,
  .ap.mini .ap-body { display:none; }

  /* ── Artifact Header Bar ── */
  .ap-bar {
    display:flex; align-items:center; padding:3px 8px 3px 4px;
    gap:6px; flex-shrink:0; border-bottom:1px solid var(--bd);
    min-height:32px;
  }
  .ap-bar-left { display:flex; align-items:center; gap:1px; flex-shrink:0; }
  .ap-title {
    flex:1; font-size:var(--fs-caption); font-weight:var(--fw-medium);
    color:var(--tx3); white-space:nowrap; overflow:hidden;
    text-overflow:ellipsis; text-align:center; min-width:0;
  }

  /* View toggle buttons (eye / </>) */
  .ap-view-btn {
    width:24px; height:22px; display:flex; align-items:center; justify-content:center;
    border:none; border-radius:4px; cursor:pointer; transition:var(--tr);
    background:transparent; color:var(--tx3);
  }
  .ap-view-btn:hover { background:var(--ghost); color:var(--tx2); }
  .ap-view-btn.on { background:var(--ghost); color:var(--tx); }
  .ap-view-btn svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }

  /* Action buttons */
  .ap-action {
    width:22px; height:22px; display:flex; align-items:center; justify-content:center;
    border:none; border-radius:4px; cursor:pointer; transition:var(--tr);
    background:transparent; color:var(--tx3);
  }
  .ap-action:hover { background:var(--ghost); color:var(--tx2); }
  .ap-action svg { width:12px; height:12px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }

  /* ── Unified Format Tabs ── */
  .ap-tabs {
    display:flex; padding:0 6px; gap:1px; overflow-x:auto;
    flex-shrink:0; border-bottom:1px solid var(--bd);
    background:var(--glass-L1-bg);
  }
  .ap-tabs::-webkit-scrollbar { height:0; }
  .ap-tab {
    padding:3px 8px; font-size:9px; font-weight:var(--fw-medium);
    border-radius:0; border:none; cursor:pointer; transition:var(--tr);
    background:transparent; color:var(--tx3);
    font-family:var(--ff); white-space:nowrap;
    border-bottom:1.5px solid transparent;
    margin-bottom:-1px;
  }
  .ap-tab:hover { color:var(--tx2); }
  .ap-tab.on {
    color:var(--pri); font-weight:var(--fw-semibold);
    border-bottom-color:var(--pri);
  }

  /* ── Artifact Body ── */
  .ap-body { display:none; flex-direction:column; flex:1; min-height:0; }
  .ap-body.open { display:flex; }

  /* ── Artifact Footer (action buttons below content) ── */
  .ap-footer { display:none; align-items:center; gap:6px; padding:6px 10px; border-top:1px solid var(--bd); flex-shrink:0; }
  .ap-body.open ~ .ap-footer { display:flex; }
  .ap-footer .ap-action { display:inline-flex; align-items:center; gap:4px; padding:3px 6px; border-radius:4px; color:var(--tx3); font-size:11px; background:transparent; border:none; cursor:pointer; transition:var(--tr); }
  .ap-footer .ap-action:hover { background:var(--ghost); color:var(--tx); }
  .ap-footer .ap-action svg { width:11px; height:11px; fill:none; stroke:currentColor; stroke-width:1.3; stroke-linecap:round; stroke-linejoin:round; }
  .ap-footer .ap-action span { font-size:11px; white-space:nowrap; }

  .ap-content {
    flex:1; overflow-y:auto; padding:12px 16px; min-height:60px; max-height:280px;
    font-family:var(--ff); font-size:12px; line-height:1.7; color:var(--tx2);
  }

  /* ── Smart MD Typography (within .ap-content) ── */
  .ap-content h1 { font-size:16px; font-weight:var(--fw-bold); margin:12px 0 6px; color:var(--tx); line-height:1.3; }
  .ap-content h2 { font-size:14px; font-weight:var(--fw-semibold); margin:10px 0 5px; color:var(--tx); }
  .ap-content h3 { font-size:13px; font-weight:var(--fw-semibold); margin:8px 0 4px; color:var(--tx); }
  .ap-content p { margin:6px 0; }
  .ap-content code {
    background:var(--ghost); padding:1px 5px; border-radius:3px;
    font-family:var(--fm); font-size:10px; color:var(--des);
  }
  .ap-content pre {
    background:var(--ghost); border-radius:6px; padding:8px 10px; margin:6px 0;
    overflow-x:auto;
  }
  .ap-content pre code { background:none; padding:0; color:var(--tx2); }
  .ap-content blockquote {
    border-left:2px solid var(--pri); padding:4px 10px; margin:6px 0;
    background:var(--accent-bg); border-radius:0 4px 4px 0; color:var(--tx2);
  }
  .ap-content table { width:100%; border-collapse:collapse; margin:6px 0; font-size:11px; }
  .ap-content th, .ap-content td { padding:4px 8px; border:1px solid var(--bd); text-align:left; }
  .ap-content th { background:var(--ghost); font-weight:var(--fw-semibold); color:var(--tx); }
  .ap-content ul, .ap-content ol { padding-left:18px; margin:4px 0; }
  .ap-content li { margin:2px 0; }
  .ap-content a { color:var(--pri); text-decoration:none; }
  .ap-content a:hover { text-decoration:underline; }
  .ap-content img { max-width:100%; border-radius:6px; margin:6px 0; }
  .ap-content hr { border:none; border-top:1px solid var(--bd); margin:10px 0; }
  .ap-content strong { color:var(--tx); font-weight:var(--fw-semibold); }

  /* Callout block */
  .ap-content .callout {
    border-left:3px solid var(--bd2); padding:6px 12px; margin:8px 0;
    background:var(--ghost); border-radius:0 6px 6px 0;
    color:var(--tx2); font-size:11px; line-height:1.6;
  }

  /* Platform-specific style classes applied to .ap-content */
  .ap-content.raw { font-family:var(--fm); font-size:10px; line-height:1.6; color:var(--tx2); }
  .ap-content.raw code { background:none; padding:0; }

  .ap-content.md-wechat h1 { text-align:center; font-size:17px; }
  .ap-content.md-wechat pre { background:#F7F7F7; border-radius:4px; }
  .ap-content.md-wechat code { color:#D63384; }

  .ap-content.md-zhihu { font-family:var(--ff-serif); }
  .ap-content.md-zhihu h1, .ap-content.md-zhihu h2 { font-family:var(--ff-serif); }
  .ap-content.md-zhihu blockquote { border-left-color:#1E90FF; }

  .ap-content.md-juejin h1 { color:#1E80FF; }
  .ap-content.md-juejin h2 { border-left:3px solid #1E80FF; padding-left:8px; }
  .ap-content.md-juejin pre { background:#2D2D3A; color:#E8E8F0; }
  .ap-content.md-juejin code { background:#2D2D3A; color:#F8C555; }

  .ap-content.md-web h1 { font-size:18px; letter-spacing:-0.02em; }

  .kw { color:var(--des); } .fn { color:var(--suc); } .hl { color:var(--pri); } .cm { color:var(--tx3); font-style:italic; }

  /* ===== VIEW: 对话 (Chat) ===== */
  .vw-chat { flex:1; display:flex; flex-direction:column; align-items:center; }
  .vw-chat .wc-inner { max-width:640px; width:100%; display:flex; flex-direction:column; align-items:center; gap:24px; padding:40px 24px; flex:1; justify-content:center; }
  .hero { display:flex; align-items:center; gap:14px; }
  .hero-svg { width:36px; height:36px; flex-shrink:0; }
  .hero-svg svg { width:36px; height:36px; animation: heroPulse 4s ease-in-out infinite; }
  @keyframes heroPulse {
    0%,100%{ filter:drop-shadow(0 0 6px rgba(232,84,84,0.2)) drop-shadow(0 0 12px rgba(232,84,84,0.1)); transform:scale(1) rotate(0deg); }
    50%{ filter:drop-shadow(0 0 12px rgba(232,84,84,0.35)) drop-shadow(0 0 24px rgba(232,84,84,0.15)); transform:scale(1.04) rotate(-8deg); }
  }
  .hero h1 { font-family:var(--ff-serif); font-size:var(--fs-hero); font-weight:var(--fw-medium); letter-spacing:-0.02em; color:var(--tx); line-height:var(--lh-tight); }

  .cic { width:100%; border-radius:var(--r-2xl); padding:16px;
    background: var(--glass-L2-bg); backdrop-filter: var(--glass-L2-blur);
    -webkit-backdrop-filter: var(--glass-L2-blur);
    border:1px solid var(--bd2); box-shadow:var(--shadow-sm); transition:var(--tr); display:flex; flex-direction:column; gap:12px; }
  .cic:focus-within { border-color:var(--bd2); box-shadow:var(--shadow-md); }
  .cic textarea { width:100%; background:transparent; border:none; outline:none; resize:none; font-family:var(--ff); font-size:var(--fs-body-lg); line-height:var(--lh-normal); color:var(--tx); min-height:64px; padding:2px 2px; }
  .cic textarea::placeholder { color:var(--tx3); }
  .cic-bar { display:flex; align-items:center; gap:8px; padding-bottom:6px; border-bottom:1px solid var(--bd); margin-bottom:2px; }
  .cic-bar .cic-lbl { font-size:var(--fs-caption); color:var(--tx3); white-space:nowrap; display:flex; align-items:center; gap:4px; }
  .cic-bar .cic-lbl svg { width:12px; height:12px; }
  .cic-bar select { flex:1; background:transparent; border:none; font-family:var(--fm); font-size:var(--fs-caption); color:var(--tx2); cursor:pointer; outline:none; padding:2px 0; min-width:0; }
  .cic-bar select option { background:var(--bg-raised); color:var(--tx); }
  .cic-actions { display:flex; align-items:center; justify-content:space-between; }
  .cic-left { display:flex; align-items:center; }
  .cic-attach { width:32px; height:32px; display:flex; align-items:center; justify-content:center; border-radius:50%; cursor:pointer; transition:var(--tr); color:var(--tx3); border:none; background:transparent; }
  .cic-attach:hover { background:var(--ghost); color:var(--tx); }
  .cic-attach svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
  .cic-right { display:flex; align-items:center; gap:6px; }
  .vc-btn {
    width:34px; height:34px; display:flex; align-items:center; justify-content:center;
    border-radius:50%; cursor:pointer; transition:var(--tr);
    border:none; background:transparent; color:var(--tx3); position:relative;
  }
  .vc-btn:hover { background:var(--ghost); color:var(--tx2); }
  .vc-btn svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .vc-lang svg { stroke-width:1.6; }
  .vc-send {
    background:var(--bg-raised); border:1px solid var(--bd);
    width:36px; height:36px;
  }
  .vc-send:hover { background:var(--pri); border-color:var(--pri); color:#fff; }
  .vc-send:disabled { opacity:0.3; cursor:default; }
  .vc-send svg { width:18px; height:14px; stroke-width:2; transition:opacity 0.3s, transform 0.3s; }
  .vc-send .s-mic { position:absolute; }
  .vc-send .s-wav { opacity:0; transform:scale(0.6); }
  .vc-send:hover .s-mic { opacity:0; transform:scale(0.6) rotate(-15deg); }
  .vc-send:hover .s-wav { opacity:1; transform:scale(1); }
  .qa { display:flex; flex-wrap:wrap; gap:6px; justify-content:center; }
  .qa-btn { display:flex; align-items:center; gap:5px; padding:6px 14px; border-radius:20px; font-size:var(--fs-small); font-weight:var(--fw-medium); background:transparent; border:1px solid var(--bd); cursor:pointer; color:var(--tx3); transition:var(--tr); font-family:var(--ff); }
  .qa-btn:hover { background:var(--ghost); border-color:var(--tx3); color:var(--tx); }
  .qa-btn svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }

  /* Chat messages */
  .cs { flex:1; overflow-y:auto; padding:16px 24px; display:none; flex-direction:column; gap:14px; width:100%; }
  .msg { display:flex; gap:10px; max-width:78%; animation:fi 0.25s ease-out; }
  .msg.r { align-self:flex-end; flex-direction:row-reverse; }
  .msg.l { align-self:flex-start; }
  .msg.c { align-self:center; }
  .ma2 { width:28px; height:28px; border-radius:8px; flex-shrink:0; display:flex; align-items:center; justify-content:center; margin-top:4px; }
  .msg.r .ma2 { background:linear-gradient(135deg,var(--pri),var(--pri2)); }
  .msg.r .ma2 svg { color:#fff; }
  .msg.l .ma2 { background:var(--ghost); }
  .msg.l .ma2 svg { color:var(--pri); }
  .mb { padding:10px 16px; border-radius:var(--r-lg); font-size:var(--fs-body); font-weight:var(--fw-regular); line-height:var(--lh-loose); position:relative; }
  .msg.r .mb { background:linear-gradient(135deg,var(--pri),var(--pri2)); color:#fff; }
  .msg.l .mb { background:var(--glass-L1-bg); backdrop-filter:var(--glass-L1-blur); -webkit-backdrop-filter:var(--glass-L1-blur); border:1px solid var(--bd); }
  .mb code { background:rgba(0,0,0,0.15); padding:1px 6px; border-radius:4px; font-family:var(--fm); font-size:var(--fs-small); }
  .msg.l .mb code { background:var(--bg-raised); color:var(--tx); }
  .mb-t { font-size:var(--fs-caption); opacity:0.35; margin-top:4px; }
  .sc { display:inline-block; width:2px; height:13px; background:var(--pri); animation:bl 0.8s step-end infinite; vertical-align:middle; margin-left:2px; }

  /* ===== VIEW: Chat — Top Bar ===== */
  .ch-top { display:flex; align-items:center; justify-content:flex-end; padding:10px 20px; gap:8px; flex-shrink:0; }
  .ch-upgrade { padding:3px 12px; border-radius:20px; font-size:var(--fs-caption); color:var(--tx3); border:1px solid var(--bd); cursor:pointer; background:var(--glass-L2-bg); backdrop-filter:var(--glass-L2-blur); -webkit-backdrop-filter:var(--glass-L2-blur); transition:var(--tr); font-family:var(--ff); }
  .ch-upgrade:hover { background:var(--ghost-hover); color:var(--tx); border-color:var(--bd2); }
  .ch-icon-btn { width:24px; height:24px; display:flex; align-items:center; justify-content:center; color:var(--tx3); border:none; background:none; cursor:pointer; border-radius:4px; transition:var(--tr); }
  .ch-icon-btn:hover { color:var(--tx); }
  .ch-icon-btn svg { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }

  /* ===== Conversation List Panel — slide-in overlay in chat view ===== */
  .conv-panel { position:absolute; inset:0; background:var(--bg-base); z-index:20; display:none; flex-direction:column; animation:fi 0.15s ease-out; }
  .conv-panel.open { display:flex; }
  .conv-panel-head { display:flex; align-items:center; justify-content:space-between; padding:14px 20px; border-bottom:1px solid var(--bd); flex-shrink:0; }
  .conv-panel-head h2 { font-size:var(--fs-heading); font-weight:var(--fw-semibold); color:var(--tx); margin:0; display:flex; align-items:center; gap:8px; }
  .conv-panel-head .conv-count { font-size:var(--fs-caption); font-weight:var(--fw-regular); color:var(--tx3); }
  .conv-panel-head button { width:24px; height:24px; border:none; background:transparent; color:var(--tx3); cursor:pointer; border-radius:6px; display:flex; align-items:center; justify-content:center; font-size:16px; transition:var(--tr); }
  .conv-panel-head button:hover { background:var(--ghost); color:var(--tx); }
  .conv-panel-body { flex:1; overflow-y:auto; padding:4px 16px; }
  .conv-card { display:flex; align-items:center; gap:10px; padding:10px 12px; border-radius:var(--r-md); cursor:pointer; transition:var(--tr); border-bottom:1px solid var(--bd); }
  .conv-card:last-child { border-bottom:none; }
  .conv-card:hover { background:var(--ghost); }
  .conv-card.active { background:var(--accent-bg); }
  .conv-avatar { width:32px; height:32px; border-radius:8px; flex-shrink:0; display:flex; align-items:center; justify-content:center; background:var(--ghost); color:var(--tx2); font-size:13px; font-weight:var(--fw-semibold); }
  .conv-card.active .conv-avatar { background:var(--pri); color:#fff; }
  .conv-info { flex:1; min-width:0; }
  .conv-name { font-size:var(--fs-body); font-weight:var(--fw-medium); color:var(--tx); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .conv-meta { font-size:var(--fs-caption); color:var(--tx3); margin-top:1px; }
  .conv-card-actions { display:flex; gap:4px; opacity:0; transition:opacity 0.15s; }
  .conv-card:hover .conv-card-actions { opacity:1; }
  .conv-card-act { width:24px; height:24px; border:none; background:transparent; color:var(--tx3); cursor:pointer; border-radius:5px; display:flex; align-items:center; justify-content:center; font-size:11px; transition:var(--tr); }
  .conv-card-act:hover { background:var(--ghost); color:var(--tx); }
  .conv-card-act.del:hover { color:var(--des); background:rgba(232,84,84,0.1); }
  .conv-empty { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; padding:60px 20px; color:var(--tx3); }
  .conv-empty svg { width:40px; height:40px; opacity:0.4; }
  .conv-empty p { font-size:var(--fs-body); color:var(--tx2); margin:0; }
  .conv-empty button { padding:6px 16px; border-radius:8px; border:1px solid var(--bd); background:var(--ghost); color:var(--tx2); font-size:var(--fs-small); cursor:pointer; font-family:var(--ff); transition:var(--tr); }
  .conv-empty button:hover { background:var(--accent-bg); color:var(--pri); border-color:var(--pri); }

  /* ===== VIEW: Cowork — 协同会话管理 (左栏会话列表 + 右栏任务看板) ===== */
  .vw-cowork { flex:1; display:none; overflow:hidden; }
  .cw-layout { display:flex; height:100%; width:100%; }
  .cw-sidebar { width:210px; min-width:160px; border-right:1px solid var(--bd); display:flex; flex-direction:column; background:var(--glass-L1-bg); }
  .cw-shead { display:flex; align-items:center; justify-content:space-between; padding:10px 12px; font-size:var(--fs-small); font-weight:var(--fw-semibold); color:var(--tx); border-bottom:1px solid var(--bd); }
  .cw-add { width:22px; height:22px; border:none; background:var(--ghost); border-radius:6px; cursor:pointer; color:var(--tx2); display:flex; align-items:center; justify-content:center; transition:var(--tr); }
  .cw-add:hover { background:var(--accent-bg); color:var(--pri); }
  .cw-add svg { width:12px; height:12px; }
  .cw-slist { flex:1; overflow-y:auto; padding:6px; }
  .cw-sitem { padding:8px 10px; border-radius:var(--r-sm); cursor:pointer; font-size:var(--fs-small); color:var(--tx2); transition:var(--tr); margin-bottom:2px; }
  .cw-sitem:hover { background:var(--ghost); color:var(--tx); }
  .cw-sitem.active { background:var(--accent-bg); color:var(--tx); font-weight:var(--fw-medium); }
  .cw-sitem .s { font-size:var(--fs-caption); color:var(--tx-meta); display:block; margin-top:1px; }
  .cw-main { flex:1; display:flex; flex-direction:column; overflow-y:auto; }
  .cw-empty { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; color:var(--tx-meta); }
  .cw-empty svg { width:36px; height:36px; opacity:0.5; }
  .cw-empty p { font-size:var(--fs-body); font-weight:var(--fw-medium); color:var(--tx2); margin:0; }
  .cw-empty span { font-size:var(--fs-small); color:var(--tx-meta); }
  .cw-content { flex:1; display:flex; flex-direction:column; padding:16px; gap:12px; }
  .cw-header { display:flex; align-items:center; justify-content:space-between; }
  .cw-title { font-size:var(--fs-body); font-weight:var(--fw-semibold); color:var(--tx); }
  .cw-sub { font-size:var(--fs-caption); color:var(--tx-meta); }
  .cw-hbadge { padding:3px 10px; border-radius:99px; font-size:var(--fs-caption); font-weight:var(--fw-medium); background:var(--accent-bg); color:var(--pri); }
  .cw-section-title { font-size:var(--fs-small); font-weight:var(--fw-medium); color:var(--tx2); display:flex; align-items:center; gap:6px; }
  .cw-section-title svg { width:12px; height:12px; }
  .cw-tlist { display:flex; flex-direction:column; gap:4px; }
  .cw-task { display:flex; align-items:center; gap:8px; padding:8px 10px; border-radius:var(--r-sm); background:var(--ghost); border:1px solid var(--bd); }
  .cw-task .dot { width:6px; height:6px; border-radius:50%; flex-shrink:0; background:var(--pri); }
  .cw-task .dot.done { background:var(--suc); }
  .cw-task .dot.fail { background:var(--des); }
  .cw-task .tname { flex:1; font-size:var(--fs-small); color:var(--tx); }
  .cw-task .tstat { font-size:var(--fs-caption); color:var(--tx-meta); font-family:var(--fm); }
  .cw-agents { display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:6px; }
  .cw-agent { display:flex; align-items:center; gap:6px; padding:7px 9px; border-radius:var(--r-sm); border:1px solid var(--bd); background:var(--glass-L1-bg); font-size:var(--fs-small); color:var(--tx2); }
  .cw-agent .adot { width:5px; height:5px; border-radius:50%; flex-shrink:0; }

  /* ===== VIEW: Code — 代码编辑器 (左栏文件树 + 右栏编辑区) ===== */
  .vw-code { flex:1; display:none; overflow:hidden; }
  .cd-layout { display:flex; height:100%; width:100%; }
  .cd-tree { width:200px; min-width:140px; border-right:1px solid var(--bd); display:flex; flex-direction:column; background:var(--glass-L1-bg); }
  .cd-thead { display:flex; align-items:center; justify-content:space-between; padding:10px 12px; font-size:var(--fs-small); font-weight:var(--fw-semibold); color:var(--tx); border-bottom:1px solid var(--bd); }
  .cd-tbtn { width:22px; height:22px; border:none; background:var(--ghost); border-radius:6px; cursor:pointer; color:var(--tx2); display:flex; align-items:center; justify-content:center; transition:var(--tr); }
  .cd-tbtn:hover { background:var(--accent-bg); color:var(--pri); }
  .cd-tbtn svg { width:12px; height:12px; }
  .cd-editor { flex:1; display:flex; flex-direction:column; overflow:hidden; }
  .cd-tabs { display:flex; background:var(--glass-L1-bg); border-bottom:1px solid var(--bd); overflow-x:auto; }
  .cd-tab { padding:7px 14px; font-size:var(--fs-caption); color:var(--tx3); cursor:pointer; border-bottom:2px solid transparent; transition:var(--tr); white-space:nowrap; }
  .cd-tab:hover { color:var(--tx2); }
  .cd-tab.on { color:var(--tx); border-bottom-color:var(--pri); background:var(--ghost); }
  .cd-toolbar { display:flex; align-items:center; gap:2px; padding:6px 10px; border-bottom:1px solid var(--bd); background:var(--glass-L1-bg); }
  .cd-tb-btn { width:24px; height:24px; border:none; background:transparent; border-radius:4px; cursor:pointer; color:var(--tx2); display:flex; align-items:center; justify-content:center; transition:var(--tr); }
  .cd-tb-btn:hover { background:var(--ghost); color:var(--tx); }
  .cd-tb-btn svg { width:13px; height:13px; }
  .cd-lang { margin-left:auto; font-size:var(--fs-caption); color:var(--tx-meta); font-family:var(--fm); }
  .cd-view { flex:1; display:flex; padding:16px 0 16px 0; font-family:var(--fm); font-size:var(--fs-small); line-height:1.6; overflow:auto; color:var(--tx2); }
  .cd-ln { color:var(--tx-meta); text-align:right; padding:0 14px; user-select:none; font-size:10px; line-height:1.6; }
  .cd-view .kw { color:var(--des); }
  .cd-view .fn { color:var(--suc); }
  .cd-view .hl { color:var(--pri); }

  /* ===== VIEW: 代理 — Proxy Gateway Dashboard =====
     Card-based layout · visual hierarchy · unified glass
     ════════════════════════════════════════════════════ */
  .vw-agent { flex:1; display:none; align-items:flex-start; justify-content:center; overflow-y:auto; }
  .px { max-width:640px; width:100%; margin:20px auto; display:flex; flex-direction:column; gap:12px; padding:0 16px; }

  /* ── Hero card ── */
  .px-hero {
    display:flex; align-items:center; justify-content:space-between;
    background:var(--glass-L2-bg); border-radius:var(--r-lg);
    padding:18px 22px; border:1px solid var(--bd);
    box-shadow:var(--shadow-sm);
  }
  .px-hleft { display:flex; align-items:center; gap:14px; }
  .px-ring { position:relative; width:56px; height:56px; flex-shrink:0; }
  .px-ring svg { width:56px; height:56px; }
  .px-ring-txt {
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    font-size:13px; font-weight:var(--fw-bold); font-family:var(--fm); color:var(--tx);
  }
  .px-htitle { font-size:var(--fs-body); font-weight:var(--fw-semibold); color:var(--tx); line-height:1.3; }
  .px-hstatus { font-size:var(--fs-small); display:flex; align-items:center; gap:6px; color:var(--suc); margin-top:1px; }
  .px-hmeta { font-size:10px; color:var(--tx3); font-family:var(--fm); margin-top:2px; }
  .px-pulse { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
  .px-pulse.on { background:var(--suc); box-shadow:0 0 0 0 rgba(76,175,80,0.5); animation:pxOn 1.5s ease-in-out infinite; }
  @keyframes pxOn { 50%{ box-shadow:0 0 0 4px rgba(76,175,80,0.15); } }
  .px-hright { display:flex; align-items:center; gap:8px; }
  .px-select {
    padding:5px 10px; border-radius:var(--r-md); border:1px solid var(--bd);
    background:var(--ghost); color:var(--tx2); font-size:var(--fs-caption);
    font-family:var(--ff); cursor:pointer; outline:none; transition:var(--tr);
  }
  .px-select:hover, .px-select:focus { border-color:var(--pri); color:var(--tx); }
  .px-btn {
    padding:6px 16px; border-radius:8px; border:1px solid var(--bd);
    background:var(--ghost); color:var(--tx2); font-size:var(--fs-small);
    font-weight:var(--fw-medium); cursor:pointer; transition:var(--tr);
    font-family:var(--ff); flex-shrink:0; white-space:nowrap;
  }
  .px-btn:hover { background:var(--accent-bg); color:var(--pri); border-color:var(--pri); }

  /* ── Unified card pattern ── */
  .px-grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
  .px-card {
    display:flex; flex-direction:column; gap:4px;
    background:var(--glass-L1-bg); border-radius:var(--r-md);
    padding:12px 14px; border:1px solid var(--bd); min-width:0;
  }
  .px-cicon { width:28px; height:28px; border-radius:8px; display:flex; align-items:center; justify-content:center; background:var(--accent-bg); color:var(--pri); margin-bottom:2px; }
  .px-cicon svg { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:1.2; stroke-linecap:round; stroke-linejoin:round; }
  .px-clabel { font-size:9px; font-weight:var(--fw-medium); color:var(--tx3); text-transform:uppercase; letter-spacing:0.3px; }
  .px-cval { font-size:10px; font-weight:var(--fw-semibold); color:var(--tx); font-family:var(--fm); }

  /* ── Sections ── */
  .px-section {
    background:var(--glass-L2-bg); border-radius:var(--r-lg);
    border:1px solid var(--bd); overflow:hidden;
    box-shadow:var(--shadow-sm);
  }
  .px-shead {
    display:flex; justify-content:space-between; align-items:center;
    padding:12px 16px; border-bottom:1px solid var(--bd);
    font-size:var(--fs-small); font-weight:var(--fw-semibold); color:var(--tx);
  }
  .px-smeta { font-size:9px; font-weight:var(--fw-medium); color:var(--tx3); font-family:var(--fm); }

  /* ── Card list (IP pool / LLM pool rows) ── */
  .px-clist { padding:6px 8px; display:flex; flex-direction:column; gap:4px; }
  .px-item {
    display:flex; align-items:center; gap:8px;
    padding:7px 10px; border-radius:var(--r-md);
    background:var(--glass-L1-bg); border:1px solid var(--bd);
    font-size:9px; transition:var(--tr);
  }
  .px-item:hover { border-color:var(--tx-meta); }
  .px-iname { flex:1; font-weight:var(--fw-medium); color:var(--tx); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .px-ireg { color:var(--tx3); min-width:22px; text-align:center; font-size:12px; }
  .px-iprov { color:var(--tx3); min-width:56px; font-size:8px; }
  .px-idot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
  .px-idot.good { background:var(--suc); }
  .px-idot.warn { background:var(--yellow); }
  .px-idot.dead { background:var(--tx3); }
  .px-ibar { width:48px; height:5px; border-radius:3px; background:var(--ghost); overflow:hidden; flex-shrink:0; }
  .px-ibar-f { height:100%; border-radius:3px; transition:width 0.5s; }
  .px-ilat { font-family:var(--fm); color:var(--tx2); text-align:right; min-width:34px; }
  .px-irpm { font-family:var(--fm); color:var(--tx3); text-align:right; min-width:32px; }
  .px-iscore {
    font-size:8px; font-weight:var(--fw-bold); text-align:center;
    width:18px; height:18px; line-height:18px; border-radius:50%;
    flex-shrink:0;
  }
  .px-iscore.S { background:rgba(76,175,80,0.12); color:var(--suc); }
  .px-iscore.A { background:rgba(76,175,80,0.08); color:var(--suc); }
  .px-iscore.B { background:rgba(255,193,7,0.12); color:var(--yellow); }
  .px-iscore.C { background:rgba(255,152,0,0.12); color:var(--orange); }
  .px-iscore.D { background:rgba(232,84,84,0.12); color:var(--des); }

  /* ── Network links ── */
  .px-links { padding:8px 10px; display:flex; flex-direction:column; gap:5px; }
  .px-link {
    display:flex; align-items:center; gap:10px; padding:9px 12px;
    border-radius:var(--r-md); border:1px solid var(--bd);
    background:var(--glass-L1-bg); transition:var(--tr);
  }
  .px-link:hover { border-color:var(--tx-meta); }
  .px-licon { width:24px; height:24px; border-radius:6px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .px-licon svg { width:12px; height:12px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
  .px-licon.on { background:rgba(76,175,80,0.1); color:var(--suc); }
  .px-licon.warn { background:rgba(255,193,7,0.1); color:var(--yellow); }
  .px-licon.err { background:rgba(232,84,84,0.1); color:var(--des); }
  .px-linfo { flex:1; min-width:0; display:flex; flex-direction:column; gap:1px; }
  .px-lname { font-size:var(--fs-small); font-weight:var(--fw-medium); color:var(--tx); }
  .px-ldesc { font-size:8px; color:var(--tx3); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .px-lstat { font-size:9px; font-family:var(--fm); font-weight:var(--fw-medium); color:var(--tx2); text-align:right; min-width:44px; }

  /* ── Shared gauge bar component (used elsewhere too) ── */
  .gbar { height:5px; border-radius:3px; background:var(--ghost); overflow:hidden; }
  .gbar-f { height:100%; border-radius:3px; transition:width 0.5s; }
  .oct-dot { width:8px; height:8px; border-radius:50%; }
  .oct-lbl { font-size:var(--fs-caption); color:var(--tx3); font-family:var(--fm); margin-left:6px; }
  .oct-body { padding:14px 16px; font-family:var(--fm); font-size:11px; line-height:1.6; color:var(--tx2); position:relative; min-height:100px; }
  .oct-body .kw { color:var(--des); }
  .oct-body .fn { color:var(--suc); }
  .oct-body .hl { color:var(--pri); }
  .oct-inv { position:absolute; bottom:12px; right:14px; font-size:22px; opacity:0.5; }

  /* ===== PROXY: Chain Visualization (5-step) ===== */
  .px-chain { display:flex; align-items:center; gap:3px; }
  .px-clink { display:flex; align-items:center; gap:3px; }
  .px-cldot { width:10px; height:10px; border-radius:50%; flex-shrink:0; }
  .px-cldot.on { background:var(--suc); box-shadow:0 0 0 0 rgba(76,175,80,0.4); animation:pxOn 1.5s ease-in-out infinite; }
  .px-cldot.warn { background:var(--yellow); }
  .px-cldot.dead { background:var(--tx3); }
  .px-clabel { font-size:8px; color:var(--tx3); white-space:nowrap; }
  .px-cline { width:12px; height:2px; border-radius:1px; background:var(--bd2); flex-shrink:0; }
  .px-cline.on { background:var(--suc); }
  .px-cline.warn { background:var(--yellow); }

  /* ===== PROXY: Tab Navigation ===== */
  .px-tabbar {
    display:flex; gap:2px; padding:2px; border-radius:var(--r-md);
    background:var(--glass-L1-bg); border:1px solid var(--bd); flex-shrink:0;
  }
  .px-tab-btn {
    flex:1; padding:5px 6px; border-radius:var(--r-sm); border:none;
    background:transparent; color:var(--tx3); font-size:var(--fs-caption);
    font-weight:var(--fw-medium); cursor:pointer; font-family:var(--ff);
    transition:var(--tr); white-space:nowrap; text-align:center;
  }
  .px-tab-btn:hover { color:var(--tx2); background:var(--ghost); }
  .px-tab-btn.on {
    background:var(--glass-L2-bg); color:var(--pri);
    font-weight:var(--fw-semibold); box-shadow:var(--shadow-sm);
  }
  .px-tab-pane { display:none; flex-direction:column; gap:8px; }
  .px-tab-pane.open { display:flex; }

  /* ===== PROXY: World Map ===== */
  .px-map-wrap {
    background:var(--glass-L2-bg); border-radius:var(--r-lg);
    border:1px solid var(--bd); padding:12px; overflow:hidden;
  }
  .px-map-wrap svg { width:100%; height:auto; display:block; }
  .px-map-legend { display:flex; gap:12px; justify-content:center; margin-top:8px; flex-wrap:wrap; }
  .px-map-legend span { display:flex; align-items:center; gap:4px; font-size:9px; color:var(--tx3); }
  .px-map-dot { width:6px; height:6px; border-radius:50%; display:inline-block; flex-shrink:0; }

  /* ===== PROXY: Node Table ===== */
  .px-nodes-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:6px; }
  .px-healthbar { height:6px; border-radius:3px; background:var(--ghost); overflow:hidden; display:flex; }
  .px-hb-fast { height:100%; background:var(--suc); }
  .px-hb-med { height:100%; background:var(--yellow); }
  .px-hb-slow { height:100%; background:var(--orange); }
  .px-hb-dead { height:100%; background:var(--tx3); }
  .px-hblegend { display:flex; gap:10px; font-size:9px; color:var(--tx3); margin:4px 0 8px; flex-wrap:wrap; }
  .px-hblegend span { display:flex; align-items:center; gap:3px; }
  .px-nthead { display:flex; align-items:center; padding:4px 8px; font-size:8px; color:var(--tx3); font-weight:var(--fw-semibold); text-transform:uppercase; border-bottom:1px solid var(--bd); gap:4px; }
  .px-nthead span { flex:1; min-width:0; }
  .px-nthead .col-speed { max-width:18px; flex:none; }
  .px-nthead .col-status { max-width:16px; flex:none; text-align:center; }
  .px-ntrow { display:flex; align-items:center; padding:5px 8px; gap:4px; border-radius:var(--r-sm); transition:var(--tr); cursor:pointer; border-bottom:1px solid var(--bd); }
  .px-ntrow:last-child { border-bottom:none; }
  .px-ntrow:hover { background:var(--ghost); }
  .px-ntrow.dead { opacity:0.5; }
  .px-ntrow span { flex:1; color:var(--tx2); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:var(--fs-caption); min-width:0; }
  .px-ntrow .col-speed { max-width:18px; flex:none; text-align:center; font-size:11px; }
  .px-ntrow .col-status { max-width:16px; flex:none; text-align:center; }
  .px-ntrow .col-tag { flex:2; }
  .px-ntrow .col-score { font-family:var(--fm); }
  .px-ntrow .col-latency { font-family:var(--fm); }
  .px-ntrow .col-sf { font-family:var(--fm); font-size:8px; }

  /* ===== PROXY: Subscription Manager ===== */
  .px-sub-row { display:flex; gap:6px; margin-bottom:6px; }
  .px-sub-input {
    flex:1; padding:6px 10px; border-radius:var(--r-md); border:1px solid var(--bd);
    background:var(--ghost); color:var(--tx2); font-size:var(--fs-caption);
    font-family:var(--ff); outline:none; transition:var(--tr);
  }
  .px-sub-input:focus { border-color:var(--pri); color:var(--tx); }
  .px-sub-input::placeholder { color:var(--tx3); }
  .px-sub-list { display:flex; flex-direction:column; gap:2px; max-height:200px; overflow-y:auto; }
  .px-sub-item { display:flex; align-items:center; gap:6px; padding:5px 8px; border-radius:var(--r-sm); font-size:var(--fs-caption); color:var(--tx2); background:var(--ghost); }
  .px-sub-item:hover { background:var(--ghost-hover); }
  .px-sub-idx { color:var(--tx3); font-family:var(--fm); font-size:9px; min-width:14px; }
  .px-sub-url { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-family:var(--fm); font-size:9px; }
  .px-sub-rm { width:16px; height:16px; border:none; background:transparent; color:var(--tx3); cursor:pointer; border-radius:4px; display:flex; align-items:center; justify-content:center; font-size:10px; transition:var(--tr); line-height:1; }
  .px-sub-rm:hover { background:rgba(232,84,84,0.1); color:var(--des); }

  /* ===== PROXY: Settings Form ===== */
  .px-cfg-grid { display:flex; flex-direction:column; gap:8px; }
  .px-cfg-row { display:flex; align-items:center; gap:8px; }
  .px-cfg-row label { font-size:var(--fs-caption); color:var(--tx2); min-width:80px; flex-shrink:0; }
  .px-cfg-row input, .px-cfg-row select {
    padding:5px 8px; border-radius:var(--r-md); border:1px solid var(--bd);
    background:var(--ghost); color:var(--tx2); font-size:var(--fs-caption);
    font-family:var(--ff); outline:none; transition:var(--tr);
  }
  .px-cfg-row input:focus, .px-cfg-row select:focus { border-color:var(--pri); color:var(--tx); }
  .px-cfg-row input[type="number"] { max-width:80px; }
  .px-cfg-row select { cursor:pointer; min-width:130px; }
  .px-cfg-toggle { display:flex; align-items:center; gap:6px; }
  .px-cfg-toggle input[type="checkbox"] { width:14px; height:14px; cursor:pointer; margin:0; }
  .px-cfg-toggle span { font-size:var(--fs-caption); color:var(--tx3); }
  .px-submit-row { margin-top:4px; }

  /* ===== RECENTS NEW STYLES ===== */

  .pipeline-item { display:flex; align-items:center; justify-content:space-between; padding:6px 8px; border-radius:var(--r-sm); font-size:var(--fs-small); }
  .pipeline-item:hover { background:var(--ghost); }
  .pipeline-item .s { color:var(--tx2); }
  .pipeline-item .st { font-family:var(--fm); font-size:var(--fs-caption); }
  .pipeline-item .st.ok { color:var(--suc); }
  .pipeline-item .st.run { color:var(--pri); }
  .pipeline-item .st.pen { color:var(--tx-meta); }

  /* ===== OVERLAY PANELS ===== */
  .overlay-panel {
    position:fixed; inset:0; z-index:var(--z-overlay);
    display:none; align-items:center; justify-content:center;
    background:rgba(0,0,0,0.5); backdrop-filter:blur(8px);
    animation:fo 0.15s ease-out;
  }
  .overlay-panel.open { display:flex; }
  .overlay-box {
    width:520px; max-width:calc(100vw - 60px); max-height:calc(100vh - 60px);
    display:flex; flex-direction:column; border-radius:var(--r-xl);
    background:var(--glass-L4-bg); backdrop-filter:var(--glass-L4-blur);
    -webkit-backdrop-filter:var(--glass-L4-blur);
    border:1px solid var(--bd-glass);
    box-shadow:0 0 0 0.5px rgba(0,0,0,0.02), 0 16px 48px rgba(0,0,0,0.15);
    animation:mo 0.25s ease-out; overflow:hidden;
  }
  .overlay-h { display:flex; align-items:center; justify-content:space-between; padding:16px 20px; flex-shrink:0; border-bottom:1px solid var(--bd); }
  .overlay-h h2 { font-size:var(--fs-heading); font-weight:var(--fw-semibold); color:var(--tx); }
  .overlay-bd { flex:1; overflow-y:auto; padding:16px 20px; }

  /* ===== POPOVER MENU ===== */
  .popover {
    display:none; position:absolute; bottom:calc(100% + 8px); left:0; z-index:var(--z-popover);
  }
  .popover.open { display:block; }
  .popover-card {
    width:256px; padding:8px; border-radius:16px;
    background:var(--glass-L4-bg); backdrop-filter:var(--glass-L4-blur);
    -webkit-backdrop-filter:var(--glass-L4-blur);
    border:1px solid var(--bd2); box-shadow:0 8px 32px rgba(0,0,0,0.12);
    display:flex; flex-direction:column; gap:2px;
  }
  .pop-hd { display:flex; align-items:center; gap:10px; padding:8px 8px 6px 8px; }
  .pop-av { width:36px; height:36px; border-radius:50%; background:var(--ghost); display:flex; align-items:center; justify-content:center; font-weight:var(--fw-semibold); color:var(--tx); border:1px solid var(--bd); flex-shrink:0; }
  .pop-info { display:flex; flex-direction:column; }
  .pop-name { font-size:var(--fs-small); font-weight:var(--fw-semibold); color:var(--tx); line-height:1.3; }
  .pop-email { font-size:var(--fs-caption); color:var(--tx3); line-height:1.3; }
  .pop-sep { height:1px; background:var(--bd); margin:4px 8px; }
  .pop-item {
    display:flex; align-items:center; gap:10px; width:100%; padding:8px 10px; border:none; border-radius:10px;
    background:transparent; color:var(--tx2); font-size:var(--fs-small); font-family:var(--ff);
    cursor:pointer; text-align:left; transition:var(--tr);
  }
  .pop-item:hover { background:var(--ghost); }
  .pop-item svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }
  .pop-shortcut { margin-left:auto; font-size:var(--fs-caption); color:var(--tx3); font-family:var(--fm); }
  .pop-chev { margin-left:auto; color:var(--tx3); }
  .pop-logout { color:var(--tx3); }
  .pop-logout:hover { color:var(--red); background:rgba(232,84,84,0.08); }

  /* ===== SETTINGS MODAL ===== */
  .st-modal {
    width:720px; max-width:calc(100vw - 60px); height:560px; max-height:calc(100vh - 60px);
    display:flex; border-radius:20px; overflow:hidden;
    background:var(--glass-L4-bg); backdrop-filter:var(--glass-L4-blur);
    -webkit-backdrop-filter:var(--glass-L4-blur);
    border:1px solid var(--bd-glass);
    box-shadow:0 0 0 0.5px rgba(0,0,0,0.02), 0 16px 48px rgba(0,0,0,0.15);
    animation:mo 0.25s ease-out; overflow:hidden;
  }
  .st-sidebar {
    width:200px; flex-shrink:0; padding:16px 12px; display:flex; flex-direction:column; gap:4px;
    border-right:1px solid var(--bd); background:rgba(0,0,0,0.02);
  }
  .st-search {
    position:relative; display:flex; align-items:center; margin-bottom:8px;
  }
  .st-search svg { position:absolute; left:10px; width:13px; height:13px; fill:none; stroke:var(--tx3); stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; pointer-events:none; }
  .st-search input {
    width:100%; padding:7px 10px 7px 30px; border-radius:10px; border:1px solid var(--bd);
    background:var(--glass-L1-bg); font-size:var(--fs-caption); font-family:var(--ff);
    color:var(--tx); outline:none; transition:var(--tr);
  }
  .st-search input:focus { border-color:var(--tx-meta); }
  .st-search input::placeholder { color:var(--tx3); }
  .st-kbd {
    position:absolute; right:8px; font-size:10px; font-family:var(--fm); color:var(--tx3);
    padding:1px 5px; border-radius:4px; border:1px solid var(--bd); background:var(--glass-L1-bg);
    pointer-events:none;
  }
  .st-grp {
    font-size:10px; font-weight:var(--fw-semibold); text-transform:uppercase; letter-spacing:0.8px;
    color:var(--tx3); padding:12px 10px 4px 10px;
  }
  .st-item {
    display:flex; align-items:center; gap:8px; padding:7px 10px; border-radius:8px;
    font-size:var(--fs-caption); color:var(--tx2); cursor:pointer; transition:var(--tr);
  }
  .st-item:hover { background:var(--ghost); }
  .st-item.on { background:var(--ghost); color:var(--tx); font-weight:var(--fw-medium); }
  .st-item svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }
  .st-content { flex:1; display:flex; flex-direction:column; overflow:hidden; }
  .st-top { display:flex; align-items:center; justify-content:space-between; padding:16px 24px; flex-shrink:0; }
  .st-title { font-size:var(--fs-heading); font-weight:var(--fw-semibold); color:var(--tx); }
  .st-body { flex:1; overflow-y:auto; padding:0 24px 24px 24px; }
  .st-section { display:none; } .st-section:first-of-type { display:block; }
  .st-h2 { font-size:var(--fs-large); font-weight:var(--fw-semibold); color:var(--tx); margin-bottom:16px; }
  .st-card {
    border-radius:14px; border:1px solid var(--bd); background:var(--glass-L1-bg);
    backdrop-filter:var(--glass-L1-blur); -webkit-backdrop-filter:var(--glass-L1-blur);
    padding:14px 16px; margin-bottom:20px;
  }
  .st-card-row { display:flex; align-items:center; justify-content:space-between; }
  .st-card-info { display:flex; flex-direction:column; gap:2px; }
  .st-lbl { font-size:var(--fs-small); font-weight:var(--fw-semibold); color:var(--tx); }
  .st-desc { font-size:var(--fs-caption); color:var(--tx3); line-height:1.4; }
  .st-av { width:40px; height:40px; border-radius:50%; background:var(--ghost); display:flex; align-items:center; justify-content:center; font-weight:var(--fw-bold); color:var(--tx); border:1px solid var(--bd); flex-shrink:0; }
  .st-field { margin-bottom:16px; }
  .st-field .st-lbl { display:block; margin-bottom:5px; font-size:var(--fs-caption); }
  .st-input {
    width:100%; padding:9px 14px; border-radius:12px; border:1px solid var(--bd);
    background:var(--glass-L1-bg); font-size:var(--fs-small); font-family:var(--ff);
    color:var(--tx); outline:none; transition:var(--tr); box-sizing:border-box;
  }
  .st-input:focus { border-color:var(--tx-meta); box-shadow:0 0 0 3px rgba(0,0,0,0.04); }
  .st-input::placeholder { color:var(--tx3); }
  .st-switch { display:inline-flex; align-items:center; cursor:pointer; flex-shrink:0; }
  .st-switch input { width:36px; height:20px; border-radius:10px; border:1px solid var(--bd2); background:var(--ghost); appearance:none; -webkit-appearance:none; cursor:pointer; position:relative; transition:var(--tr); margin:0; }
  .st-switch input::after { content:''; position:absolute; top:2px; left:2px; width:14px; height:14px; border-radius:50%; background:var(--tx3); transition:var(--tr); }
  .st-switch input:checked { background:var(--pri); border-color:var(--pri); }
  .st-switch input:checked::after { left:18px; background:#fff; }
  select.st-input { appearance:none; -webkit-appearance:none; background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 8 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 3l2 2 2-2' fill='none' stroke='%23999' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); background-repeat:no-repeat; background-position:right 12px center; background-size:10px; padding-right:32px; cursor:pointer; }

  /* ════════════════════════════════════════════════
     Accessibility: Reduce Transparency Fallback
     — solidifies all glass surfaces to opaque with
       semantic borders (WCAG 4.5:1 minimum)
     ════════════════════════════════════════════════ */
  @media (prefers-reduced-transparency: reduce) {
    .app { background: var(--bg-base); backdrop-filter: none; -webkit-backdrop-filter: none; border-color: var(--bd2); box-shadow: var(--shadow-md); }
    .sb { background: var(--bg-base); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .ma { background: var(--gray-50); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .sf { background: var(--gray-100); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .seg { background: var(--gray-100); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .segb.on { background: var(--accent-bg); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .cic { background: var(--white); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .popover-card { background: var(--white); backdrop-filter: none; -webkit-backdrop-filter: none; border-color: var(--bd2); }
    .overlay-box { background: var(--white); backdrop-filter: none; -webkit-backdrop-filter: none; border-color: var(--bd2); }
    .st-modal { background: var(--white); backdrop-filter: none; -webkit-backdrop-filter: none; border-color: var(--bd2); }
    .st-card { background: var(--white); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .st-input { background: var(--white); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .onboard-card { background: var(--white); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .oc-code { background: var(--white); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .ch-upgrade { background: var(--gray-50); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .sb-float { background: var(--gray-100); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .rb { background: var(--gray-50); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .rb-float { background: var(--gray-100); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .ap { background: var(--gray-50); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .ap-tabs { background: var(--gray-100); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .msg.l .mb { background: var(--gray-50); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .px-hero { background: var(--gray-50); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .px-card { background: var(--gray-50); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .px-section { background: var(--gray-50); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .px-item { background: var(--gray-50); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .px-link { background: var(--gray-50); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .overlay-panel { background: rgba(0,0,0,0.6); backdrop-filter: none; -webkit-backdrop-filter: none; }
    [data-theme="dark"] .ma { background: var(--gray-50); }
    [data-theme="dark"] .popover-card { background: var(--gray-100); }
    [data-theme="dark"] .overlay-box { background: var(--gray-100); }
    [data-theme="dark"] .st-modal { background: var(--gray-100); }
    [data-theme="dark"] .st-card { background: var(--gray-100); }
    [data-theme="dark"] .app { background: var(--gray-50); }
    [data-theme="dark"] .sb { background: var(--gray-50); }
    [data-theme="dark"] .cic { background: var(--gray-100); }
    [data-theme="dark"] .onboard-card { background: var(--gray-100); }
    [data-theme="dark"] .oc-code { background: var(--gray-100); }
    [data-theme="dark"] .rb { background: var(--gray-50); }
    [data-theme="dark"] .ap { background: var(--gray-50); }
    [data-theme="dark"] .px-hero { background: var(--gray-50); }
    [data-theme="dark"] .px-card { background: var(--gray-50); }
    [data-theme="dark"] .px-section { background: var(--gray-50); }
    [data-theme="dark"] .px-item { background: var(--gray-50); }
    [data-theme="dark"] .px-link { background: var(--gray-50); }
  }

  /* Reduced motion — disable animations, keep transitions functional */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.1s !important;
    }
  }

  @keyframes fi { from{opacity:0;transform:translateY(4px)} to{opacity:1;transform:translateY(0)} }
  @keyframes bl { 0%,100%{opacity:1} 50%{opacity:0} }
  @keyframes fo { from{opacity:0} to{opacity:1} }
  @keyframes mo { from{opacity:0;transform:scale(0.96)} to{opacity:1;transform:scale(1)} }

  ::-webkit-scrollbar { width:4px; }
  ::-webkit-scrollbar-thumb { background:var(--tx-meta); border-radius:4px; }
  ::-webkit-scrollbar-thumb:hover { background:var(--tx3); }

  /* 五色辅助类: 红白黑绿黄 */
  .c-red { color:var(--red); } .c-white { color:#fff; } .c-black { color:var(--black); } .c-green { color:var(--green); } .c-yellow { color:var(--yellow); }
  .bg-red { background:var(--red); } .bg-green { background:var(--green); } .bg-yellow { background:var(--yellow); }

  /* Missing component styles */
  .evo-card {
    background:var(--glass-L1-bg); border:1px solid var(--bd); border-radius:var(--r-md);
    padding:12px 14px; display:flex; flex-direction:column; gap:4px;
  }
  .evo-card .lbl { font-size:9px; color:var(--tx3); text-transform:uppercase; letter-spacing:0.3px; }
  .evo-card .val { font-size:16px; font-weight:var(--fw-bold); color:var(--tx); font-family:var(--fm); }
  .onboard-card { background:var(--glass-L2-bg); backdrop-filter:var(--glass-L2-blur); -webkit-backdrop-filter:var(--glass-L2-blur); border-radius:var(--r-lg); border:1px solid var(--bd); padding:16px; }
  .oc-code { background:var(--glass-L1-bg); backdrop-filter:var(--glass-L1-blur); -webkit-backdrop-filter:var(--glass-L1-blur); border-radius:var(--r-md); padding:10px 12px; font-family:var(--fm); font-size:10px; line-height:1.6; color:var(--tx2); }
  .artifacts { display:flex; flex-wrap:wrap; gap:4px; margin-top:6px; }
  .art-link { display:inline-flex; align-items:center; gap:4px; padding:3px 8px; border-radius:6px; background:rgba(255,255,255,0.12); cursor:pointer; font-size:10px; color:rgba(255,255,255,0.7); transition:var(--tr); }
  .art-link:hover { background:rgba(255,255,255,0.2); color:#fff; }
  .art-link svg { width:10px; height:10px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
  .msg.l .art-link { background:var(--ghost); color:var(--pri); }
  .msg.l .art-link:hover { background:var(--accent-bg); }

  @media (prefers-reduced-transparency: reduce) {
    .slash-card { background:var(--bg-raised); backdrop-filter:none; -webkit-backdrop-filter:none; }
    .qo-box .qo-search { background:var(--bg-base); }
  }

  /* ═══════════════════════════════════════════════════════════
     修炼 · 经脉系统 (Cultivation Meridian System)
     替换 cowork 视图的 6 个旋转功能点
     ═══════════════════════════════════════════════════════════ */
  .mw { display:flex; flex-direction:column; height:100%; }
  .mw-header { padding:8px 10px 4px; border-bottom:1px solid var(--bd); flex-shrink:0; }
  .mw-title { font-size:11px; font-weight:var(--fw-semibold); color:var(--tx); display:flex; align-items:center; gap:6px; }
  .mw-title svg { width:12px; height:12px; fill:none; stroke:var(--pri); stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
  .mw-sub { font-size:9px; color:var(--tx3); margin-top:1px; }

  /* 境界进度 */
  .mw-realm { padding:8px 10px; border-bottom:1px solid var(--bd); flex-shrink:0; }
  .mw-realm-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:4px; }
  .mw-realm-name { font-size:10px; font-weight:var(--fw-semibold); color:var(--tx); }
  .mw-realm-pct { font-size:9px; color:var(--pri); font-family:var(--fm); }
  .mw-realm-bar { height:3px; border-radius:3px; background:var(--ghost); overflow:hidden; position:relative; }
  .mw-realm-fill { height:100%; border-radius:3px; background:linear-gradient(90deg,var(--pri),var(--orange)); transition:width 0.8s var(--ease-out-expo); }
  .mw-realm-stars { display:flex; gap:2px; margin-top:3px; }
  .mw-realm-star { width:6px; height:6px; border-radius:50%; border:1px solid var(--tx3); transition:var(--tr); }
  .mw-realm-star.on { background:var(--yellow); border-color:var(--yellow); box-shadow:0 0 4px rgba(255,193,7,0.5); }

  /* 经脉通道列表 (替换6个旋转功能点) */
  .mw-channels { flex:1; overflow-y:auto; padding:4px 6px; }
  .mw-ch { display:flex; align-items:center; gap:6px; padding:5px 6px; border-radius:6px; cursor:pointer; transition:var(--tr); font-size:10px; color:var(--tx2); position:relative; }
  .mw-ch:hover { background:var(--ghost); color:var(--tx); }
  .mw-ch.on { background:var(--accent-bg); color:var(--pri); font-weight:var(--fw-medium); }
  .mw-ch-dot { width:6px; height:6px; border-radius:50%; flex-shrink:0; transition:var(--tr); }
  .mw-ch.on .mw-ch-dot { box-shadow:0 0 6px currentColor; }
  .mw-ch-name { flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .mw-ch-status { font-size:8px; color:var(--tx3); }
  .mw-ch-prog { width:30px; height:2px; border-radius:2px; background:var(--ghost); overflow:hidden; }
  .mw-ch-prog-fill { height:100%; border-radius:2px; background:var(--suc); transition:width 0.6s var(--ease-out-expo); }
  .mw-ch.active .mw-ch-prog-fill { background:var(--pri); }

  /* 人体经脉SVG */
  .mw-body-wrap { padding:6px 10px 10px; flex-shrink:0; border-top:1px solid var(--bd); }
  .mw-body { width:100%; aspect-ratio:1/2.2; display:block; }
  .mw-body .meridian { fill:none; stroke-linecap:round; stroke-linejoin:round; transition:opacity 1.2s ease, stroke 0.8s ease, stroke-width 0.8s ease; }
  .mw-body .acupoint { transition:opacity 0.6s ease, r 0.4s ease, fill 0.4s ease; cursor:pointer; }
  .mw-body .acupoint:hover { r:4; filter:brightness(1.3); }
  .mw-body .acupoint.selected { r:4.5; stroke:#fff; stroke-width:1.5; }
  .mw-body .body-outline { fill:none; stroke:var(--bd2); stroke-width:0.8; opacity:0.3; }

  /* 功法进度 (sidebar底部) */
  .mw-tech { padding:6px 10px 8px; border-top:1px solid var(--bd); flex-shrink:0; }
  .mw-tech-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:3px; }
  .mw-tech-name { font-size:9px; font-weight:var(--fw-medium); color:var(--tx); }
  .mw-tech-pct { font-size:8px; color:var(--tx3); font-family:var(--fm); }
  .mw-tech-bar { height:2px; border-radius:2px; background:var(--ghost); overflow:hidden; }
  .mw-tech-fill { height:100%; border-radius:2px; background:linear-gradient(90deg,var(--suc),var(--pri)); transition:width 0.6s var(--ease-out-expo); }
  .mw-tech-info { font-size:8px; color:var(--tx3); margin-top:2px; }

  /* 经脉点详情面板 (右侧内容区) */
  .mw-detail { display:flex; flex-direction:column; height:100%; padding:16px; overflow-y:auto; }
  .mw-detail.hidden { display:none; }
  .mw-dp-title { font-size:13px; font-weight:var(--fw-semibold); color:var(--tx); margin-bottom:2px; }
  .mw-dp-sub { font-size:10px; color:var(--tx3); margin-bottom:12px; }
  .mw-dp-desc { font-size:10px; color:var(--tx2); line-height:1.6; margin-bottom:12px; padding:8px 10px; background:var(--ghost); border-radius:6px; }
  .mw-dp-label { font-size:9px; color:var(--tx3); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px; }
  .mw-dp-stat { display:flex; gap:8px; margin-bottom:10px; flex-wrap:wrap; }
  .mw-dp-stat-item { flex:1; min-width:50px; padding:6px 8px; border-radius:6px; background:var(--ghost); text-align:center; }
  .mw-dp-stat-val { font-size:14px; font-weight:var(--fw-bold); color:var(--tx); font-family:var(--fm); }
  .mw-dp-stat-lbl { font-size:8px; color:var(--tx3); margin-top:1px; }
  .mw-dp-related { display:flex; flex-wrap:wrap; gap:4px; }
  .mw-dp-related span { padding:2px 6px; border-radius:4px; background:var(--ghost); font-size:8px; color:var(--tx2); cursor:pointer; transition:var(--tr); }
  .mw-dp-related span:hover { background:var(--accent-bg); color:var(--pri); }

  /* 忽隐忽现动画 */
  @keyframes meridian-pulse {
    0%,100% { opacity:0.3; }
    50% { opacity:1; }
  }
  @keyframes meridian-breathe {
    0%,100% { opacity:0.2; }
    50% { opacity:0.7; }
  }
  @keyframes point-glow {
    0%,100% { opacity:0.4; filter:drop-shadow(0 0 0px currentColor); }
    50% { opacity:1; filter:drop-shadow(0 0 4px currentColor); }
  }
  .mw-body .meridian.active { stroke-width:1.8; animation:meridian-pulse 3s ease-in-out infinite; }
  .mw-body .meridian.idle { stroke-width:0.6; animation:meridian-breathe 5s ease-in-out infinite; }
  .mw-body .meridian.dormant { stroke-width:0.3; opacity:0.15; animation:none; }
  .mw-body .acupoint.active { animation:point-glow 2s ease-in-out infinite; }
  .mw-body .acupoint.idle { opacity:0.4; }
  .mw-body .acupoint.dormant { opacity:0.1; }

  /* 响应式 */
  @media (max-width:1100px) {
    .mw-body-wrap { display:none; }
    .mw-tech { display:none; }
  }

  /* ═══════════════════════════════════════════════════════════
     Responsive Breakpoints
     ═══════════════════════════════════════════════════════════ */

  /* Mobile: <640px — full-screen, stacked */
  @media (max-width: 639px) {
    body { padding:0; }
    .app { width:100vw; max-width:100vw; height:100vh; max-height:100vh; border-radius:0; }
    .sb { width:0; min-width:0; overflow:hidden; border-right:none; }
    .rb { width:0; min-width:0; overflow:hidden; border-left:none; opacity:0; }
    .traffic { left:8px; top:10px; }
    .sb-float { left:8px; top:10px; opacity:1; pointer-events:auto; }
    .rb-float { display:none; }
    .chat { padding:12px; }
    .msg { max-width:95%; }
    .qo-box { padding:12px 14px; }
  }

  /* Tablet: 640–1023px — collapsed sidebars */
  @media (min-width: 640px) and (max-width: 1023px) {
    .sb.collapsed { width:0; min-width:0; overflow:hidden; border-right:none; }
    .sb.collapsed .sb-top,
    .sb.collapsed .sf { display:none; }
    .sb.collapsed + .traffic + .sb-float { opacity:1; pointer-events:auto; }
    .sb.collapsed + .traffic + .sb-float + .ma { border-radius:12px 0 0 12px; }
    .rb.auto-hide { width:0; min-width:0; overflow:hidden; border-left:none; opacity:0; }
    .rb.auto-hide .rb-float { opacity:1; pointer-events:auto; }
  }

  /* Small desktop: 1024–1279px — narrower sidebars */
  @media (min-width: 1024px) and (max-width: 1279px) {
    :root { --sw: 200px; --rw: 220px; }
  }

  /* Large desktop: >1280px — full layout (default) */

  /* ═══ FLOATING DESKTOP PET ═══ */
  #neoPet {
    position: fixed;
    bottom: 60px;
    right: 40px;
    z-index: var(--z-modal);
    width: 160px;
    height: 200px;
    cursor: grab;
    user-select: none;
    touch-action: none;
    pointer-events: auto;
    transition: filter 0.3s;
  }
  #neoPet:active { cursor: grabbing; }
  #neoPet canvas {
    width: 160px;
    height: 200px;
    display: block;
    border-radius: 20px;
    background: var(--bg-raised, #1a1a2e);
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }
  #neoPet.dim {
    filter: brightness(0.6) saturate(0.4);
    transition: filter 0.8s;
  }
  #neoPet .pet-tooltip {
    position: absolute;
    top: -28px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--tx);
    color: var(--bg-base);
    font-size: 10px;
    font-weight: 600;
    padding: 2px 10px;
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  #neoPet:hover .pet-tooltip { opacity: 1; }
  .pet-acupoint {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    border: 1.5px solid rgba(255,255,255,0.2);
    cursor: pointer;
    pointer-events: auto;
    transform: translate(-50%, -50%);
    transition: transform 0.25s, box-shadow 0.3s, background 0.3s, border-color 0.3s;
    z-index: 2;
  }
  .pet-acupoint:hover {
    transform: translate(-50%, -50%) scale(1.8);
    background: rgba(255,255,255,0.15);
    z-index: 10;
  }
  .pet-acupoint.active {
    border-width: 2px;
    background: rgba(255,255,255,0.12);
    animation: acuPulse 2s ease-in-out infinite;
  }
  .pet-acupoint.selected {
    transform: translate(-50%, -50%) scale(2);
    background: rgba(255,255,255,0.2);
    z-index: 10;
  }
  .pet-acupoint .pa-label {
    position: absolute;
    left: 14px;
    top: -2px;
    font-size: 7px;
    font-weight: 500;
    color: var(--tx2, #aaa);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
  }
  .pet-acupoint:hover .pa-label,
  .pet-acupoint.selected .pa-label { opacity: 1; }
  @keyframes acuPulse {
    0%, 100% { box-shadow: 0 0 4px currentColor; }
    50% { box-shadow: 0 0 12px currentColor; }
  }
  @keyframes petBreathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.02); }
  }
  @keyframes petBreathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.02); }
  }
  @keyframes petFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  #neoPet.breathe { animation: petBreathe 3s ease-in-out infinite; }
  #neoPet.float { animation: petFloat 4s ease-in-out infinite; }

</style>
</head>
<body>
<div class="app">
  <div class="ab">

    <!-- ═══ SIDEBAR ═══ -->
    <aside class="sb" id="sidebar">
      <div class="sb-top">
        <!-- Window Header -->
        <div class="sb-header">
          <div class="sb-header-actions">
            <button class="sbn" id="sidebarToggle" onclick="toggleSidebar()">
              <svg viewBox="0 0 14 14"><line x1="10" y1="3" x2="10" y2="11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><polyline points="7,5 5,7 7,9" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button class="sbn" onclick="showToast('搜索 (开发中)')">
              <svg viewBox="0 0 14 14"><circle cx="6" cy="6" r="3.5" stroke="currentColor" stroke-width="1.2" fill="none"/><line x1="9" y1="9" x2="12.5" y2="12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            </button>
          </div>
        </div>

        <!-- Segmented Control — icon-only consciousness modes -->
        <div class="seg">
          <button class="segb on" data-view="chat" onclick="switchView(this,'chat')">
            <svg viewBox="0 0 16 16"><path d="M8 2l1.8 4.2L14 8l-4.2 1.8L8 14l-1.8-4.2L2 8l4.2-1.8z" stroke="currentColor" stroke-width="1" fill="none" stroke-linejoin="round"/><circle cx="8" cy="8" r="1.5" fill="currentColor" stroke="none"/></svg>
            对话
          </button>
          <button class="segb" data-view="cowork" onclick="switchView(this,'cowork')">
            <svg viewBox="0 0 16 16"><path d="M6 3l1.2 2.8L10 7l-2.8 1.2L6 11l-1.2-2.8L2 7l2.8-1.2z" stroke="currentColor" stroke-width="1" fill="none" stroke-linejoin="round"/><path d="M10 7.5l1.2 2.8L14 11l-2.8 1.2L10 15l-1.2-2.8L6 11l2.8-1.2z" stroke="currentColor" stroke-width="0.8" fill="none" stroke-linejoin="round" opacity="0.45"/></svg>
            团队
          </button>
          <button class="segb" data-view="code" onclick="switchView(this,'code')">
            <svg viewBox="0 0 16 16"><polygon points="8,2 13,5.5 13,10.5 8,14 3,10.5 3,5.5" stroke="currentColor" stroke-width="1" fill="none" stroke-linejoin="round"/><line x1="8" y1="5" x2="8" y2="11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            代码
          </button>
          <button class="segb" data-view="agent" onclick="switchView(this,'agent')">
            <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1" fill="none"/><ellipse cx="8" cy="8" rx="3" ry="6" stroke="currentColor" stroke-width="0.8" fill="none"/><line x1="2" y1="5.5" x2="14" y2="5.5" stroke="currentColor" stroke-width="0.8" stroke-linecap="round"/><line x1="2" y1="10.5" x2="14" y2="10.5" stroke="currentColor" stroke-width="0.8" stroke-linecap="round"/></svg>
            代理
          </button>
        </div>

        <!-- Dynamic Nav List -->
        <div class="nav-list" id="navList"></div>

        <!-- Dynamic Recents -->
        <div class="re" id="recentList"></div>
      </div>

      <!-- User Bar — click avatar for popover menu -->
      <div class="sf" id="userBar">
        <div class="sa" onclick="togglePopover(event)" style="cursor:pointer">N</div>
        <div class="su-info" onclick="togglePopover(event)" style="cursor:pointer">
          <div class="su-name">neotrix</div>
          <div class="su-plan">dolpinsy@gmail.com</div>
        </div>
        <div class="sf-actions"></div>

        <!-- User Popover Menu -->
        <div class="popover" id="userPopover">
          <div class="popover-card">
            <div class="pop-hd">
              <div class="pop-av">N</div>
              <div class="pop-info">
                <div class="pop-name">neotrix</div>
                <div class="pop-email">dolpinsy@gmail.com</div>
              </div>
            </div>
            <div class="pop-sep"></div>
            <button class="pop-item" onclick="openSettingsModal();closePopover()"><svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="2.5" stroke="currentColor" stroke-width="1" fill="none"/><line x1="7" y1="1.5" x2="7" y2="3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="7" y1="10.5" x2="7" y2="12.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="1.5" y1="7" x2="3.5" y2="7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="10.5" y1="7" x2="12.5" y2="7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>设置<span class="pop-shortcut">⌘,</span></button>
            <button class="pop-item" id="popThemeToggle" onclick="toggleTheme();closePopover()"><svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1" fill="none"/><line x1="7" y1="2" x2="7" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="7" y1="10" x2="7" y2="12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="2" y1="7" x2="4" y2="7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="10" y1="7" x2="12" y2="7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>主题切换<span class="pop-shortcut" id="popThemeLabel">亮色</span></button>
            <button class="pop-item" onclick="openSettingsModal();setTimeout(()=>{document.querySelectorAll('.st-item')[6].click()},100);closePopover()"><svg viewBox="0 0 14 14"><rect x="2.5" y="6" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="1" fill="none"/><path d="M4.5 6V4a2.5 2.5 0 015 0v2" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>隐私与安全<svg class="pop-chev" viewBox="0 0 8 8"><line x1="3" y1="2" x2="6" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="3" y1="6" x2="6" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></button>
            <div class="pop-sep"></div>
            <button class="pop-item" onclick="closePopover();showToast('语言: 中文 (当前)')"><svg viewBox="0 0 14 14"><path d="M7 2A5 5 0 102 7" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/><polygon points="7,2 10,4 7,6" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>语言<svg class="pop-chev" viewBox="0 0 8 8"><line x1="3" y1="2" x2="6" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="3" y1="6" x2="6" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg><span class="pop-shortcut">中文</span></button>
            <button class="pop-item" onclick="closePopover();showToast('帮助文档 (开发中)')"><svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1" fill="none"/><line x1="7" y1="7" x2="7" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><circle cx="7" cy="10" r=".5" stroke="currentColor" stroke-width="1" fill="none"/></svg>帮助与反馈</button>
            <button class="pop-item" onclick="closePopover();showToast('NeoTrix v0.19.0 · 9-Layer Architecture')"><svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1" fill="none"/><line x1="7" y1="6" x2="7" y2="9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><circle cx="7" cy="4.5" r=".5" stroke="currentColor" stroke-width="1" fill="none"/></svg>关于 NeoTrix</button>
            <div class="pop-sep"></div>
            <button class="pop-item" onclick="closePopover();showToast('升级计划 — Pro 版本即将推出')"><svg viewBox="0 0 14 14"><line x1="7" y1="1.5" x2="7" y2="12.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="2" y1="7" x2="12" y2="7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>升级计划<span class="pop-shortcut">Pro</span></button>
            <button class="pop-item" onclick="closePopover();showToast('桌面端下载 (开发中)')"><svg viewBox="0 0 14 14"><line x1="7" y1="2" x2="7" y2="12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><polyline points="4,9 7,12 10,9" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>下载桌面端</button>
            <div class="pop-sep"></div>
            <button class="pop-item pop-logout" onclick="closePopover();showToast('已退出登录');clearChat()"><svg viewBox="0 0 14 14"><line x1="7" y1="2" x2="7" y2="8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><polyline points="4,5 7,8 10,5" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><line x1="2.5" y1="10" x2="11.5" y2="10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>退出登录</button>
          </div>
        </div>
      </div>
    </aside>

    <!-- Traffic lights — always visible, no glass -->
    <div class="traffic">
      <span class="t-dot t-c"></span>
      <span class="t-dot t-m"></span>
      <span class="t-dot t-x"></span>
    </div>

    <!-- Floating toggle for collapsed sidebar -->
    <button class="sb-float" id="sidebarFloat" onclick="toggleSidebar()">
      <svg viewBox="0 0 14 14"><line x1="10" y1="3" x2="10" y2="11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><polyline points="7,5 5,7 7,9" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <!-- ═══ MAIN ═══ -->
    <main class="ma">



      <!-- ═══ VIEW: Chat (对话) ═══ -->
      <div class="vw-chat" id="viewChat">
        <div class="ch-top">
          <button class="ch-upgrade">免费计划 <span style="font-weight:var(--fw-semibold)">• 升级</span></button>
          <button class="ch-icon-btn"><svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.2" fill="none"/><line x1="7" y1="7" x2="7" y2="4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="7" y1="7" x2="9.5" y2="8.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></button>
        </div>
        <div class="wc-inner" id="heroSection">
          <div class="hero">
            <div class="hero-svg">
              <svg viewBox="0 0 32 32" fill="none">
                <path d="M16 2l4 8 8 4-8 4-4 8-4-8-8-4 8-4 4-8z" fill="var(--pri)" opacity="0.25"/>
                <path d="M16 6l2.5 5 5.5 2.5-5.5 2.5-2.5 5-2.5-5L8 13.5l5.5-2.5 2.5-5z" fill="var(--pri)"/>
                <circle cx="16" cy="13.5" r="2.5" fill="var(--pri)" stroke="none"/>
                <circle cx="16" cy="13.5" r="1" fill="#fff" stroke="none"/>
                <path d="M4 20q4-4 8 0t8-8 8 4" stroke="var(--pri2)" stroke-width="0.8" stroke-linecap="round" opacity="0.4" fill="none"/>
              </svg>
            </div>
            <h1>下午好，Neo</h1>
          </div>
          <div class="cic">
            <textarea id="chatInput" rows="2" placeholder="输入 / 查看技能" oninput="autoResize(this)" onkeydown="handleKey(event)"></textarea>
            <div class="cic-actions">
              <div class="cic-left">
                <button class="cic-attach"><svg viewBox="0 0 16 16"><line x1="8" y1="3" x2="8" y2="11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="4" y1="8" x2="12" y2="8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button>
              </div>
              <div class="cic-right">
                <button class="vc-btn vc-lang" onclick="showToast('🎤 语音输入已开启')" title="语音输入">
                  <svg viewBox="0 0 16 16"><rect x="5.5" y="2" width="5" height="7" rx="2.5" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M3 7v.5a5 5 0 0010 0V7" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/><line x1="8" y1="12" x2="8" y2="14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="5" y1="14" x2="11" y2="14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                </button>
                <button class="vc-btn vc-send" id="sendBtn" disabled onclick="sendMsg()" title="发送">
                  <svg class="s-mic" viewBox="0 0 18 14"><path d="M5 5v2a4 4 0 008 0V5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/><line x1="9" y1="11" x2="9" y2="13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="3" y1="13" x2="15" y2="13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><rect x="6" y="2" width="6" height="5" rx="3" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>
                  <svg class="s-wav" viewBox="0 0 18 14"><line x1="3" y1="10" x2="3" y2="4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="7" y1="12" x2="7" y2="2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="11" y1="11" x2="11" y2="3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="15" y1="9" x2="15" y2="5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>
        <div class="cs" id="chatScroll" style="display:none"></div>

        <!-- Conversation list panel -->
        <div class="conv-panel" id="convPanel">
          <div class="conv-panel-head">
            <h2>对话 <span class="conv-count" id="convCount">0</span></h2>
            <div style="display:flex;gap:6px">
              <button onclick="createConversation()" title="新建对话">+</button>
              <button onclick="closeConvPanel()" title="关闭">✕</button>
            </div>
          </div>
          <div class="conv-panel-body" id="convPanelBody"></div>
        </div>
      </div>

      <!-- ═══ VIEW: Cowork (协同) — 会话列表 + 任务看板 + 智能体监控 ═══ -->
      <div class="vw-cowork" id="viewCowork">
        <div class="cw-layout">
          <!-- 左侧：会话列表 -->
          <div class="cw-sidebar">
            <div class="cw-shead">
              <span>会话</span>
              <button class="cw-add" onclick="showToast('新建会话')"><svg viewBox="0 0 14 14"><line x1="7" y1="2" x2="7" y2="12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="2" y1="7" x2="12" y2="7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button>
            </div>
            <div class="cw-slist" id="cwSessionList"></div>
          </div>
          <!-- 右侧：任务详情 + 智能体 -->
          <div class="cw-main" id="cwDetail">
            <div class="cw-empty" id="cwEmpty">
              <svg viewBox="0 0 32 32" fill="none"><circle cx="16" cy="16" r="12" stroke="var(--tx-meta)" stroke-width="1.2"/><path d="M16 10v6l4 4" stroke="var(--tx-meta)" stroke-width="1.5" stroke-linecap="round"/></svg>
              <p>选择或创建一个协同会话</p>
              <span>任务将在这里展示</span>
            </div>
            <div class="cw-content" id="cwContent" style="display:none">
              <div class="cw-header">
                <div>
                  <div class="cw-title" id="cwDetailTitle">—</div>
                  <div class="cw-sub" id="cwDetailStatus">0 个任务</div>
                </div>
                <div class="cw-hbadge" id="cwHBadge">进行中</div>
              </div>
              <div class="cw-section-title"><svg viewBox="0 0 12 12"><line x1="2" y1="6" x2="10" y2="6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><circle cx="6" cy="6" r="1.5" fill="none" stroke="currentColor" stroke-width="1"/></svg>任务列表</div>
              <div class="cw-tlist" id="cwTaskList"></div>
              <div class="cw-section-title"><svg viewBox="0 0 12 12"><circle cx="6" cy="4" r="2.5" stroke="currentColor" stroke-width="1" fill="none"/><path d="M2 11a4 4 0 018 0" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round"/></svg>智能体</div>
              <div class="cw-agents" id="cwAgentList"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ VIEW: Code (代码) — 文件树 + 编辑器 + 标签页 ═══ -->
      <div class="vw-code" id="viewCode">
        <div class="cd-layout">
          <!-- 左侧：文件树 -->
          <div class="cd-tree">
            <div class="cd-thead">
              <span>文件</span>
              <button class="cd-tbtn" onclick="showToast('刷新文件树')"><svg viewBox="0 0 14 14"><polyline points="2,7 4,9 7,4" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 7a5 5 0 11-5-5 5 5 0 014.5 3" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg></button>
            </div>
            <div id="codeFileTree"></div>
          </div>
          <!-- 右侧：编辑器 -->
          <div class="cd-editor">
            <div class="cd-tabs" id="codeTabs">
              <div class="cd-tab on" data-file="0" onclick="switchCodeTab(this,0)">main.rs</div>
              <div class="cd-tab" data-file="1" onclick="switchCodeTab(this,1)">lib.rs</div>
              <div class="cd-tab" data-file="2" onclick="switchCodeTab(this,2)">config.rs</div>
            </div>
            <div class="cd-toolbar">
              <button class="cd-tb-btn" title="格式化" onclick="showToast('格式化完成')"><svg viewBox="0 0 14 14"><line x1="2" y1="3" x2="12" y2="3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="4" y1="7" x2="12" y2="7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="2" y1="11" x2="12" y2="11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></button>
              <button class="cd-tb-btn" title="保存" onclick="showToast('已保存')"><svg viewBox="0 0 14 14"><path d="M3 1.5h8l1.5 1.5v9a1 1 0 01-1 1h-9a1 1 0 01-1-1V3z" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linejoin="round"/><line x1="4" y1="1.5" x2="4" y2="5" stroke="currentColor" stroke-width="1.2"/><circle cx="7" cy="9" r="1.5" stroke="currentColor" stroke-width="1.2" fill="none"/></svg></button>
              <button class="cd-tb-btn" title="复制" onclick="copyCode()"><svg viewBox="0 0 14 14"><rect x="3.5" y="2.5" width="8" height="10" rx="1" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M2.5 10.5h-1a1 1 0 01-1-1v-7a1 1 0 011-1h6a1 1 0 011 1v1" stroke="currentColor" stroke-width="1.2" fill="none"/></svg></button>
              <button class="cd-tb-btn" title="运行" onclick="showToast('运行中...')"><svg viewBox="0 0 14 14"><polygon points="4,2 12,7 4,12" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg></button>
              <span class="cd-lang" id="codeLang">Rust</span>
            </div>
            <div class="cd-view" id="codeViewer"><span class="cd-ln">1<br>2<br>3<br>4<br>5<br>6<br>7</span><span class="kw">fn</span> <span class="fn">main</span>() {<br>    <span class="fn">println!</span>(<span class="hl">"Hello, NeoTrix!"</span>);<br>    <span class="kw">let</span> engine = ReasoningEngine::new();<br>    engine.run();<br>}</div>
          </div>
        </div>
      </div>

      <!-- ═══ VIEW: 代理 (Agent) — 代理管理仪表盘 + 世界地图 + 节点表 ═══ -->
      <div class="vw-agent" id="viewAgent">
        <div class="px">

          <!-- Hero Card with Chain Viz -->
          <div class="px-hero">
            <div class="px-hleft">
              <div class="px-ring" id="pxRing">
                <svg viewBox="0 0 60 60"><circle cx="30" cy="30" r="26" fill="none" stroke="var(--bd2)" stroke-width="4"/><circle cx="30" cy="30" r="26" fill="none" stroke="var(--suc)" stroke-width="4" stroke-dasharray="163" stroke-dashoffset="24" id="pxRingArc" stroke-linecap="round" transform="rotate(-90,30,30)"/></svg>
                <span class="px-ring-txt" id="pxRingTxt">98%</span>
              </div>
              <div>
                <div class="px-htitle">代理管理</div>
                <div class="px-hstatus" id="pxHstatus"><span class="px-pulse on"></span> 运行中</div>
                <div class="px-hmeta" id="pxHmeta">24 节点 · 3 订阅 · 地理模式</div>
              </div>
            </div>
            <div class="px-hright">
              <!-- Chain Viz -->
              <div class="px-chain" id="pxChainViz">
                <div class="px-clink"><span class="px-cldot on" id="chain0"></span><span class="px-clabel">App</span></div>
                <div class="px-cline on" id="chainL0"></div>
                <div class="px-clink"><span class="px-cldot on" id="chain1"></span><span class="px-clabel">本地</span></div>
                <div class="px-cline on" id="chainL1"></div>
                <div class="px-clink"><span class="px-cldot on" id="chain2"></span><span class="px-clabel">ISP</span></div>
                <div class="px-cline on" id="chainL2"></div>
                <div class="px-clink"><span class="px-cldot on" id="chain3"></span><span class="px-clabel">节点</span></div>
                <div class="px-cline on" id="chainL3"></div>
                <div class="px-clink"><span class="px-cldot on" id="chain4"></span><span class="px-clabel">目标</span></div>
              </div>
              <button class="px-btn" id="pxStartBtn" onclick="toggleProxyDaemon()">⛔ 停止</button>
              <button class="px-btn" onclick="showToast('配置面板')">配置</button>
            </div>
          </div>

          <!-- Tab Navigation -->
          <div class="px-tabbar">
            <button class="px-tab-btn on" data-pxtab="overview" onclick="switchPxTab(this,'overview')">📊 概览</button>
            <button class="px-tab-btn" data-pxtab="map" onclick="switchPxTab(this,'map')">🗺 地图</button>
            <button class="px-tab-btn" data-pxtab="nodes" onclick="switchPxTab(this,'nodes')">🔌 节点</button>
            <button class="px-tab-btn" data-pxtab="subs" onclick="switchPxTab(this,'subs')">📋 订阅</button>
            <button class="px-tab-btn" data-pxtab="settings" onclick="switchPxTab(this,'settings')">⚙️ 设置</button>
          </div>

          <!-- ═══ Tab: Overview (existing gateway dashboard) ═══ -->
          <div class="px-tab-pane open" id="pxTabOverview">
            <div class="px-grid-2">
              <div class="px-card">
                <div class="px-cicon"><svg viewBox="0 0 16 16"><rect x="2" y="2" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.2" fill="none"/><line x1="2" y1="7" x2="14" y2="7" stroke="currentColor" stroke-width="1.2"/><line x1="8" y1="2" x2="8" y2="14" stroke="currentColor" stroke-width="1.2"/></svg></div>
                <span class="px-clabel">断路器</span>
                <span class="px-cval" id="pxCb">已关闭 · 5/5</span>
              </div>
              <div class="px-card">
                <div class="px-cicon"><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.2" fill="none"/><line x1="8" y1="8" x2="8" y2="4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="8" y1="8" x2="11" y2="9.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></div>
                <span class="px-clabel">速率限制</span>
                <span class="px-cval" id="pxRl">4.2K / 10K 请求/分钟</span>
              </div>
              <div class="px-card">
                <div class="px-cicon"><svg viewBox="0 0 16 16"><circle cx="8" cy="5" r="3" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M2 14a6 6 0 0112 0" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg></div>
                <span class="px-clabel">认证</span>
                <span class="px-cval">API Key · OAuth 2.1</span>
              </div>
              <div class="px-card">
                <div class="px-cicon"><svg viewBox="0 0 16 16"><polyline points="4,9 8,13 12,9" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><polyline points="4,3 8,7 12,3" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                <span class="px-clabel">故障转移</span>
                <span class="px-cval" id="pxFailover">3 次重试 · 激进策略</span>
              </div>
            </div>

            <div class="px-section">
              <div class="px-shead">
                <span>🌐 IP 代理池</span>
                <span class="px-smeta" id="pxIpMeta">12 代理 · 8 在线</span>
              </div>
              <div class="px-clist" id="pxIpTable"></div>
            </div>

            <div class="px-section">
              <div class="px-shead">
                <span>🆓 免费 LLM 提供者池</span>
                <span class="px-smeta" id="pxLlmMeta">6 提供者 · 5 健康</span>
              </div>
              <div class="px-clist" id="pxLlmTable"></div>
            </div>

            <div class="px-section">
              <div class="px-shead">
                <span>🔗 网络链路状态</span>
                <span class="px-smeta" id="pxNetMeta">5 正常 · 1 降级</span>
              </div>
              <div class="px-links" id="pxLinks"></div>
            </div>
          </div>

          <!-- ═══ Tab: World Map ═══ -->
          <div class="px-tab-pane" id="pxTabMap">
            <div class="px-map-wrap">
              <svg viewBox="0 0 600 300" id="pxWorldMapSvg">
                <defs>
                  <radialGradient id="pxNodeGlow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="var(--pri)" stop-opacity="0.35" />
                    <stop offset="100%" stop-color="var(--pri)" stop-opacity="0" />
                  </radialGradient>
                </defs>
                <rect x="0" y="0" width="600" height="300" fill="var(--ghost)" rx="6" />
                <g id="pxMapGrid"></g>
                <g id="pxMapContinents"></g>
                <g id="pxMapConnLines"></g>
                <g id="pxMapNodeDots"></g>
              </svg>
              <div class="px-map-legend">
                <span><span class="px-map-dot" style="background:var(--suc)"></span> 快速 (&lt;200ms)</span>
                <span><span class="px-map-dot" style="background:var(--yellow)"></span> 中等 (&lt;500ms)</span>
                <span><span class="px-map-dot" style="background:var(--des)"></span> 慢速</span>
                <span><span class="px-map-dot" style="background:var(--tx3)"></span> 离线</span>
              </div>
            </div>
          </div>

          <!-- ═══ Tab: Nodes ═══ -->
          <div class="px-tab-pane" id="pxTabNodes">
            <div class="px-section">
              <div class="px-shead">
                <span>代理节点 (<span id="pxNodeCount">0</span>)</span>
                <button class="px-btn" onclick="triggerNodeFetch()">🔄 拉取</button>
              </div>
              <div style="padding:8px 10px">
                <div class="px-healthbar" id="pxHealthBar"></div>
                <div class="px-hblegend" id="pxHealthLegend"></div>
                <div class="px-nthead">
                  <span class="col-speed"></span>
                  <span class="col-tag">标签</span>
                  <span class="col-latency">延迟</span>
                  <span>地区</span>
                  <span class="col-score">评分</span>
                  <span class="col-sf">成功/失败</span>
                  <span class="col-status">状态</span>
                </div>
                <div id="pxNodeList"></div>
              </div>
            </div>
          </div>

          <!-- ═══ Tab: Subscriptions ═══ -->
          <div class="px-tab-pane" id="pxTabSubs">
            <div class="px-section">
              <div class="px-shead">
                <span>订阅地址 (<span id="pxSubCount">0</span>)</span>
                <button class="px-btn" onclick="fetchAllSubs()">🔄 全部拉取</button>
              </div>
              <div style="padding:10px">
                <div class="px-sub-row">
                  <input class="px-sub-input" id="pxSubInput" placeholder="https://example.com/subscribe?token=..." onkeydown="if(event.key==='Enter')addSubscription()" />
                  <button class="px-btn" onclick="addSubscription()">添加</button>
                </div>
                <div class="px-sub-list" id="pxSubList">
                  <div style="font-size:var(--fs-caption);color:var(--tx3);padding:8px">暂无订阅。输入上方 URL 添加。</div>
                </div>
              </div>
            </div>
          </div>

          <!-- ═══ Tab: Settings ═══ -->
          <div class="px-tab-pane" id="pxTabSettings">
            <div class="px-section">
              <div class="px-shead"><span>代理配置</span></div>
              <div style="padding:12px">
                <div class="px-cfg-grid">
                  <div class="px-cfg-row"><label>本地端口</label><input type="number" id="cfgLocalPort" value="11080" /></div>
                  <div class="px-cfg-row"><label>SOCKS 端口</label><input type="number" id="cfgSocksPort" value="9050" /></div>
                  <div class="px-cfg-row"><label>最小节点数</label><input type="number" id="cfgMinNodes" value="5" /></div>
                  <div class="px-cfg-row"><label>健康检查</label><input type="number" id="cfgHealthInterval" value="60" /><span style="font-size:var(--fs-caption);color:var(--tx3)">秒</span></div>
                  <div class="px-cfg-row"><label>选择策略</label>
                    <select id="cfgStrategy">
                      <option value="auto">自动</option>
                      <option value="fastest">最快</option>
                      <option value="least_latency">最低延迟</option>
                      <option value="weighted_random">加权随机</option>
                      <option value="round_robin">轮询</option>
                    </select>
                  </div>
                  <div class="px-cfg-row"><label>直连超时</label><input type="number" id="cfgDirectTimeout" value="3" /><span style="font-size:var(--fs-caption);color:var(--tx3)">秒</span></div>
                  <div class="px-cfg-row">
                    <label>系统代理</label>
                    <div class="px-cfg-toggle">
                      <input type="checkbox" id="cfgSystemProxy" checked onchange="document.getElementById('cfgSysProxyLabel').textContent=this.checked?'已启用':'已禁用'" />
                      <span id="cfgSysProxyLabel">已启用</span>
                    </div>
                  </div>
                  <div class="px-submit-row"><button class="px-btn" onclick="saveProxyConfig()">保存配置</button></div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- ═══ OVERLAY: 能力注册表 ═══ -->
<div class="overlay-panel" id="overlayRegistry">
  <div class="overlay-box">
    <div class="overlay-h">
      <h2>能力注册表</h2>
      <div class="tlg-close">
        <span class="tlg-dot tlg-r" onclick="closeOverlay('overlayRegistry')" title="关闭"></span>
        <span class="tlg-dot tlg-y" onclick="showToast('需求分析中')" title="最小化"></span>
        <span class="tlg-dot tlg-g" onclick="showToast('需求分析中')" title="最大化"></span>
      </div>
    </div>
    <div class="overlay-bd">
      <div class="lbl" style="font-size:var(--fs-caption);font-weight:var(--fw-semibold);text-transform:uppercase;letter-spacing:0.5px;color:var(--tx-meta);margin-bottom:8px">L7 Capability Registry · 22 维</div>
      <div style="display:flex;flex-direction:column;gap:3px">
        <div class="pipeline-item"><span class="s">代码生成</span><span class="st ok">Mature 6</span></div>
        <div class="pipeline-item"><span class="s">知识吸收</span><span class="st ok">Mature 5</span></div>
        <div class="pipeline-item"><span class="s">E8 推理</span><span class="st run">Mature 4</span></div>
        <div class="pipeline-item"><span class="s">SEAL 循环</span><span class="st run">Mature 3</span></div>
        <div class="pipeline-item"><span class="s">工具调用</span><span class="st ok">Mature 5</span></div>
        <div class="pipeline-item"><span class="s">记忆检索</span><span class="st ok">Mature 6</span></div>
        <div class="pipeline-item"><span class="s">元认知监控</span><span class="st run">Mature 2</span></div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ OVERLAY: 超立方体 ═══ -->
<div class="overlay-panel" id="overlayHypercube">
  <div class="overlay-box">
    <div class="overlay-h">
      <h2>知识超立方体</h2>
      <div class="tlg-close">
        <span class="tlg-dot tlg-r" onclick="closeOverlay('overlayHypercube')" title="关闭"></span>
        <span class="tlg-dot tlg-y" onclick="showToast('需求分析中')" title="最小化"></span>
        <span class="tlg-dot tlg-g" onclick="showToast('需求分析中')" title="最大化"></span>
      </div>
    </div>
    <div class="overlay-bd">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div class="evo-card"><div class="lbl">总节点</div><div class="val">1,247</div></div>
        <div class="evo-card"><div class="lbl">基础种子</div><div class="val">88</div></div>
        <div class="evo-card"><div class="lbl">关系边</div><div class="val">4,382</div></div>
        <div class="evo-card"><div class="lbl">VSA 维度</div><div class="val">D=2048</div></div>
      </div>
      <div style="margin-top:12px">
        <div class="lbl" style="font-size:var(--fs-caption);font-weight:var(--fw-semibold);text-transform:uppercase;letter-spacing:0.5px;color:var(--tx-meta);margin-bottom:6px">最近写入</div>
        <div class="pipeline-item"><span class="s">E8 Grounding 状态记录</span><span class="st ok">2m ago</span></div>
        <div class="pipeline-item"><span class="s">CapabilityVector 更新</span><span class="st ok">5m ago</span></div>
        <div class="pipeline-item"><span class="s">SEAL Epoch 7 摘要</span><span class="st ok">12m ago</span></div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ OVERLAY: 项目/成果/历史 通用面板 ═══ -->
<div class="overlay-panel" id="overlayProjects">
  <div class="overlay-box" style="max-width:420px">
    <div class="overlay-h">
      <h2 id="opTitle"></h2>
      <div class="tlg-close">
        <span class="tlg-dot tlg-r" onclick="closeOverlay('overlayProjects')" title="关闭"></span>
      </div>
    </div>
    <div class="overlay-bd" id="opBody"></div>
  </div>
</div>

<!-- ═══ OVERLAY: 设置面板 ═══ -->
<div class="overlay-panel" id="overlaySettings">
  <div class="st-modal">
    <div class="st-sidebar">
      <div class="st-search">
        <svg viewBox="0 0 14 14"><circle cx="6" cy="6" r="4" stroke="currentColor" stroke-width="1.2" fill="none"/><line x1="9.5" y1="9.5" x2="13" y2="13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <input type="text" placeholder="搜索设置" />
        <span class="st-kbd">⌘K</span>
      </div>
      <div class="st-nav">
        <div class="st-grp">通用</div>
        <div class="st-item on" onclick="selectSetting(this,'profile')">
          <svg viewBox="0 0 14 14"><circle cx="7" cy="4.5" r="3" stroke="currentColor" stroke-width="1" fill="none"/><path d="M2 13a5 5 0 0110 0" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round"/></svg>个人资料
        </div>
        <div class="st-item" onclick="selectSetting(this,'appearance')">
          <svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1" fill="none"/><line x1="7" y1="2" x2="7" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="7" y1="10" x2="7" y2="12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="2" y1="7" x2="4" y2="7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="10" y1="7" x2="12" y2="7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>外观
        </div>
        <div class="st-item" onclick="selectSetting(this,'speech')">
          <svg viewBox="0 0 14 14"><line x1="4" y1="3" x2="4" y2="11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="7" y1="1" x2="7" y2="13" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="10" y1="4" x2="10" y2="10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>语音
        </div>
        <div class="st-item" onclick="selectSetting(this,'compute')">
          <svg viewBox="0 0 14 14"><rect x="2" y="2" width="10" height="10" rx="1.5" stroke="currentColor" stroke-width="1" fill="none"/><circle cx="7" cy="7" r="1.5" stroke="currentColor" stroke-width="1" fill="none"/></svg>计算资源
        </div>
        <div class="st-grp">账户</div>
        <div class="st-item" onclick="selectSetting(this,'limits')">
          <svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1" fill="none"/><line x1="7" y1="4" x2="7" y2="8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><circle cx="7" cy="10" r=".4" fill="currentColor"/></svg>账户限制
        </div>
        <div class="st-item" onclick="selectSetting(this,'billing')">
          <svg viewBox="0 0 14 14"><rect x="1.5" y="4.5" width="11" height="7" rx="1.5" stroke="currentColor" stroke-width="1" fill="none"/><circle cx="7" cy="8" r="1.5" stroke="currentColor" stroke-width="1" fill="none"/><line x1="4" y1="4.5" x2="4" y2="3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="10" y1="4.5" x2="10" y2="3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>账单
        </div>
        <div class="st-item" onclick="selectSetting(this,'privacy')">
          <svg viewBox="0 0 14 14"><rect x="2.5" y="6" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="1" fill="none"/><path d="M4.5 6V4a2.5 2.5 0 015 0v2" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>隐私
        </div>
        <div class="st-item" onclick="selectSetting(this,'data')">
          <svg viewBox="0 0 14 14"><ellipse cx="7" cy="4" rx="4.5" ry="2" stroke="currentColor" stroke-width="1" fill="none"/><path d="M2.5 4v2.5c0 1.1 2 2 4.5 2s4.5-.9 4.5-2V4" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round"/><path d="M2.5 6.5V9c0 1.1 2 2 4.5 2s4.5-.9 4.5-2V6.5" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round"/></svg>数据控制
        </div>
        <div class="st-grp">连接</div>
        <div class="st-item" onclick="selectSetting(this,'channels')">
          <svg viewBox="0 0 14 14"><path d="M2 4.5h10a1 1 0 011 1v3a1 1 0 01-1 1H2a1 1 0 01-1-1v-3a1 1 0 011-1z" stroke="currentColor" stroke-width="1" fill="none"/><line x1="2" y1="8.5" x2="3" y2="8.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="4.5" y1="8.5" x2="5.5" y2="8.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>频道
        </div>
      </div>
    </div>
    <div class="st-content">
      <div class="st-top">
        <span class="st-title">设置</span>
        <div class="tlg-close">
          <span class="tlg-dot tlg-r" onclick="closeOverlay('overlaySettings')" title="关闭"></span>
          <span class="tlg-dot tlg-y" onclick="showToast('需求分析中')" title="最小化"></span>
          <span class="tlg-dot tlg-g" onclick="showToast('需求分析中')" title="最大化"></span>
        </div>
      </div>
      <div class="st-body">

        <!-- 个人资料 -->
        <div class="st-section" id="stProfile">
          <h2 class="st-h2">个人资料</h2>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">头像</div>
                <div class="st-desc">代表你的账户头像</div>
              </div>
              <div class="st-av">N</div>
            </div>
          </div>
          <div class="st-field">
            <label class="st-lbl">全名</label>
            <input type="text" class="st-input" value="neotrix" />
          </div>
          <div class="st-field">
            <label class="st-lbl">显示名称</label>
            <input type="text" class="st-input" value="neotrix" />
          </div>
          <div class="st-field">
            <label class="st-lbl">工作角色</label>
            <select class="st-input"><option>其他</option><option>开发者</option><option>设计师</option><option>研究员</option></select>
          </div>
        </div>

        <!-- 外观 -->
        <div class="st-section" id="stAppearance" style="display:none">
          <h2 class="st-h2">外观</h2>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">主题模式</div>
                <div class="st-desc">切换亮色 / 暗色界面</div>
              </div>
              <button class="st-toggle" onclick="toggleTheme()" style="padding:4px 14px;border-radius:8px;border:1px solid var(--bd);background:var(--ghost);color:var(--tx2);font-size:var(--fs-small);cursor:pointer;font-family:var(--ff);transition:var(--tr)">切换主题</button>
            </div>
          </div>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">字体大小</div>
                <div class="st-desc">调整界面文字尺寸</div>
              </div>
              <select class="st-input" style="width:100px"><option>小</option><option selected>中</option><option>大</option></select>
            </div>
          </div>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">减少透明效果</div>
                <div class="st-desc">降低毛玻璃透明度以提升可读性</div>
              </div>
              <label class="st-switch"><input type="checkbox" /></label>
            </div>
          </div>
        </div>

        <!-- 语音 -->
        <div class="st-section" id="stSpeech" style="display:none">
          <h2 class="st-h2">语音</h2>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">语音输入</div>
                <div class="st-desc">启用麦克风进行语音对话</div>
              </div>
              <label class="st-switch"><input type="checkbox" checked /></label>
            </div>
          </div>
          <div class="st-field">
            <label class="st-lbl">输入语言</label>
            <select class="st-input"><option>中文（简体）</option><option>English</option><option>日本語</option></select>
          </div>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">自动发送</div>
                <div class="st-desc">语音识别完成后自动发送消息</div>
              </div>
              <label class="st-switch"><input type="checkbox" /></label>
            </div>
          </div>
        </div>

        <!-- 计算资源 -->
        <div class="st-section" id="stCompute" style="display:none">
          <h2 class="st-h2">计算资源</h2>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">本地推理引擎</div>
                <div class="st-desc">使用 ANE / GPU 加速本地模型推理</div>
              </div>
              <label class="st-switch"><input type="checkbox" /></label>
            </div>
          </div>
          <div class="st-field">
            <label class="st-lbl">默认提供者</label>
            <select class="st-input"><option>GatewayV2（自动）</option><option>OpenAI</option><option>Anthropic</option><option>Groq（免费）</option></select>
          </div>
          <div class="st-field">
            <label class="st-lbl">最大 Token</label>
            <select class="st-input"><option>4096</option><option selected>8192</option><option>16384</option><option>32768</option></select>
          </div>
        </div>

        <!-- 账户限制 -->
        <div class="st-section" id="stLimits" style="display:none">
          <h2 class="st-h2">账户限制</h2>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">计划类型</div>
                <div class="st-desc">当前使用的服务计划</div>
              </div>
              <span style="font-size:var(--fs-small);font-weight:var(--fw-semibold);color:var(--suc);padding:3px 10px;border-radius:20px;background:rgba(76,175,80,0.1)">免费</span>
            </div>
          </div>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">每日请求</div>
                <div class="st-desc">已用 42 / 200 次</div>
              </div>
              <div class="gbar" style="width:80px"><div class="gbar-f" style="width:21%;background:var(--suc)"></div></div>
            </div>
          </div>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">速率限制</div>
                <div class="st-desc">请求/分钟 18/30 · 令牌/分钟 45K/100K</div>
              </div>
            </div>
          </div>
        </div>

        <!-- 账单 -->
        <div class="st-section" id="stBilling" style="display:none">
          <h2 class="st-h2">账单</h2>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">本月用量</div>
                <div class="st-desc">免费计划 · 无需付费</div>
              </div>
              <span style="font-size:var(--fs-body);font-weight:var(--fw-semibold);color:var(--suc)">¥0.00</span>
            </div>
          </div>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">升级至 Pro</div>
                <div class="st-desc">解锁无限请求、优先队列、高级模型</div>
              </div>
              <button style="padding:5px 16px;border-radius:8px;border:none;background:var(--tx);color:var(--bg-base);font-size:var(--fs-small);cursor:pointer;font-family:var(--ff);font-weight:var(--fw-medium)">了解详情</button>
            </div>
          </div>
        </div>

        <!-- 隐私 -->
        <div class="st-section" id="stPrivacy" style="display:none">
          <h2 class="st-h2">隐私</h2>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">对话存储</div>
                <div class="st-desc">在本地保存对话历史用于检索</div>
              </div>
              <label class="st-switch"><input type="checkbox" checked /></label>
            </div>
          </div>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">使用数据</div>
                <div class="st-desc">匿名化使用数据帮助改进产品</div>
              </div>
              <label class="st-switch"><input type="checkbox" /></label>
            </div>
          </div>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">本地处理</div>
                <div class="st-desc">优先使用本地推理引擎保护隐私</div>
              </div>
              <label class="st-switch"><input type="checkbox" checked /></label>
            </div>
          </div>
        </div>

        <!-- 数据控制 -->
        <div class="st-section" id="stData" style="display:none">
          <h2 class="st-h2">数据控制</h2>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">知识库</div>
                <div class="st-desc">SQLite · ~/.neotrix/knowledge.db · 1,247 节点</div>
              </div>
            </div>
          </div>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">导出数据</div>
                <div class="st-desc">下载所有对话、知识库和配置</div>
              </div>
              <button style="padding:5px 14px;border-radius:8px;border:1px solid var(--bd);background:var(--ghost);color:var(--tx2);font-size:var(--fs-small);cursor:pointer;font-family:var(--ff);transition:var(--tr)">导出</button>
            </div>
          </div>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">清除数据</div>
                <div class="st-desc">删除所有本地数据（不可恢复）</div>
              </div>
              <button style="padding:5px 14px;border-radius:8px;border:1px solid var(--des);background:rgba(232,84,84,0.08);color:var(--des);font-size:var(--fs-small);cursor:pointer;font-family:var(--ff);transition:var(--tr)">清除</button>
            </div>
          </div>
        </div>

        <!-- 频道 (Channels) -->
        <div class="st-section" id="stChannels" style="display:none">
          <h2 class="st-h2">频道</h2>
          <p style="font-size:var(--fs-caption);color:var(--tx3);margin:0 0 12px 0;line-height:1.6">连接社交平台 Bot，自动接收并响应消息。支持 Telegram、WeChat、WhatsApp、Discord、Slack、飞书。</p>
          <div class="st-card" style="padding:0">
            <div class="st-card-info" style="padding:8px 16px;border-bottom:1px solid var(--bd);font-size:var(--fs-small);color:var(--tx2);font-weight:var(--fw-medium)">已配置频道 <span style="float:right;font-weight:var(--fw-regular);color:var(--tx3);font-size:var(--fs-caption)" id="stChanCount">0 个</span></div>
            <div id="stChannelList"></div>
          </div>
          <div id="stChannelDetail" style="display:none;margin-top:10px"></div>
        </div>

      </div>
    </div>
  </div>
</div>

    </main>

    <!-- ═══ RIGHT SIDEBAR — File Tree + Agent Trace ═══ -->
    <aside class="rb" id="rightbar" onmouseenter="openRbSidebar()" onmouseleave="onRbLeave()">
      <button class="rb-float" id="rbFloat" onclick="toggleRbSidebar()" title="切换侧栏">
        <svg id="rbFloatIcon" viewBox="0 0 8 8"><line x1="5" y1="2" x2="3" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="5" y1="6" x2="3" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
      </button>
      <div class="rb-content">
        <!-- Artifact Pane (top) -->
        <div class="ap mini" id="filePreview" onclick="expandPreview(event)">
          <div class="ap-bar">
            <div class="ap-bar-left">
              <button class="ap-view-btn on" data-view="preview" onclick="switchArtifactView(this,'preview')" title="Preview">
                <svg viewBox="0 0 14 14"><path d="M1.5 7s2.5-4.5 5.5-4.5S12.5 7 12.5 7s-2.5 4.5-5.5 4.5S1.5 7 1.5 7z" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/><circle cx="7" cy="7" r="2" stroke="currentColor" stroke-width="1.2" fill="none"/></svg>
              </button>
              <button class="ap-view-btn" data-view="code" onclick="switchArtifactView(this,'code')" title="Code">
                <svg viewBox="0 0 14 14"><polyline points="4,4 1.5,7 4,10" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><polyline points="10,4 12.5,7 10,10" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><line x1="8.5" y1="3.5" x2="5.5" y2="10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              </button>
            </div>
            <span class="ap-title" id="fpName">未选择文件</span>
          </div>
          <div class="ap-tabs" id="fpFmt"></div>
          <div class="ap-body" id="fpBody">
            <div class="ap-content" id="fpContent">
              <span class="cm">// 点击文件预览</span>
            </div>
          </div>
          <div class="ap-footer">
            <button class="ap-action" onclick="copyPreview(event)" title="Copy">
              <svg viewBox="0 0 12 12"><rect x="3" y="1.5" width="7.5" height="9" rx="1" stroke="currentColor" stroke-width="1.1" fill="none"/><path d="M1.5 4v6.5a1 1 0 001 1H9" stroke="currentColor" stroke-width="1.1" fill="none"/></svg>
              <span>复制</span>
            </button>
            <button class="ap-action" onclick="refreshPreview(event)" title="Refresh">
              <svg viewBox="0 0 12 12"><path d="M1.5 6A4.5 4.5 0 016 1.5 4.5 4.5 0 0110.5 6" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/><polyline points="9,4.5 10.5,6 9,7.5" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>刷新</span>
            </button>
            <button class="ap-action" onclick="expandPreview(event)" title="Expand">
              <svg viewBox="0 0 12 12"><polyline points="2,4.5 2,10 7.5,10" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><polyline points="10,7.5 10,2 4.5,2" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>展开</span>
            </button>
            <button class="ap-action" onclick="closePreview(event)" title="Close">
              <svg viewBox="0 0 12 12"><line x1="3" y1="3" x2="9" y2="9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="9" y1="3" x2="3" y2="9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              <span>关闭</span>
            </button>
          </div>
        </div>
        <!-- File Tree (below artifact pane) -->
        <div class="ft" id="fileTree"></div>
      </div>
    </aside>

  </div>
</div>

<!-- ═══ FLOATING DESKTOP PET ═══ -->
<div id="neoPet" class="float">
  <div class="pet-tooltip">neo · Lv.1</div>
  <canvas id="petCanvas" width="320" height="400"></canvas>
</div>

<script>
  /* ════════════════════════════════════════════════════════════
     BACKEND API FLOW PER TAB

     ── Tab 1: 对话 (Chat) ──────────────────────────────────────
     User Input → `invoke("agent_reason", { prompt, session_id })`
       → ReasoningEngine.reason()
         → GatewayV2.complete_with_selection()
           → CircuitBreaker (nt_core_cb): CLOSED/HALF_OPEN check
           → RateLimiter (nt_core_rl): RPM + TPM token buckets
           → ProviderPool.select(): composite score S = s²/lat × cost × health
             → Free provider (Groq/OpenRouter/Pollinations)
             → Fallback chain: primary → 2 retries → aggressive all-providers
         → Streaming tokens via `listen("streaming-token")`
           → UI: append token to .mb in chat scroll
       → core_review() records ConversationRecord → KB (nt_memory_kb)
       → ConversationDistillStage (every 3 ticks) → EvolutionRecord

     ── Tab 2: 团队 (Cowork) ────────────────────────────────────
     `invoke("cmd_session_list")` → SessionManager.list_sessions()
     `invoke("cmd_session_create", { name })` → SessionManager.create(name)
     `invoke("cmd_session_switch", { id })` → SessionManager.activate(id)
     Task Dispatch → AgentTeam.execute() (nt_act_orch_patterns)
       → Supervisor pattern: Orchestrator → Worker[1..N] → Gate
       → Swarm pattern: parallel agent broadcast → collect
       → Pipeline pattern: ChainRefine sequential stages
     Inter-agent → AgentBus.publish() / subscribe() (nt_cap_orch_handoff)
     UI Polling → `poll("cmd_cowork_status")` every 2s → update progress bars

     ── Tab 3: 代码 (Code) ──────────────────────────────────────
     File Tree → `invoke("read_dir_recursive", { path })` → render .ft
     File Open  → `invoke("read_file", { path })` → .ap artifact pane
     File Save  → `invoke("write_file", { path, content })` → confirm
     Agent Session:
       `invoke("cmd_agent_start", { task })` → spawn background agent
       `invoke("cmd_agent_stop", { id })` → kill
       `invoke("cmd_agent_status", { id })` → poll step + token progress
     Git Status → `invoke("cmd_git_status")` → branch/diff indicators

     ── Tab 4: 代理 (Agent/Proxy) ───────────────────────────────
      Proxy Dashboard: hero ring + chain viz + daemon controls
        Tab overview: stat grid (circuit breaker, rate limiter, etc.)
                     + IP Pool (12 proxy entries with latency bars)
                     + Free LLM Providers (6 providers with scores)
                     + Network Links (6 system links with status)
        Tab map: SVG world map (5 continent paths + 20+ geo points
                 + node dots with health color + connection lines)
        Tab nodes: node table (24 entries with health bar distribution)
        Tab subscriptions: URL input + list with add/remove
        Tab settings: port config + strategy select + system proxy toggle

      Backend (when daemon connected):
        `invoke("proxy_status")` → daemon PID/port/uptime/mode
        `invoke("proxy_set_mode")` → off/geo/stealth/tor
        `invoke("proxy_source_status")` → source health
        `invoke("proxy_pool_nodes")` → node list with latency/score
        `invoke("proxy_sub_list/add/remove")` → subscription CRUD
        `invoke("proxy_config_get/set")` → config persistence

      Agent/Gateway (L7 Capability):
        E8 State Machine (L4) → `invoke("e8_get_state")` every 500ms
       → nt_core_e8::E8StateMachine { Ground/Receptive/Arousal/… }
       → Hexagram → nt_core_e8::to_hexagram()
     SAE Features (L4) → `invoke("sae_get_active_latents")`
       → nt_core_sae::SparseAutoencoder.forward() → top-K features
     GWT Resonance (L5) → `invoke("gwt_resonance_status")`
       → nt_core_gwt::ResonatorNetwork → active resonator count
     StarPulse Protocol (L7) → `invoke("starpulse_bus_status")`
       → l7_capability::protocol::PulseBus → queued messages
     Capability Bid (L7) → `invoke("cap_registry_bids")`
       → l7_capability::registry → bid scores per capability
     MCP Tools (L1) → `invoke("mcp_tool_status")`
       → nt_agent_mcp_discovery → tool health + latency

     ALL TABS share:
     - GatewayV2 for LLM completion
     - nt_memory_kb for context retrieval
     - nt_io_telemetry for span tracing (future)
     ════════════════════════════════════════════════════════════ */
  /* ===== Icon Library ===== */
  const I = {
    plus: '<svg viewBox="0 0 14 14"><path d="M7 1.5l1.2 3.8 3.8 1.2-3.8 1.2L7 11.5l-1.2-3.8L2 6.5l3.8-1.2z" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linejoin="round"/></svg>',
    folder: '<svg viewBox="0 0 14 14"><path d="M1.5 4.5h3.5l1-1.5h6a1 1 0 011 1v6a1 1 0 01-1 1h-10a1 1 0 01-1-1v-5.5z" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    play: '<svg viewBox="0 0 14 14"><polygon points="3.5,2 11.5,7 3.5,12" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><circle cx="3.5" cy="7" r="1.2" fill="currentColor" stroke="none" opacity="0.3"/></svg>',
    clock: '<svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.2" fill="none"/><line x1="7" y1="7" x2="7" y2="4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="7" y1="7" x2="9.5" y2="8.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>',
    grid: '<svg viewBox="0 0 14 14"><path d="M3.5 2l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2L1 5l2.2-.8z" stroke="currentColor" stroke-width="1" fill="none" stroke-linejoin="round"/><path d="M10.5 8l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z" stroke="currentColor" stroke-width="1" fill="none" stroke-linejoin="round"/></svg>',
    sliders: '<svg viewBox="0 0 14 14"><line x1="2" y1="4" x2="12" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M4 3.5l.5 1.5h-1z" stroke="currentColor" stroke-width="1" fill="none"/><line x1="2" y1="9" x2="12" y2="9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M10 8.5l.5 1.5h-1z" stroke="currentColor" stroke-width="1" fill="none"/></svg>',
    playAlt: '<svg viewBox="0 0 14 14"><polygon points="3,2 12,7 3,12" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    search: '<svg viewBox="0 0 14 14"><circle cx="6" cy="6" r="3.5" stroke="currentColor" stroke-width="1.2" fill="none"/><line x1="9" y1="9" x2="12.5" y2="12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>',
