    },
  };

  let currentPersona = 'researcher';

  function setPersona(name) {
    if (!PERSONAS[name]) return;
    currentPersona = name;
    const p = PERSONAS[name];
    petEl.style.setProperty('--pet-accent', p.color);
    EVO_COLORS[0] = blendColor(EVO_COLORS[0], p.color, 0.3);
    updatePetTooltip();
    showToast(`${p.emoji} 切换至「${p.name}」人格 · ${p.desc}`);
    // Trigger mood expression based on persona
    pet.mood = p.traits.creativity > 0.8 ? 'excited' : 'happy';
    setTimeout(() => { pet.mood = 'neutral'; }, 2000);
  }

  function blendColor(c1, c2, t) {
    const a = hexToRgb(c1), b = hexToRgb(c2);
    const r = Math.round(a.r + (b.r - a.r) * t);
    const g = Math.round(a.g + (b.g - a.g) * t);
    const bl = Math.round(a.b + (b.b - a.b) * t);
    return `rgb(${r},${g},${bl})`;
  }
  function hexToRgb(c) {
    const h = c.replace('#', '');
    return { r: parseInt(h.slice(0,2),16), g: parseInt(h.slice(2,4),16), b: parseInt(h.slice(4,6),16) };
  }

  // ── Persona UI: Right-click menu ──
  petCanvas.addEventListener('contextmenu', e => {
    e.preventDefault();
    const existing = document.querySelector('.pet-persona-menu');
    if (existing) existing.remove();

    const menu = document.createElement('div');
    menu.className = 'pet-persona-menu';
    Object.entries(PERSONAS).forEach(([key, p]) => {
      const item = document.createElement('div');
      item.className = 'ppm-item' + (key === currentPersona ? ' on' : '');
      item.innerHTML = `<span class="ppm-e">${p.emoji}</span><span class="ppm-n">${p.name}</span><span class="ppm-d">${p.desc}</span>`;
      item.onclick = () => { setPersona(key); menu.remove(); };
      menu.appendChild(item);
    });
    menu.style.cssText = `position:fixed;left:${e.clientX}px;top:${e.clientY}px;z-index:99999;background:var(--bg-card,#1e1e2e);border:1px solid var(--bd2,#333);border-radius:8px;padding:4px;min-width:160px;box-shadow:0 8px 32px rgba(0,0,0,0.4)`;
    document.body.appendChild(menu);
    document.addEventListener('click', () => menu.remove(), { once: true });
  });

  // ── Try connecting to backend (non-blocking) ──
  PetBridge.connect({
    onConnect: () => {
      console.log('[PetBridge] Connected to NeoTrix backend');
      pet.bridgeConnected = true;
      // Poll for E8 state
      setInterval(async () => {
        const state = await PetBridge.fetchE8State();
        if (state && state.hexagram !== undefined) {
          pet.e8Hexagram = state.hexagram;
          pet.e8Energy = state.energy || 0.5;
          // Adjust mood based on E8 energy
          if (state.energy > 0.7) pet.mood = 'excited';
          else if (state.energy > 0.4) pet.mood = 'happy';
        }
      }, 5000);
    },
    onDisconnect: () => {
      pet.bridgeConnected = false;
    }
  });

