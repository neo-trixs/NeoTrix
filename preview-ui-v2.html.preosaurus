  };

  // ── Cultivation State ──
  let cultState = {
    realmIdx: 1,
    progress: 35,
    selectedMeridian: 'ren',
    selectedAcupoint: null,
    insights: ['任脉已通 · 气血充盈', '督脉冲击中 · 三关渐开', '丹田气满 · 可合周天'],
    tick: 0,
  };

  // ── Load saved realm from localStorage ──
  function loadCultState() {
    try {
      const saved = localStorage.getItem('nt_cultivation');
      if (saved) {
        const parsed = JSON.parse(saved);
        Object.assign(cultState, parsed);
      }
    } catch(e) { /* ignore */ }
  }
  function saveCultState() {
    try {
      localStorage.setItem('nt_cultivation', JSON.stringify(cultState));
    } catch(e) { /* ignore */ }
  }
  loadCultState();

  function getCurrentRealm() {
    let r = REALMS[0];
    for (const realm of REALMS) {
      if (cultState.progress >= realm.pct) r = realm;
    }
    return r;
  }

  // ── 选择经脉 ──
  function selectMeridian(id) {
    cultState.selectedMeridian = id;
    cultState.selectedAcupoint = null;
    renderCultivationSidebar();
    updateCoworkDetail();
    saveCultState();
  }

  // ── 选择穴位 ──
  function selectAcupoint(id) {
    const pt = ACUPOINTS[id];
    if (!pt) return;
    cultState.selectedAcupoint = id;
    cultState.selectedMeridian = pt.meridian;
    renderCultivationSidebar();
    updateCoworkDetail();
    showToast(pt.name + ' · ' + pt.desc);
  }

  // ── 渲染经脉Sidebar ──
  function renderCultivationSidebar() {
    const navEl = document.getElementById('navList');
    if (!navEl) return;

    const realm = getCurrentRealm();
    const rIdx = REALMS.indexOf(realm);

    // Meridian channels in display order
    const order = ['ren','du','lung','heart','pericardium','stomach','liver','spleen','kidney','largeintestine','smallintestine','sanjiao','gallbladder','bladder'];
    const channelsHtml = order.map(id => {
      const m = MERIDIANS[id];
      if (!m) return '';
      const active = m.active;
      const on = id === cultState.selectedMeridian;
      // Determine activation level
      let cls = 'mw-ch';
      if (on) cls += ' on';
      if (active) cls += ' active';
      const dotColor = active ? m.color : 'var(--tx3)';
      return `<div class="${cls}" onclick="selectMeridian('${id}')">
        <span class="mw-ch-dot" style="background:${dotColor};${active ? 'box-shadow:0 0 4px '+m.color : ''}"></span>
        <span class="mw-ch-name">${m.name}</span>
        <span class="mw-ch-status">${active ? m.progress+'%' : '未通'}</span>
        <div class="mw-ch-prog"><div class="mw-ch-prog-fill" style="width:${active ? m.progress : 0}%"></div></div>
      </div>`;
    }).join('');

    // Selected meridian points
    const selId = cultState.selectedMeridian;
    const selM = MERIDIANS[selId];
    const ptsHtml = selM ? selM.points.map(pid => {
      const pt = ACUPOINTS[pid];
      if (!pt) return '';
      const sel = pid === cultState.selectedAcupoint;
      return `<span style="padding:2px 6px;border-radius:4px;background:${sel ? 'var(--accent-bg)' : 'var(--ghost)'};font-size:8px;color:${sel ? 'var(--pri)' : 'var(--tx2)'};cursor:pointer;transition:var(--tr)" onclick="selectAcupoint('${pid}')">${pt.name}</span>`;
    }).join('') : '';

    navEl.innerHTML = `<div class="mw">
      <div class="mw-header">
        <div class="mw-title"><svg viewBox="0 0 14 14"><path d="M7 1.5C4 3.5 2 7 7 12.5c5-5.5 3-9-2-11"/><circle cx="7" cy="7" r="1.5"/></svg>修炼 · 经脉</div>
        <div class="mw-sub">道藏核心功法 · ${selM ? selM.name : '任督'}为主脉</div>
      </div>
      <div class="mw-realm">
        <div class="mw-realm-top">
          <span class="mw-realm-name" style="color:${realm.color}">${realm.name}</span>
          <span class="mw-realm-pct">${cultState.progress}%</span>
        </div>
        <div class="mw-realm-bar"><div class="mw-realm-fill" style="width:${cultState.progress}%"></div></div>
        <div class="mw-realm-stars">${REALMS.map((r,i) => `<div class="mw-realm-star${i <= rIdx ? ' on' : ''}" title="${r.name}"></div>`).join('')}</div>
      </div>
      <div class="mw-channels">${channelsHtml}</div>
      <div class="mw-body-wrap">
        <svg class="mw-body" viewBox="0 0 100 120" id="meridianBody">
          <!-- body outline -->
          <ellipse class="body-outline" cx="50" cy="12" rx="7" ry="8"/>
          <path class="body-outline" d="M44,20 L42,24 L40,30 L38,38 L36,46 L34,54 L34,62 L36,70 L38,76 L40,80 M56,20 L58,24 L60,30 L62,38 L64,46 L64,54 L62,62 L60,70 L58,76 L56,80"/>
          <path class="body-outline" d="M40,80 L42,84 L36,92 L30,98 L26,102 M56,80 L54,84 L64,92 L70,98 L74,102"/>
          <path class="body-outline" d="M44,20 L38,22 L28,28 L20,36 L14,44 L10,52 M56,20 L62,22 L72,28 L80,36 L86,44 L90,52"/>
          <rect class="body-outline" x="44" y="20" width="12" height="22" rx="4"/>
          <rect class="body-outline" x="42" y="42" width="16" height="20" rx="3"/>
          <!-- dynamic meridians rendered by JS -->
          <g id="meridianPaths"></g>
          <!-- dynamic acupoints rendered by JS -->
          <g id="acupointGroup"></g>
        </svg>
      </div>
      <div class="mw-tech">
        <div class="mw-tech-top">
          <span class="mw-tech-name">小周天 · 任督循环${selM ? ' + '+selM.name : ''}</span>
          <span class="mw-tech-pct">${cultState.progress}%</span>
        </div>
        <div class="mw-tech-bar"><div class="mw-tech-fill" style="width:${cultState.progress}%"></div></div>
        <div class="mw-tech-info">${realm.desc} · ${selM ? selM.desc.slice(0,20)+'…' : ''}</div>
      </div>
    </div>`;

    const reEl = document.getElementById('recentList');
    if (reEl) {
      const insights = cultState.insights || [];
      reEl.innerHTML = '<div class="re-h">修炼感悟</div>' + insights.map(t =>
        `<div class="re-i ghost"><span class="circle"></span><span class="t">${escHtml(t)}</span></div>`
      ).join('');
    }

    // Render meridian SVG paths
    renderMeridianSVG();
  }

  // ── 渲染经脉SVG ──
  function renderMeridianSVG() {
    const container = document.getElementById('meridianPaths');
    const ptContainer = document.getElementById('acupointGroup');
    if (!container) return;

    const selId = cultState.selectedMeridian;
    const selM = MERIDIANS[selId];

    // Convert meridian path to SVG elements
    let pathsHtml = '';
    let pointsHtml = '';
    const viewBoxW = 100, viewBoxH = 120;

    for (const [id, m] of Object.entries(MERIDIANS)) {
      if (!m.path) continue;
      const active = m.active;
      const isSelected = id === selId;
      let cls = 'meridian dormant';
      if (isSelected) cls = 'meridian active';
      else if (active) cls = 'meridian idle';

      const opacity = isSelected ? 1 : (active ? 0.5 : 0.15);
      const strokeW = isSelected ? 2 : (active ? 0.8 : 0.3);
      const glow = isSelected ? `filter:drop-shadow(0 0 3px ${m.color})` : '';

      pathsHtml += `<path class="${cls}" d="${m.path}" stroke="${m.color}" stroke-width="${strokeW}" opacity="${opacity}" style="${glow}"/>`;
    }

    // Render acupoints
    for (const [id, pt] of Object.entries(ACUPOINTS)) {
      const isSelected = id === cultState.selectedAcupoint;
      const merActive = MERIDIANS[pt.meridian] && MERIDIANS[pt.meridian].active;
      const isActive = isSelected || (merActive && id === cultState.selectedAcupoint);
      let cls = 'acupoint dormant';
      if (isSelected) cls = 'acupoint selected';
      else if (isActive || merActive) cls = 'acupoint active';
      else if (cultState.progress > 10) cls = 'acupoint idle';

      const r = isSelected ? 4 : (isActive || merActive ? 2.5 : 1.2);
      const fill = isSelected ? '#fff' : (merActive ? '#FFD700' : 'var(--tx3)');
      const stroke = isSelected ? MERIDIANS[pt.meridian]?.color || 'var(--pri)' : 'none';
      const strokeW = isSelected ? 1.5 : 0;
      const opacity = isSelected ? 1 : (merActive ? 0.8 : 0.15);

      pointsHtml += `<circle class="${cls}" cx="${pt.x}" cy="${pt.y}" r="${r}" fill="${fill}" stroke="${stroke}" stroke-width="${strokeW}" opacity="${opacity}" onclick="selectAcupoint('${id}')" data-acupoint="${id}"/>`;
    }

    container.innerHTML = pathsHtml;
    ptContainer.innerHTML = pointsHtml;
  }

  // ── 更新右侧详情面板 ──
  function updateCoworkDetail() {
    const empty = document.getElementById('cwEmpty');
    const content = document.getElementById('cwContent');
    const titleEl = document.getElementById('cwDetailTitle');
    const statusEl = document.getElementById('cwDetailStatus');
    const badge = document.getElementById('cwHBadge');
    const taskList = document.getElementById('cwTaskList');
    const agentList = document.getElementById('cwAgentList');

    if (!empty || !content) return;

    const selId = cultState.selectedMeridian;
    const m = MERIDIANS[selId];
    const selPt = cultState.selectedAcupoint ? ACUPOINTS[cultState.selectedAcupoint] : null;

    empty.style.display = 'none';
    content.style.display = 'flex';

    if (titleEl) titleEl.textContent = m ? m.name + ' · ' + m.subtitle : '修炼';
    if (statusEl) statusEl.textContent = m ? (m.active ? '已通 ' + m.progress + '%' : '未通 · ' + (REALMS[cultState.realmIdx]?.name || '筑基') + '后可开') : '';
    if (badge) {
      badge.textContent = m ? (m.active ? '活跃中' : '封闭') : '修炼';
      badge.style.background = m?.active ? 'var(--suc)' : 'var(--tx3)';
    }

    if (taskList) {
      // Show meridian info as tasks
      const pts = m ? m.points.map(pid => {
        const pt = ACUPOINTS[pid];
        if (!pt) return null;
        const r = pt.activated ? '已激活' : '未激活';
        const sel = pid === cultState.selectedAcupoint;
        return `<div class="cw-task" style="cursor:pointer" onclick="selectAcupoint('${pid}')">
          <span class="dot ${pt.activated ? 'done' : ''}" style="${sel ? 'box-shadow:0 0 6px var(--pri)' : ''}"></span>
          <span class="tname">${pt.name}${sel ? ' ←' : ''}</span>
          <span class="tstat" style="color:${pt.activated ? 'var(--suc)' : 'var(--tx3)'}">${r}</span>
        </div>`;
      }).filter(Boolean).join('') : '<div class="cw-task"><span class="tname" style="color:var(--tx3)">请选择经脉</span></div>';
      taskList.innerHTML = pts;
    }

    if (agentList) {
      const realm = getCurrentRealm();
      const nextRealm = REALMS[cultState.realmIdx + 1];
      agentList.innerHTML = `
        <div class="cw-agent"><span class="adot" style="background:${realm.color}"></span>当前境界: ${realm.name}</div>
        <div class="cw-agent"><span class="adot" style="background:var(--tx3)"></span>下一重: ${nextRealm ? nextRealm.name + ' ('+nextRealm.pct+'%)' : '已至化境'}</div>
        <div class="cw-agent"><span class="adot" style="background:${m?.color || 'var(--tx3)'}"></span>${m ? m.name + ': ' + (m.active ? '已通 ' + m.progress + '%' : '未通') : '未选择经脉'}</div>
        <div class="cw-agent"><span class="adot" style="background:var(--pri)"></span>${selPt ? selPt.name + ': ' + selPt.desc : '点击穴位查看详情'}</div>
      `;
    }
  }

  // ── 修炼循环 (模拟每日自动增长) ──
  function cultivationTick() {
    cultState.tick++;

    // Simulate meridian activation based on realm
    const realm = getCurrentRealm();
    const rIdx = REALMS.indexOf(realm);

    // 筑基期: 任脉可通
    if (rIdx >= 1) MERIDIANS.ren.active = true;
    // 炼精化气: 督脉+小周天相关
    if (rIdx >= 1) {
      MERIDIANS.du.active = true;
      MERIDIANS.lung.active = true;
      MERIDIANS.heart.active = true;
      MERIDIANS.largeintestine.active = true;
    }
    // 炼气化神: 大周天
    if (rIdx >= 2) {
      MERIDIANS.pericardium.active = true;
      MERIDIANS.sanjiao.active = true;
      MERIDIANS.spleen.active = true;
      MERIDIANS.stomach.active = true;
    }
    // 炼神还虚: 奇经全通
    if (rIdx >= 3) {
      MERIDIANS.kidney.active = true;
      MERIDIANS.liver.active = true;
      MERIDIANS.gallbladder.active = true;
    }
    // 炼虚合道: 全部通
    if (rIdx >= 4) {
      MERIDIANS.smallintestine.active = true;
      MERIDIANS.bladder.active = true;
    }

    // Slow progress growth
    if (cultState.tick % 10 === 0 && cultState.progress < 100) {
      cultState.progress = Math.min(100, cultState.progress + 0.5);
      // Update realm index
      for (let i = REALMS.length - 1; i >= 0; i--) {
        if (cultState.progress >= REALMS[i].pct) {
          cultState.realmIdx = i;
          break;
        }
      }

      // Update meridian progress based on realm
      for (const [id, m] of Object.entries(MERIDIANS)) {
        if (m.active && m.progress < 100) {
          m.progress = Math.min(100, m.progress + 0.3 + Math.random() * 0.7);
        }
        // Back-fill inactive meridians that should be active at current realm
        if (!m.active && rIdx >= 1) {
          if (['ren','du','lung','heart','largeintestine'].includes(id)) {
            m.active = true;
            m.progress = 1 + Math.random() * 5;
          }
        }
        if (!m.active && rIdx >= 2) {
          if (['pericardium','sanjiao','spleen','stomach'].includes(id)) {
            m.active = true;
            m.progress = 1 + Math.random() * 5;
          }
        }
      }

      // Update insights
      const insights = [];
      if (MERIDIANS.ren.active) insights.push('任脉已通 · 阴脉朝元');
      if (MERIDIANS.du.active) insights.push('督脉渐开 · 阳脉充盈');
      if (MERIDIANS.ren.active && MERIDIANS.du.active) insights.push('任督交汇 · 小周天运转');
      if (MERIDIANS.lung.active) insights.push('肺经通 · 气机宣发');
      if (MERIDIANS.heart.active) insights.push('心经通 · 神明有主');
      if (rIdx >= 2) insights.push('大周天开通 · 五气朝元');
      if (rIdx >= 3) insights.push('阳神初现 · 可出顶门');
      if (rIdx >= 4) insights.push('打破虚空 · 与道合真');
      if (cultState.progress < 20) insights.push('筑基培元 · 勿忘勿助');
      cultState.insights = insights.length > 0 ? insights : ['静心守一 · 无为而修'];
    }

    saveCultState();
  }

  // ── 初始化修炼系统 ──
  let cultInit = false;

  function initCultivation() {
    if (cultInit) {
      // Still re-render (user might have navigated away and back)
      renderCultivationSidebar();
      updateCoworkDetail();
      return;
    }
    cultInit = true;

    // Restore saved progress
    const realm = getCurrentRealm();
    const rIdx = REALMS.indexOf(realm);

    // Set active meridians based on saved realm
    for (let i = 0; i <= rIdx; i++) {
      // Give some progress to each meridian
      cultivationTick();
    }

    renderCultivationSidebar();
    updateCoworkDetail();

    // Start auto-tick
    setInterval(() => {
      cultivationTick();
      // Refresh UI every 30 ticks (~15s)
      if (cultState.tick % 3 === 0) {
        renderCultivationSidebar();
        updateCoworkDetail();
      }
    }, 500);
  }

  /* ===== Channel Management (Bot Channels) ===== */
  const CHANNEL_PRESETS = [
    { id:'telegram', name:'Telegram', icon:'✈', desc:'Telegram Bot API', fields:[
      { key:'token', label:'Bot Token', type:'password', placeholder:'123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11' },
      { key:'chatId', label:'Chat ID', type:'text', placeholder:'-1001234567890（可选）' },
    ]},
    { id:'wechat', name:'WeChat', icon:'💬', desc:'微信公众平台 / 企业微信', fields:[
      { key:'appId', label:'App ID', type:'text', placeholder:'wx1234567890abcdef' },
      { key:'appSecret', label:'App Secret', type:'password', placeholder:'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' },
      { key:'token', label:'Token', type:'text', placeholder:'自定义 Token（可选）' },
    ]},
    { id:'whatsapp', name:'WhatsApp', icon:'📱', desc:'WhatsApp Business API (Meta)', fields:[
      { key:'token', label:'Access Token', type:'password', placeholder:'EAAT...' },
      { key:'phoneNumberId', label:'Phone Number ID', type:'text', placeholder:'123456789012345' },
      { key:'verifyToken', label:'Verify Token', type:'text', placeholder:'自定义验证令牌' },
    ]},
    { id:'discord', name:'Discord', icon:'🎮', desc:'Discord Bot / Webhook', fields:[
      { key:'token', label:'Bot Token', type:'password', placeholder:'MTE4...' },
      { key:'webhookUrl', label:'Webhook URL', type:'url', placeholder:'https://discord.com/api/webhooks/...（可选）' },
    ]},
    { id:'slack', name:'Slack', icon:'⚡', desc:'Slack Bot / Webhook', fields:[
      { key:'token', label:'Bot Token', type:'password', placeholder:'xoxb-...' },
      { key:'webhookUrl', label:'Webhook URL', type:'url', placeholder:'https://hooks.slack.com/services/...（可选）' },
    ]},
    { id:'feishu', name:'飞书 (Feishu)', icon:'📋', desc:'飞书自建应用 / 群机器人', fields:[
      { key:'webhookUrl', label:'Webhook URL', type:'url', placeholder:'https://open.feishu.cn/open-apis/bot/v2/hook/...' },
      { key:'appId', label:'App ID', type:'text', placeholder:'cli_xxxxxxxxxxxxx' },
      { key:'appSecret', label:'App Secret', type:'password', placeholder:'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' },
    ]},
  ];

  const CHANNELS_KEY = 'neotrix_channels';

  function getChannels() {
    try { return JSON.parse(localStorage.getItem(CHANNELS_KEY)) || []; }
    catch(e) { return []; }
  }

  function saveChannels(channels) {
    localStorage.setItem(CHANNELS_KEY, JSON.stringify(channels));
    renderChannels();
  }

  function renderChannels() {
    const container = document.getElementById('stChannelList');
    const countEl = document.getElementById('stChanCount');
    if (!container) return;
    const channels = getChannels();
    if (countEl) countEl.textContent = channels.length + ' 个';

    container.innerHTML = CHANNEL_PRESETS.map(p => {
      const saved = channels.find(c => c.id === p.id);
      const enabled = saved && saved.enabled;
      const configured = saved && Object.values(saved).filter(v => typeof v === 'string' && v.length > 3).length > 1;
      return `<div style="display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--bd);transition:var(--tr);cursor:pointer" onclick="showChannelDetail('${p.id}')">
        <label class="st-switch" style="margin:0;flex-shrink:0" onclick="event.stopPropagation()">
          <input type="checkbox" ${enabled ? 'checked' : ''} onchange="toggleChannel('${p.id}',this.checked)" />
        </label>
        <span style="font-size:16px;width:24px;text-align:center;flex-shrink:0">${p.icon}</span>
        <span style="flex:1;font-size:var(--fs-small);color:var(--tx);font-weight:var(--fw-medium)">${p.name}</span>
        <span style="font-size:var(--fs-caption);color:${configured ? 'var(--suc)' : 'var(--tx3)'}">${configured ? '✅ 已配置' : '未配置'}</span>
        <span style="width:8px;height:8px;border-radius:50%;background:${enabled ? 'var(--suc)' : 'var(--tx-meta)'};flex-shrink:0"></span>
      </div>`;
    }).join('');

    // Update status in detail panel if open
    const detailEl = document.getElementById('stChannelDetail');
    if (detailEl && detailEl.style.display !== 'none') {
      const current = detailEl.dataset.channelId;
      if (current) showChannelDetail(current);
    }
  }

  function toggleChannel(id, enabled) {
    let channels = getChannels();
    let ch = channels.find(c => c.id === id);
    if (!ch) {
      ch = { id, enabled };
      channels.push(ch);
    } else {
      ch.enabled = enabled;
    }
    saveChannels(channels);
    showToast((enabled ? '已启用 ' : '已禁用 ') + (CHANNEL_PRESETS.find(p => p.id === id)?.name || id));
  }

  function showChannelDetail(id) {
    const preset = CHANNEL_PRESETS.find(p => p.id === id);
    if (!preset) return;
    const channels = getChannels();
    const saved = channels.find(c => c.id === id) || { id, enabled:false };
    const detailEl = document.getElementById('stChannelDetail');
    if (!detailEl) return;
    detailEl.dataset.channelId = id;
    detailEl.style.display = 'block';

    detailEl.innerHTML = `<div class="st-card" style="padding:14px 16px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
        <span style="font-size:18px">${preset.icon}</span>
        <span style="font-size:var(--fs-body);font-weight:var(--fw-semibold);color:var(--tx)">${preset.name}</span>
        <span style="font-size:var(--fs-caption);color:var(--tx3)">${preset.desc}</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px">
        ${preset.fields.map(f => {
          const val = saved[f.key] || '';
          return `<div class="st-field" style="margin:0">
            <label class="st-lbl">${f.label}</label>
            <div style="display:flex;gap:6px;flex:1">
              <input type="${f.type}" class="st-input" id="ch_${id}_${f.key}" value="${escHtml(val)}" placeholder="${f.placeholder}" style="flex:1;font-family:var(--fm);font-size:var(--fs-caption)" />
              ${f.type === 'password' ? `<button onclick="toggleKeyVis('ch_${id}_${f.key}')" style="border:none;background:var(--ghost);border-radius:6px;cursor:pointer;color:var(--tx3);padding:0 8px;font-size:11px">👁</button>` : ''}
            </div>
          </div>`;
        }).join('')}
      </div>
      <div style="display:flex;gap:8px;margin-top:12px">
        <button onclick="saveChannelConfig('${id}')" style="padding:6px 16px;border-radius:8px;border:none;background:var(--tx);color:var(--bg-base);font-size:var(--fs-small);cursor:pointer;font-family:var(--ff)">保存</button>
        <button onclick="testChannel('${id}')" id="chTestBtn_${id}" style="padding:6px 16px;border-radius:8px;border:1px solid var(--bd);background:var(--ghost);color:var(--tx2);font-size:var(--fs-small);cursor:pointer;font-family:var(--ff)">测试连接</button>
        <span id="chTestResult_${id}" style="font-size:var(--fs-caption);color:var(--tx3);align-self:center"></span>
      </div>
    </div>`;
  }

  function saveChannelConfig(id) {
    const preset = CHANNEL_PRESETS.find(p => p.id === id);
    if (!preset) return;
    let channels = getChannels();
    let ch = channels.find(c => c.id === id);
    if (!ch) { ch = { id, enabled:false }; channels.push(ch); }
    preset.fields.forEach(f => {
      const el = document.getElementById(`ch_${id}_${f.key}`);
      if (el) ch[f.key] = el.value.trim();
    });
    saveChannels(channels);
    showToast(preset.name + ' 配置已保存');
  }

  function testChannel(id) {
    const btn = document.getElementById('chTestBtn_' + id);
    const result = document.getElementById('chTestResult_' + id);
    if (!btn || !result) return;
    btn.disabled = true;
    result.textContent = '测试中...';
    setTimeout(() => {
      const ok = Math.random() > 0.3;
      result.textContent = ok ? '✅ 连接成功' : '❌ 连接失败';
      result.style.color = ok ? 'var(--suc)' : 'var(--des)';
      btn.disabled = false;
    }, 800 + Math.random() * 600);
  }

  /* Init channels */
  renderChannels();

  /* ===== Conversation List Panel ===== */
let conversations = [];
let currentConvId = null;

function showConvPanel() {
  const panel = document.getElementById('convPanel');
  panel.classList.add('open');
  renderConvPanel();
}

function closeConvPanel() {
  document.getElementById('convPanel').classList.remove('open');
}

function renderConvPanel() {
  const body = document.getElementById('convPanelBody');
  const count = document.getElementById('convCount');
  count.textContent = conversations.length;
  if (conversations.length === 0) {
    body.innerHTML = '<div class="conv-empty"><p style="font-size:13px;font-weight:500">还没有对话</p><p style="font-size:11px;color:var(--tx3)">点击下方按钮开始第一次对话</p><button onclick="createConversation()">+ 新建对话</button></div>';
    return;
  }
  body.innerHTML = conversations.map(c => {
    const active = c.id === currentConvId ? 'active' : '';
    const msgCount = (c.messages || []).length;
    const lastTime = c.updatedAt ? timeAgo(c.updatedAt) : '';
    const avatar = c.name.charAt(0).toUpperCase();
    return `<div class="conv-card ${active}" onclick="switchConversation('${c.id}')">
      <div class="conv-avatar">${avatar}</div>
      <div class="conv-info">
        <div class="conv-name">${escHtml(c.name)}</div>
        <div class="conv-meta">${msgCount} 条消息 · ${lastTime}</div>
      </div>
      <div class="conv-card-actions">
        <button class="conv-card-act" onclick="event.stopPropagation();renameConversation('${c.id}')" title="重命名">✎</button>
        <button class="conv-card-act del" onclick="event.stopPropagation();deleteConversation('${c.id}')" title="删除">✕</button>
      </div>
    </div>`;
  }).join('');
}

function createConversation() {
  const id = 'conv_' + Date.now() + '_' + Math.random().toString(36).slice(2,6);
  const names = ['新对话','技术讨论','问题分析','代码审查','架构设计'];
  const name = names[Math.floor(Math.random() * names.length)];
  conversations.unshift({ id, name, messages: [], createdAt: Date.now(), updatedAt: Date.now() });
  currentConvId = id;
  saveConversations();
  renderConvPanel();
  switchToConversation(id);
  closeConvPanel();
  showToast('新建对话');
}

function switchConversation(id) {
  if (id === currentConvId) { closeConvPanel(); return; }
  currentConvId = id;
  saveConversations();
  renderConvPanel();
  switchToConversation(id);
  closeConvPanel();
}

function switchToConversation(id) {
  const conv = conversations.find(c => c.id === id);
  if (!conv) return;
  const cs = document.getElementById('chatScroll');
  const hero = document.getElementById('heroSection');
  if (conv.messages && conv.messages.length > 0) {
    isChatMode = true;
    hero.style.display = 'none';
    cs.style.display = 'flex';
    cs.innerHTML = '';
    conv.messages.forEach(msg => {
      const el = document.createElement('div');
      el.className = 'msg ' + msg.role;
      el.innerHTML = msg.html;
      cs.appendChild(el);
    });
    cs.scrollTop = cs.scrollHeight;
  } else {
    isChatMode = false;
    hero.style.display = 'flex';
    cs.style.display = 'none';
    cs.innerHTML = '';
    document.getElementById('chatInput').value = '';
  }
  document.getElementById('sendBtn').disabled = true;
}

function deleteConversation(id) {
  if (!confirm('确认删除该对话？')) return;
  conversations = conversations.filter(c => c.id !== id);
  if (currentConvId === id) {
    currentConvId = conversations.length > 0 ? conversations[0].id : null;
    if (currentConvId) switchToConversation(currentConvId);
    else {
      isChatMode = false;
      document.getElementById('heroSection').style.display = 'flex';
      document.getElementById('chatScroll').style.display = 'none';
      document.getElementById('chatScroll').innerHTML = '';
    }
  }
  saveConversations();
  renderConvPanel();
}

function renameConversation(id) {
  const conv = conversations.find(c => c.id === id);
  if (!conv) return;
  const newName = prompt('对话名称：', conv.name);
  if (newName && newName.trim()) {
    conv.name = newName.trim();
    conv.updatedAt = Date.now();
    saveConversations();
    renderConvPanel();
  }
}

function saveConversations() {
  try { localStorage.setItem('nt_conversations', JSON.stringify(conversations)); } catch(e) {}
}

function loadConversations() {
  try {
    const saved = JSON.parse(localStorage.getItem('nt_conversations'));
    conversations = Array.isArray(saved) ? saved : [];
  } catch(e) { conversations = []; }
}

function timeAgo(ts) {
  const diff = Date.now() - ts;
  if (diff < 60000) return '刚才';
  if (diff < 3600000) return Math.floor(diff / 60000) + '分钟前';
  if (diff < 86400000) return Math.floor(diff / 3600000) + '小时前';
  return Math.floor(diff / 86400000) + '天前';
}

/* ===== Auto-detect local models on startup ===== */
async function autoDetectModels() {
  const endpoints = ['http://localhost:11434', 'http://localhost:8000', 'http://localhost:8080'];
  let found = false;
  for (const ep of endpoints) {
    try {
      const resp = await fetch(ep + '/api/tags', { signal: AbortSignal.timeout(3000) });
      if (resp.ok) {
        const data = await resp.json();
        const models = (data.models || []).map(m => m.name);
        if (models.length > 0) {
          found = true;
          showToast('🟢 本地模型: ' + models.slice(0, 3).join(', ') + (models.length > 3 ? '...' : ''));
          break;
        }
      }
    } catch(e) {
      try {
        const resp2 = await fetch(ep + '/v1/models', { signal: AbortSignal.timeout(2000) });
        if (resp2.ok) {
          const data2 = await resp2.json();
          const models = (data2.data || []).map(m => m.id);
          if (models.length > 0) {
            found = true;
            showToast('🟢 本地 API: ' + models.slice(0, 3).join(', ') + (models.length > 3 ? '...' : ''));
            break;
          }
        }
      } catch(e2) {}
    }
  }
  if (!found) {
    console.log('[NeoTrix] 未检测到本地模型引擎');
  }
}

/* Init */
loadConversations();
renderConvPanel();
setTimeout(autoDetectModels, 2000);
</script>
</body>
</html>
