        <div class="evo-card"><span class="lbl">活跃</span><span class="val">SEAL 自迭代</span><span style="font-size:10px;color:var(--tx3)">27 阶段 · 频率 3</span></div>
        <div class="evo-card"><span class="lbl">就绪</span><span class="val">记忆嵌入刷新</span><span style="font-size:10px;color:var(--tx3)">频率 10 · 自动</span></div>
        <div class="evo-card"><span class="lbl">就绪</span><span class="val">GraphRAG 社区摘要</span><span style="font-size:10px;color:var(--tx3)">频率 15 · 增量</span></div>
      </div>`;
