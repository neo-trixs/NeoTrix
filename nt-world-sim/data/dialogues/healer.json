        {"text": "回血丹 (50金)", "next": "buy_hp", "conditions": [{"type": "gold", "amount": 50}]},
        {"text": "回蓝丹 (80金)", "next": "buy_mp", "conditions": [{"type": "gold", "amount": 80}]},
        {"text": "解毒丹 (120金)", "next": "buy_antidote", "conditions": [{"type": "gold", "amount": 120}]},
