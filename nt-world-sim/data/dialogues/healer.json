    {
      "id": "remove_curse",
      "text": "好了，诅咒已经解除了。",
      "choices": [
        {"text": "谢谢", "next": null, "effects": [{"type": "remove_effect", "effect": "cursed", "cost": 100}]}
      ]
    },
    {
      "id": "no_curse",
      "text": "那就好。祝你平安。",
      "choices": [
        {"text": "谢谢", "next": null}
