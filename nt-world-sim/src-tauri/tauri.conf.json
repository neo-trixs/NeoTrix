{
  "productName": "Star Valley",
  "version": "1.0.0",
  "identifier": "com.neotrix.star-valley",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Star Valley - 星谷物语",
        "width": 960,
        "height": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../icons/icon-32x32.png",
      "../icons/icon-128x128.png",
      "../icons/icon-256x256.png",
      "../icons/icon-512x512.png",
      "../icons/icon.png"
    ]
  }
}
