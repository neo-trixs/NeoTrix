{
  "name": "dsh-tauri-ui",
  "type": "module",
  "version": "1.0.0",
  "author": "Hairyf <wwu710632@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-tauri-desk/dsh-tauri-plugins.git"
  },
  "bugs": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins/issues",
  "keywords": [
    "dsh",
    "plugin",
    "dsh-plugin",
    "tauri",
    "deepseek-harness"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./client": {
      "types": "./dist/client.d.cts",
      "default": "./dist/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "cordis.patch.yml",
    "dist"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "dsh-tauri"
      ],
      "external": [
        "dsh-tauri/client"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsx scripts/taiwindcss.ts && tsdown",
    "dev": "tsx scripts/taiwindcss.ts --watch --no-minify & tsdown --watch",
    "generate": "tsx scripts/taiwindcss.ts",
    "prepublishOnly": "nr build",
    "start": "tsx src/index.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "dsh-tauri": "workspace:*"
  },
  "devDependencies": {
    "@css-render/plugin-bem": "catalog:ui",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@gravity-ui/icons": "catalog:runtime",
    "@tailwindcss/postcss": "catalog:build",
    "css-render": "catalog:ui",
    "dsh-tauri-tsdown": "workspace:*",
    "postcss": "catalog:build",
    "tsdown": "catalog:cli"
  }
}
