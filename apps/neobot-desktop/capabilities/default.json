{
  "identifier": "default",
  "description": "NeoBot standalone minimal capabilities — scoped to ~/.neobot only (tighter than main app $HOME/**)",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:event:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "shell:allow-open",
    "fs:default",
    {
      "identifier": "fs:allow-read",
      "allow": [{ "path": "$HOME/.neobot/**" }, { "path": "$TEMP/**" }]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [{ "path": "$HOME/.neobot/**" }, { "path": "$TEMP/**" }]
    }
  ]
}
