[
    StsEventDef(
        id: "abyssal_baths",
        name: "深渊浴场",
        act: "Underdocks",
        description: "你发现了一间僻静的密室。\n\n氤氲的雾气从沸腾的池水中升腾而起，池水的色泽正以一种催眠般的节奏变幻。天花板上垂挂着覆满藤壶的异形生长物，滴落的黏稠液体在触及水面的瞬间，一边发出嘶嘶声，一边如活物般扭动挣扎。空气粘滞沉重，充斥着[blue]盐[/blue]的味道和某种[green]不言而喻的活物的气息[/green]。\n\n当你靠近那口最大的水池时，液面泛起了涟漪。水流翻腾得愈发狂乱，仿佛正期待着你的到来。",
        preconditions: None,
        options: [
        StsEventOption(id: "IMMERSE", title: "Immerse", title_cn: "投身其中", description: "获得[green]2[/green]点最大生命值。受到[red]3[/red]点伤害。"),
        StsEventOption(id: "ABSTAIN", title: "Abstain", title_cn: "敬而远之", description: "回复[green]10[/green]点生命。"),
        ],
    ),
    StsEventDef(
        id: "amalgamator",
        name: "熔合者",
        act: "Act 2 - Hive",
        description: "[b][jitter]铿！铿！！锵！！！[/jitter][/b]\n\n墙壁的另一侧传来了阵阵金属交击声的回响…\n\n当你把头贴在墙上准备探听一番时——墙壁轰然开启，露出了一个正在埋头苦干的[orange]魁梧六臂身影[/orange]。\n它的“脸部”是一团由[gold][sine]发光符文构成的流转旋涡[/sine][/gold]，正在不断变幻交织。\n\n“一个拥有[aqua]进阶之魂[/aqua]的人竟然找到了我的工坊？那就让我们开始[jitter]融合[/jitter]吧！”",
        preconditions: Some("[\"Requires 2+ Strikes in deck\", \"Requires 2+ Defends in deck\"]"),
        options: [
        StsEventOption(id: "COMBINE_STRIKES", title: "Combine Strikes", title_cn: "融合打击", description: "移除[blue]2[/blue]张[gold]打击[/gold]。并将一张[gold]究极打击[/gold]添加至你的[gold]牌组[/gold]。"),
        StsEventOption(id: "COMBINE_DEFENDS", title: "Combine Defends", title_cn: "融合防御", description: "移除[blue]2[/blue]张[gold]防御[/gold]。并将一张[gold]究极防御[/gold]添加至你的[gold]牌组[/gold]。"),
        ],
    ),
    StsEventDef(
        id: "aroma_of_chaos",
        name: "混沌芳香",
        act: "Act 1 - Overgrowth",
        description: "费力地穿过一片厚密的灌木丛并来到空地后，一种莫名的怀旧感突然向你袭来。\n\n那是[purple]花朵的芬芳[/purple]、[green]腐烂的恶臭[/green]以及[orange]某种无法言说的气息[/orange]的混合体。每前进一步，这股气味都变得愈发浓烈。与此同时，你感受到周围的世界正开始[sine]扭曲，旋转[/sine]。\n\n一股[sine]变幻莫测的混沌[/sine]将你淹没，你开始慢慢地丧失了对自我的感知。",
        preconditions: None,
        options: [
        StsEventOption(id: "LET_GO", title: "Let Go", title_cn: "放任自流", description: "[gold]变化[/gold]你[gold]牌组[/gold]中的一张牌。"),
        StsEventOption(id: "MAINTAIN_CONTROL", title: "Maintain Control", title_cn: "维持理智", description: "[gold]升级[/gold]你[gold]牌组[/gold]中的一张牌。"),
        ],
    ),
    StsEventDef(
        id: "battleworn_dummy",
        name: "战痕累累的训练假人",
        act: "Act 3 - Glory",
        description: "当你靠近时，它突然开始轰鸣，滋滋作响，随后爆发出耀眼的光芒！\n\n[b]“[jitter]滋滋！[/jitter] 训练时间到！！！你有[blue]3个回合[/blue]的时间来击败我！\n选择一个档位，否则就准备好面对[red]致命的羞辱[/red]吧。[/b]\n以下是可选方案：”\n\n在发布完这段恐怖的宣言后，假人开始认真地读出详细的指令。\n\n要选哪一个呢？",
        preconditions: None,
        options: [
        StsEventOption(id: "SETTING_1", title: "Setting 1", title_cn: "第1档", description: "与一个[blue]75[/blue]点生命值的假人战斗。随机获取[blue]1[/blue]瓶[gold]药水[/gold]。"),
        StsEventOption(id: "SETTING_2", title: "Setting 2", title_cn: "第2档", description: "与一个[blue]150[/blue]点生命值的假人战斗。随机[gold]升级[/gold][blue]2[/blue]张牌。"),
        StsEventOption(id: "SETTING_3", title: "Setting 3", title_cn: "第3档", description: "与一个[blue]300[/blue]点生命值的假人战斗。获取一件随机[gold]遗物[/gold]。"),
        ],
    ),
    StsEventDef(
