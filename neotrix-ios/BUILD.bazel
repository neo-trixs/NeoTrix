# NeoGram iOS - Root BUILD file
# Defines the main app target and module dependencies.
# NOTE: Swift sources are organized as flat files under Sources/ (not per-module
# Bazel packages). swift_library targets use glob() to match the actual layout.

load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

# =============================================================================
# NeoTrix Rust core
# =============================================================================
# NOTE: The NeoTrix Rust core is NOT compiled via Bazel. It is built with Cargo
# (`cargo build -p neotrix --features ios-bridge --lib`) and its Swift bindings
# are generated by `scripts/generate-swift-bindings.sh` (uniffi library mode,
# `--metadata-no-deps`). Generated artifacts are committed under
# Sources/Bridge/NeoTrixFFI/Generated/ and consumed directly below.

# =============================================================================
# C module: neotrixFFI (uniffi C header + modulemap)
# =============================================================================
# NOTE: The neotrix_ffi_c objc_library is defined in Sources/BUILD.bazel
# (same package as the Generated/ artifacts it references). It is consumed
# here via //Sources:neotrix_ffi_c.

# =============================================================================
# Swift Module: NeoTrixFFI (Generated bindings)
# =============================================================================
swift_library(
    name = "NeoTrixFFI",
    srcs = glob(["Sources/Bridge/NeoTrixFFI/**/*.swift"]),
    module_name = "NeoTrixFFI",
    deps = [
        "//Sources:neotrix_ffi_c",
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Swift Module: Core (coordinator + MTProto)
# =============================================================================
swift_library(
    name = "Core",
    srcs = glob(["Sources/Core/**/*.swift"]),
    module_name = "NeoGramCore",
    deps = [
        ":NeoTrixFFI",
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Swift Module: UI (flat chat/settings/stories/etc.)
# =============================================================================
swift_library(
    name = "UI",
    srcs = glob(["Sources/UI/**/*.swift"]),
    module_name = "NeoGramUI",
    deps = [
        ":Core",
        ":NeoTrixFFI",
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Swift Module: Premium
# =============================================================================
swift_library(
    name = "Premium",
    srcs = glob(["Sources/Premium/**/*.swift"]),
    module_name = "NeoGramPremium",
    deps = [
        ":Core",
        ":NeoTrixFFI",
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Swift Module: Features (NeoTrix AI integration)
# =============================================================================
swift_library(
    name = "Features",
    srcs = glob(["Sources/Features/**/*.swift"]),
    module_name = "NeoGramFeatures",
    deps = [
        ":Core",
        ":NeoTrixFFI",
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Main Application Target
# =============================================================================
ios_application(
    name = "NeoGram",
    bundle_id = "com.neotrix.neogram",
    families = ["iphone", "ipad"],
    minimum_os_version = "17.0",
    infoplists = ["Resources/Info.plist"],
    app_icons = ["Resources/Assets.xcassets"],
    # NOTE: rules_apple 3.22.0 removed the built-in
    # @rules_apple//apple/provisioning:development target. Provisioning is now
    # resolved automatically via local_provisioning_profiles (searches for
    # *.mobileprovision next to the workspace). For simulator builds no
    # provisioning profile is required.
    deps = [
        ":Core",
        ":UI",
        ":Premium",
        ":Features",
        ":NeoTrixFFI",
        "//Sources:NeoGramApp",
    ],
)

# =============================================================================
# Configuration
# =============================================================================
# Build settings
# - Swift 5.9+
# - iOS 17.0+
# - Rust 1.79+
# - Bazel 7.x