# NeoGram iOS - Bazel Workspace
# Hybrid NeoTrix + Telegram iOS Architecture

workspace(name = "neogram_ios")

# Load Bazel rules
load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
load("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

# =============================================================================
# Apple Rules (for iOS/macOS builds)
# =============================================================================
http_archive(
    name = "rules_apple",
    sha256 = "133d51692dfd286a398514e598871a79951b10531794e9d9712947abdb693a81",
    urls = ["https://github.com/bazelbuild/rules_apple/archive/refs/tags/3.22.0.tar.gz"],
    strip_prefix = "rules_apple-3.22.0",
)

# =============================================================================
# Swift Rules — MUST be registered BEFORE apple_rules_dependencies()
# =============================================================================
# rules_apple 3.22.0 declares rules_swift **2.4.0** as its dependency
# (MODULE.bazel: bazel_dep rules_swift 2.4.0, repo_name build_bazel_rules_swift)
# and its code references `@build_bazel_rules_swift//swift:emit_swiftinterface`
# (transition_support.bzl), which was RENAMED to swift_synthesize_interface_aspect
# in rules_swift 3.x. Mixing 3.6.1 under the canonical name breaks the build
# (missing emit_swiftinterface target + prerequisites struct lacking objc_info).
# → Pin BOTH names to 2.4.0 so rules_apple and rules_swift agree.
http_archive(
    name = "build_bazel_rules_swift",
    sha256 = "28db894977ac51c8f3ab7c6dc9d655a85510366734e900b3c5302ce1ed91256c",
    urls = ["https://github.com/bazelbuild/rules_swift/releases/download/2.4.0/rules_swift.2.4.0.tar.gz"],
)

load("@rules_apple//apple:repositories.bzl", "apple_rules_dependencies")
apple_rules_dependencies()

# =============================================================================
# Apple CC Toolchain (required by objc_library / cc_library on Apple platforms)
# =============================================================================
# apple_support's apple_cc_configure() registers the local Apple CC toolchain
# (local_config_apple_cc + local_config_apple_cc_toolchains). Required for
# compiling the neotrixFFI C layer via objc_library.
load("@build_bazel_apple_support//crosstool:setup.bzl", "apple_cc_configure")
apple_cc_configure()

# =============================================================================
# Swift Rules
# =============================================================================
# Pinned to 2.4.0 to match rules_apple 3.22.0's declared dependency (see the
# build_bazel_rules_swift registration above). rules_swift 3.x renamed
# emit_swiftinterface → swift_synthesize_interface_aspect and is incompatible
# with rules_apple 3.22.0.
# NOTE: Only the canonical name `build_bazel_rules_swift` is registered. The
# `rules_swift` alias is intentionally NOT created: rules_apple loads SwiftInfo
# from @build_bazel_rules_swift, and Bazel treats providers from differently-
# named repos as distinct instances — a second alias would break
# `target[SwiftInfo]` lookups in resource_aspect.bzl.
load("@build_bazel_rules_swift//swift:repositories.bzl", "swift_rules_dependencies")
swift_rules_dependencies()

# =============================================================================
# rules_swift 2.4.0 index-import worker (transitive dep via rules_apple)
# =============================================================================
# rules_apple 3.22.0 pulls in rules_swift 2.4.0, whose swift_runner worker
# references @build_bazel_rules_swift_index_import. In WORKSPACE mode this
# repo must be registered explicitly (rules_swift 3.6.1's
# swift_rules_dependencies() does not include it).
http_archive(
    name = "build_bazel_rules_swift_index_import",
    build_file = "@build_bazel_rules_swift//third_party:build_bazel_rules_swift_index_import/BUILD.overlay",
    canonical_id = "index-import-5.8",
    urls = ["https://github.com/MobileNativeFoundation/index-import/releases/download/5.8.0.1/index-import.tar.gz"],
    sha256 = "28c1ffa39d99e74ed70623899b207b41f79214c498c603915aef55972a851a15",
)

# =============================================================================
# C/C++ Compatibility Proxy (required by rules_cc 0.2.14 on bazel 7)
# =============================================================================
# rules_cc 0.2.14 loads @cc_compatibility_proxy//:proxy.bzl from its rules.
# In WORKSPACE mode this repo must be registered explicitly (bazel 7 does not
# autoload it for external rules_cc). See rules_cc/cc/extensions.bzl.
# bazel_features is a transitive dep of rules_cc (via rules_swift); register
# it explicitly so bazel_features_deps() can create bazel_features_version.
# NOTE: rules_swift 2.4.0's swift_rules_dependencies() does NOT pull rules_cc
# (3.6.1 did), so rules_cc 0.2.14 must be registered explicitly here.
http_archive(
    name = "rules_cc",
    sha256 = "a2fdfde2ab9b2176bd6a33afca14458039023edb1dd2e73e6823810809df4027",
    strip_prefix = "rules_cc-0.2.14",
    urls = ["https://github.com/bazelbuild/rules_cc/releases/download/0.2.14/rules_cc-0.2.14.tar.gz"],
)

http_archive(
    name = "bazel_features",
    sha256 = "a660027f5a87f13224ab54b8dc6e191693c554f2692fcca46e8e29ee7dabc43b",
    strip_prefix = "bazel_features-1.30.0",
    urls = ["https://github.com/bazel-contrib/bazel_features/releases/download/v1.30.0/bazel_features-v1.30.0.tar.gz"],
)

load("@bazel_features//:deps.bzl", "bazel_features_deps")
bazel_features_deps()

load("@rules_cc//cc:extensions.bzl", "compatibility_proxy_repo")
compatibility_proxy_repo()

# =============================================================================
# Protobuf (for MTProto TL schema)
# =============================================================================
http_archive(
    name = "rules_proto",
    sha256 = "6fb6767d1bef535310547e03247f7518b03487740c11b6c6adb7952033fe1295",
    urls = ["https://github.com/bazelbuild/rules_proto/archive/refs/tags/6.0.2.tar.gz"],
    strip_prefix = "rules_proto-6.0.2",
)

# =============================================================================
# Python Rules (required by rules_apple's xcframework_processor_tool)
# =============================================================================
# rules_apple 3.22.0 declares rules_python 1.3.0 (MODULE.bazel) and its
# apple/internal/BUILD loads @rules_python//python:py_test.bzl. Neither
# rules_swift 2.4.0 nor rules_apple's WORKSPACE-mode deps pull it, so register
# it explicitly.
http_archive(
    name = "rules_python",
    sha256 = "2cc26bbd53854ceb76dd42a834b1002cd4ba7f8df35440cf03482e045affc244",
    strip_prefix = "rules_python-1.3.0",
    urls = ["https://github.com/bazelbuild/rules_python/releases/download/1.3.0/rules_python-1.3.0.tar.gz"],
)

# rules_python 1.3.0's py_binary.bzl loads @rules_python_internal//:rules_python_config.bzl,
# which is created by py_repositories(). Must be called in WORKSPACE mode.
load("@rules_python//python:repositories.bzl", "py_repositories")
py_repositories()

# =============================================================================
# Shell Rules (required by rules_apple's main_thread_checker_tool)
# =============================================================================
# rules_apple 3.22.0 declares rules_shell 0.3.0 (MODULE.bazel) and its
# apple/internal/BUILD loads @rules_shell//shell:sh_binary.bzl. Register it
# explicitly (release tag is v0.3.0, not 0.3.0).
http_archive(
    name = "rules_shell",
    sha256 = "d8cd4a3a91fc1dc68d4c7d6b655f09def109f7186437e3f50a9b60ab436a0c53",
    strip_prefix = "rules_shell-0.3.0",
    urls = ["https://github.com/bazelbuild/rules_shell/releases/download/v0.3.0/rules_shell-v0.3.0.tar.gz"],
)

load("@rules_proto//proto:repositories.bzl", "rules_proto_dependencies")
rules_proto_dependencies()

# =============================================================================
# GCDAsyncSocket (for MTProto transport)
# =============================================================================
git_repository(
    name = "gcdasyncsocket",
    remote = "https://github.com/robbiehanson/CocoaAsyncSocket.git",
    tag = "7.6.5",
)

# =============================================================================
# Lottie (for animated emoji/stickers)
# =============================================================================
git_repository(
    name = "lottie_ios",
    remote = "https://github.com/airbnb/lottie-ios.git",
    tag = "4.4.3",
)

# =============================================================================
# Telegram TL Schema (for API generation)
# =============================================================================
# NOTE: https://github.com/TelegramMessenger/Telegram-Schema returns 404 (repo
# does not exist / was removed). MTProto TL schema handling is deferred; the
# MTProto layer in Sources/Core currently uses a local TL schema definition.
# Removed to keep WORKSPACE loadable.

