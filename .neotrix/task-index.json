      "tool": "bash scripts/check-layer-deps.sh --strict",
      "kind": "gate",
      "read_only": true,
      "when_not": "不要用它判层归属对错 —— 那是 .neotrix/layer-map.json 的职责；本门只查依赖方向",
      "spec": "AGENTS.md 三道闸"
    },
    {
      "id": "check-truth-surface",
      "query": [
        "truth",
        "空文件",
        "0字节",
        "未声明测试",
        "假实现",
        "stub",
        "空壳"
      ],
      "tool": "bash scripts/check-truth-surface.sh --strict",
      "kind": "gate",
      "read_only": true,
      "when_not": "",
      "spec": "AGENTS.md 三道闸"
    },
    {
      "id": "check-naming",
      "query": [
        "命名",
        "naming",
        "nt_前缀",
        "前缀规范",
        "文件名规范"
      ],
      "tool": "bash scripts/check-naming.sh",
      "kind": "gate",
      "read_only": true,
      "when_not": "advisory 而已 —— 规约 vs 现实差 1,646 个文件，该规约无约束力，PASS 不代表合规",
      "spec": "AGENTS.md 三道闸"
    },
    {
