{
  "_about": "任务→工具机器索引。解决「日常任务要跑哪个脚本」需全文读 AGENTS.md 的问题。",
  "_schema": {
    "id": "任务意图的稳定 slug（小写连字符）",
    "query": "自然语言触发词数组 —— agent 用它做匹配",
    "tool": "可直接执行的命令（相对仓库根）",
    "kind": "gate | locate | ops | absorb | oneoff",
    "read_only": "true 表示不产生副作用，可放心试跑",
    "when_not": "明确的禁用条件 —— 吸收 awesome-autoresearch「领养前检查表」的反面：不列何时别用，agent 会误用",
    "spec": "可选，指向规范条目（如 R-DISK-1）"
  },
  "tasks": [
    {
      "id": "check-layer-deps",
