+pub fn format_result_envelope(result: &CliResult) -> Result<String, NtBotError> {
+    let value = serde_json::json!({
+        "ok": result.ok,
+        "text": result.text,
+        "exit_code": result.exit_code,
+        "sideEffects": result.side_effects,
+    });
+    Ok(serde_json::to_string(&value)?)
+}
