#!/bin/bash
# NeoTrix llama-server service manager
# Usage: llama-ctl [start|stop|restart|status|logs]

SERVICE="com.neotrix.llama-server"
PLIST="$HOME/Library/LaunchAgents/$SERVICE.plist"

case "${1:-status}" in
    start)
        launchctl load "$PLIST" 2>/dev/null
        echo "✅ llama-server starting..."
        sleep 2
        if curl -s http://127.0.0.1:8080/v1/models > /dev/null 2>&1; then
            echo "✅ llama-server ready on :8080"
        else
            echo "⏳ warming up (model loading...)"
        fi
        ;;
    stop)
        launchctl unload "$PLIST" 2>/dev/null
        echo "🛑 llama-server stopped"
        ;;
    restart)
        launchctl unload "$PLIST" 2>/dev/null
        sleep 1
        launchctl load "$PLIST" 2>/dev/null
        echo "🔄 llama-server restarting..."
        sleep 3
        if curl -s http://127.0.0.1:8080/v1/models > /dev/null 2>&1; then
            echo "✅ llama-server ready"
        fi
        ;;
    status)
        if curl -s http://127.0.0.1:8080/v1/models > /dev/null 2>&1; then
            echo "✅ llama-server: RUNNING on :8080"
            curl -s http://127.0.0.1:8080/v1/models | python3 -m json.tool 2>/dev/null || true
        else
            echo "❌ llama-server: NOT RUNNING"
        fi
        ;;
    logs)
        tail -f /tmp/llama-server.stderr.log
        ;;
    *)
        echo "Usage: llama-ctl [start|stop|restart|status|logs]"
        exit 1
        ;;
esac
