          </div>
          <div class="st-field">
            <label class="st-lbl">Display name</label>
            <input type="text" class="st-input" value="neotrix" />
          </div>
          <div class="st-field">
            <label class="st-lbl">What best describes your work?</label>
            <select class="st-input"><option>Other</option><option>Developer</option><option>Designer</option></select>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

    </main>
  </div>
</div>

<script>
  /* ===== Icon Library ===== */
  const I = {
    plus: '<svg viewBox="0 0 14 14"><path d="M7 1.5l1.2 3.8 3.8 1.2-3.8 1.2L7 11.5l-1.2-3.8L2 6.5l3.8-1.2z" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linejoin="round"/></svg>',
    folder: '<svg viewBox="0 0 14 14"><path d="M1.5 4.5h3.5l1-1.5h6a1 1 0 011 1v6a1 1 0 01-1 1h-10a1 1 0 01-1-1v-5.5z" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    play: '<svg viewBox="0 0 14 14"><polygon points="3.5,2 11.5,7 3.5,12" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><circle cx="3.5" cy="7" r="1.2" fill="currentColor" stroke="none" opacity="0.3"/></svg>',
    clock: '<svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.2" fill="none"/><line x1="7" y1="7" x2="7" y2="4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="7" y1="7" x2="9.5" y2="8.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>',
    grid: '<svg viewBox="0 0 14 14"><path d="M3.5 2l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2L1 5l2.2-.8z" stroke="currentColor" stroke-width="1" fill="none" stroke-linejoin="round"/><path d="M10.5 8l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z" stroke="currentColor" stroke-width="1" fill="none" stroke-linejoin="round"/></svg>',
    sliders: '<svg viewBox="0 0 14 14"><line x1="2" y1="4" x2="12" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M4 3.5l.5 1.5h-1z" stroke="currentColor" stroke-width="1" fill="none"/><line x1="2" y1="9" x2="12" y2="9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M10 8.5l.5 1.5h-1z" stroke="currentColor" stroke-width="1" fill="none"/></svg>',
    playAlt: '<svg viewBox="0 0 14 14"><polygon points="3,2 12,7 3,12" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    search: '<svg viewBox="0 0 14 14"><circle cx="6" cy="6" r="3.5" stroke="currentColor" stroke-width="1.2" fill="none"/><line x1="9" y1="9" x2="12.5" y2="12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>',
  };

  /* ===== Nav & Recent Data ===== */
  const navData = {
    chat: [
      { icon: 'plus', label: 'New chat', action: 'newChat' },
      { icon: 'folder', label: 'Projects', action: 'toast:Projects (开发中)' },
      { icon: 'play', label: 'Artifacts', action: 'toast:Artifacts (开发中)' },
      { icon: 'sliders', label: 'Customize', action: 'toast:Customize (开发中)' },
    ],
    cowork: [
      { icon: 'plus', label: 'New task', action: 'toast:新任务 (开发中)' },
      { icon: 'folder', label: 'Projects', action: 'toast:Projects (开发中)' },
      { icon: 'clock', label: 'Scheduled', action: 'toast:Scheduled (开发中)' },
      { icon: 'play', label: 'Artifacts', action: 'toast:Artifacts (开发中)' },
      { icon: 'grid', label: 'Dispatch', action: 'toast:Dispatch (开发中)' },
      { icon: 'sliders', label: 'Customize', action: 'toast:Customize (开发中)' },
    ],
    code: [
      { icon: 'plus', label: 'New session', action: 'toast:新 Session (开发中)' },
      { icon: 'playAlt', label: 'Routines', action: 'toast:Routines (开发中)' },
      { icon: 'sliders', label: 'Customize', action: 'toast:Customize (开发中)' },
    ],
  };

  const recentData = {
    chat: [
      { text: '复刻桌面APP UI设计和布局', time: '2h ago' },
    ],
    cowork: [
      { text: 'Summarize this week\'s meetings', ghost: true },
      { text: 'Organize my project files', ghost: true },
      { text: 'Draft the launch plan', ghost: true },
    ],
    code: [
      { text: 'Fix the checkout bug', ghost: true },
      { text: 'Add dark mode support', ghost: true },
      { text: 'Refactor the API client', ghost: true },
    ],
  };

  let currentNav = { chat: 0, cowork: 0, code: 0 };
  let isChatMode = false;
  let currentView = 'chat';

  /* ===== Action Dispatch ===== */
  const actions = {
    newChat() {
      switchView(document.querySelector('.segb[data-view="chat"]'), 'chat');
      isChatMode = false;
      document.getElementById('heroSection').style.display = 'flex';
      const cs = document.getElementById('chatScroll');
      cs.style.display = 'none';
      cs.innerHTML = '';
      document.getElementById('chatInput').value = '';
    },
  };

  function dispatch(action) {
    if (action.startsWith('toast:')) { showToast(action.slice(6)); return; }
    if (actions[action]) { actions[action](); return; }
    showToast('功能开发中: ' + action);
  }

  /* ===== Sidebar Renderer ===== */
  function renderSidebar(tab) {
    const navEl = document.getElementById('navList');
    navEl.innerHTML = navData[tab].map((item, i) => {
      const active = i === currentNav[tab];
      return `<div class="nl${active ? ' on' : ''}" data-index="${i}" onclick="onNavClick('${tab}',${i})">${I[item.icon]}<span>${item.label}</span></div>`;
    }).join('');

    const reEl = document.getElementById('recentList');
    reEl.innerHTML = '<div class="re-h">Recents</div>' + recentData[tab].map(r => {
      if (r.ghost) {
        return `<div class="re-i ghost"><span class="circle"></span><span class="t">${escHtml(r.text)}</span></div>`;
      }
      const timeHtml = r.time ? `<span class="re-time">${r.time}</span>` : '';
      return `<div class="re-i" onclick="dispatch('toast:打开 ${escHtml(r.text)}')"><span class="dot"></span><span class="t">${escHtml(r.text)}</span>${timeHtml}</div>`;
    }).join('');
  }

  function onNavClick(tab, index) {
    currentNav[tab] = index;
    const item = navData[tab][index];
    renderSidebar(tab);
    dispatch(item.action);
  }

  function switchView(el,view){
    document.querySelectorAll('.segb').forEach(b=>b.classList.remove('on'));
    el.classList.add('on');
    currentView=view;
    document.querySelectorAll('.vw-chat,.vw-cowork,.vw-code').forEach(v=>v.style.display='none');
    const map={chat:'viewChat',cowork:'viewCowork',code:'viewCode'};
    const t=document.getElementById(map[view]);
    if(t)t.style.display='flex';
    currentNav[view]=0;
    renderSidebar(view);
  }

  renderSidebar('chat'); // initial render

  function autoResize(el){
    el.style.height='auto';el.style.height=Math.min(el.scrollHeight,100)+'px';
    document.getElementById('sendBtn').disabled=!el.value.trim();
  }
  function handleKey(e){
    if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendMsg();}
  }

  function sendMsg(){
    const inp=document.getElementById('chatInput');
    const txt=inp.value.trim();if(!txt)return;
    if(!isChatMode){
      isChatMode=true;
      document.getElementById('heroSection').style.display='none';
      const cs=document.getElementById('chatScroll');
      cs.style.display='flex';
      cs.innerHTML='';
    }
    const s=document.getElementById('chatScroll');
    const d=new Date();
    const t=`${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
    const u=document.createElement('div');u.className='msg r';
    u.innerHTML=`<div class="ma2"><svg class="icon" viewBox="0 0 14 14"><circle cx="7" cy="4.5" r="2.5" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M2 12.5a5 5 0 0110 0" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg></div><div class="mb">${escHtml(txt)}<div class="mb-t">${t}</div></div>`;
    s.appendChild(u);
    inp.value='';inp.style.height='auto';
    document.getElementById('sendBtn').disabled=true;
    s.scrollTop=s.scrollHeight;
    setTimeout(()=>{
      const a=document.createElement('div');a.className='msg l';
      const rs=[
        'I\'d be happy to help with that! Let me think through it step by step.',
        'Got it. Here\'s what I\'ve come up with based on the context.',
        'Sure thing! I\'ve analyzed your request and here are my thoughts.'
      ];
      a.innerHTML=`<div class="ma2"><svg class="icon" viewBox="0 0 14 14"><rect x="2" y="3" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none"/><circle cx="7" cy="7" r="1.5" stroke="currentColor" stroke-width="1" fill="none"/></svg></div><div class="mb">${rs[Math.floor(Math.random()*rs.length)]}<span class="sc"></span><div class="mb-t">${t}</div></div>`;
      s.appendChild(a);s.scrollTop=s.scrollHeight;
    },600+Math.random()*400);
  }
  function sendSuggestion(t){
    document.getElementById('chatInput').value=t;
    sendMsg();
  }

  function openSettings(){
    showToast('设置面板 (开发中)');
  }

  /* ===== POPOVER & SETTINGS MODAL ===== */
  function togglePopover(e){
    e.stopPropagation();
    document.getElementById('userPopover').classList.toggle('open');
  }
  function closePopover(){
    document.getElementById('userPopover').classList.remove('open');
  }
  document.addEventListener('click',function(e){
    const p=document.getElementById('userPopover');
    const b=document.getElementById('userBar');
    if(p.classList.contains('open')&&!b.contains(e.target))closePopover();
  });

  function openSettingsModal(){
    closePopover();
    openOverlay('overlaySettings');
  }

  function selectSetting(el,section){
    document.querySelectorAll('.st-item').forEach(i=>i.classList.remove('on'));
    el.classList.add('on');
    document.querySelectorAll('.st-section').forEach(s=>s.style.display='none');
    const t=document.getElementById('st'+section.charAt(0).toUpperCase()+section.slice(1));
    if(t)t.style.display='block';
  }

  function toggleTheme(){
    const h=document.documentElement;
    h.setAttribute('data-theme',h.getAttribute('data-theme')==='dark'?'light':'dark');
    showToast('主题已切换');
  }

  function toggleSidebar(){
    document.querySelector('.sb').classList.toggle('collapsed');
  }

  function showToast(msg){
    const e=document.querySelector('.toast');
    if(e)e.remove();
    const t=document.createElement('div');t.className='toast';
    t.textContent=msg;
    t.style.cssText='position:fixed;bottom:50px;left:50%;transform:translateX(-50%);padding:5px 14px;border-radius:8px;font-size:11px;font-weight:500;background:var(--tx);color:var(--bg-base);z-index:300;box-shadow:var(--shadow-lg);opacity:0;transition:opacity 0.2s;pointer-events:none';
    document.body.appendChild(t);
    requestAnimationFrame(()=>t.style.opacity='1');
    clearTimeout(window._tt);
    window._tt=setTimeout(()=>{t.style.opacity='0';setTimeout(()=>t.remove(),200);},1500);
  }
  function escHtml(str){
    if(!str)return'';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
</script>
</body>
</html>
