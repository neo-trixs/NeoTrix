<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>NeoTrix · 液态玻璃</title>
<style>
  :root {
    /* ════════════════════════════════════════════════
       NeoTrix Design System v2 — "Consciousness Glass"
       Layer 1: Base Tokens (raw values)

       核心设计原则: 逆时针 (CCW)
       ─────────────────────────────────
       所有旋转动画统一为逆时针方向，象征:
       · 时间回溯 — 元认知回头看自己
       · 意识自省 — L9 超验层只读不写
       · E8 状态反转 — 推理可逆性
       禁止出现顺时针旋转。
       ════════════════════════════════════════════════ */

    /* ---- Brand Palette ---- */
    --red: #E85454;
    --green: #4CAF50;
    --yellow: #FFC107;
    --pri: #E85454;
    --pri2: #D04040;
    --pri3: #F26B6B;

    /* ---- Neutral Scale ---- */
    --white: #FFFFFF;
    --gray-50: #F5F5F7;
    --gray-100: #E8E8EC;
    --gray-200: #D4D4D8;
    --gray-300: #B0B0B8;
    --gray-400: #909098;
    --gray-500: #707078;
    --gray-600: #5A5A62;
    --gray-700: #3A3A42;
    --gray-800: #2A2A30;
    --gray-900: #1A1A20;
    --black: #0A0A0E;

    /* ---- Semantic Aliases ---- */
    --des: var(--red);
    --suc: var(--green);
    --war: var(--yellow);

    /* ---- Spacing Scale (4px base) ---- */
    --sp-0: 0px;    --sp-1: 2px;    --sp-2: 4px;    --sp-3: 6px;
    --sp-4: 8px;    --sp-5: 10px;   --sp-6: 12px;   --sp-7: 14px;
    --sp-8: 16px;   --sp-10: 20px;  --sp-12: 24px;  --sp-14: 28px;
    --sp-16: 32px;  --sp-20: 40px;  --sp-24: 48px;

    /* ---- Radius Scale ---- */
    --r-xs: 4px;   --r-sm: 8px;    --r-md: 12px;
    --r-lg: 16px;  --r-xl: 20px;   --r-2xl: 24px;

    /* ---- Typography ---- */
    --ff: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Inter", "Noto Sans SC", sans-serif;
    --ff-serif: Georgia, Cambria, "Times New Roman", "Noto Serif SC", serif;
    --fm: "SF Mono", "JetBrains Mono", "Source Code Pro", Menlo, monospace;

    --fs-caption: 10px; --fs-small: 11px; --fs-body: 13px; --fs-body-lg: 14px;
    --fs-heading: 15px; --fs-display: 20px; --fs-hero: 28px;

    --fw-regular: 400; --fw-medium: 500; --fw-semibold: 600; --fw-bold: 700;
    --lh-tight: 1.3; --lh-normal: 1.5; --lh-loose: 1.55; --lh-code: 1.4;

    /* ---- Shadow Map (opacity ∝ depth) ---- */
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.04);
    --shadow-md: 0 4px 16px rgba(0,0,0,0.06);
    --shadow-lg: 0 12px 40px rgba(0,0,0,0.07);
    --shadow-xl: 0 24px 60px rgba(0,0,0,0.08);

    /* ---- Motion ---- */
    --ease-out-expo: cubic-bezier(0.22,1,0.36,1);
    --ease-in-out: cubic-bezier(0.4,0,0.2,1);
    --ease-out: cubic-bezier(0,0,0.2,1);
    --dur-f: 0.15s; --dur-n: 0.25s; --dur-s: 0.4s; --dur-l: 0.6s;
    --tr: var(--dur-n) var(--ease-out-expo);

    /* ════════════════════════════════════════════════
       Layer 2: Semantic Tokens (purpose-bound)
       ════════════════════════════════════════════════ */

    /* ---- Glass Depth System (L0 = deepest, L4 = closest) ---- */
    --glass-L0-bg: rgba(255,255,255,0.30);
    --glass-L0-blur: blur(8px) saturate(160%);

    --glass-L1-bg: rgba(255,255,255,0.40);
    --glass-L1-blur: blur(16px) saturate(180%);

    --glass-L2-bg: rgba(255,255,255,0.50);
    --glass-L2-blur: blur(20px) saturate(200%);

    --glass-L3-bg: rgba(255,255,255,0.62);
    --glass-L3-blur: blur(24px) saturate(200%);

    --glass-L4-bg: rgba(255,255,255,0.75);
    --glass-L4-blur: blur(32px) saturate(220%);

    /* ---- Surface Tokens ---- */
    --bg-base: var(--gray-50);
    --bg-surface: var(--glass-L2-bg);
    --bg-elevated: var(--glass-L2-bg);
    --bg-raised: var(--glass-L3-bg);
    --bg-glass: var(--glass-L2-bg);

    /* ---- Border Tokens ---- */
    --bd: rgba(0,0,0,0.06);       /* subtle */
    --bd2: rgba(0,0,0,0.10);      /* medium */
    --bd-glass: rgba(255,255,255,0.25);  /* specular highlight — glass edge */

    /* ---- Interaction Tokens ---- */
    --ghost: rgba(0,0,0,0.03);
    --ghost-hover: rgba(0,0,0,0.06);
    --accent-bg: rgba(232,84,84,0.08);
    --accent-glow: rgba(232,84,84,0.06);

    /* ---- Text Tokens ---- */
    --tx: var(--gray-900);        /* primary */
    --tx2: var(--gray-600);       /* secondary */
    --tx3: var(--gray-400);       /* tertiary */
    --tx-meta: var(--gray-300);   /* metadata */
    --tx-inverse: var(--white);   /* on primary */

    /* ---- Layout ---- */
    --sw: 260px;

    /* ════════════════════════════════════════════════
       Layer 3: Component Tokens (pre-composed)
       ════════════════════════════════════════════════ */

    --blur-generic: var(--glass-L2-blur);
  }

  [data-theme="dark"] {
    /* ---- Brand Palette (brighter for dark) ---- */
    --red: #FF6B6B;
    --green: #66BB6A;
    --yellow: #FFD54F;
    --pri: #FF6B6B;
    --pri2: #E85555;
    --pri3: #FF8888;

    /* ---- Neutral Scale (inverted) ---- */
    --gray-900: #EDEDED;
    --gray-800: #C0C0C8;
    --gray-700: #A0A0A8;
    --gray-600: #808088;
    --gray-500: #606068;
    --gray-400: #505058;
    --gray-300: #404048;
    --gray-200: #303038;
    --gray-100: #202028;
    --gray-50: #181820;
    --white: #101018;
    --black: #08080E;

    /* ---- Glass Depth — darker base + less transparency ---- */
    --glass-L0-bg: rgba(16,16,24,0.50);
    --glass-L1-bg: rgba(20,20,28,0.55);
    --glass-L2-bg: rgba(26,26,34,0.62);
    --glass-L3-bg: rgba(32,32,42,0.70);
    --glass-L4-bg: rgba(40,40,52,0.80);

    /* ---- Border (lighter for dark) ---- */
    --bd: rgba(255,255,255,0.06);
    --bd2: rgba(255,255,255,0.10);
    --bd-glass: rgba(255,255,255,0.12);

    /* ---- Interaction ---- */
    --ghost: rgba(255,255,255,0.03);
    --ghost-hover: rgba(255,255,255,0.06);
    --accent-bg: rgba(255,107,107,0.10);
    --accent-glow: rgba(255,107,107,0.08);

    /* ---- Shadow (deeper for dark) ---- */
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.3);
    --shadow-md: 0 4px 16px rgba(0,0,0,0.35);
    --shadow-lg: 0 12px 40px rgba(0,0,0,0.4);
    --shadow-xl: 0 24px 60px rgba(0,0,0,0.5);
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  html,body { height:100%; overflow:hidden; }
  body {
    font-family: var(--ff); font-size: var(--fs-body); font-weight: var(--fw-regular);
    line-height: var(--lh-loose); color: var(--tx);
    background: #0B0B12;
    -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    display:flex; align-items:center; justify-content:center; padding:16px;
    position:relative; overflow:hidden;
  }
  body::before {
    content:''; position:fixed; inset:0; z-index:-1;
    background:
      radial-gradient(ellipse 60% 50% at 20% 80%, rgba(232,84,84,0.12) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 85% 20%, rgba(232,84,84,0.08) 0%, transparent 55%),
      radial-gradient(ellipse 40% 40% at 50% 50%, rgba(120,80,200,0.06) 0%, transparent 50%),
      radial-gradient(ellipse 70% 30% at 10% 30%, rgba(255,200,50,0.04) 0%, transparent 50%),
      #0B0B12;
    animation: nebulaDrift 20s ease-in-out infinite alternate;
  }
  @keyframes nebulaDrift {
    0%{ transform:scale(1) rotate(0deg); }
    100%{ transform:scale(1.15) rotate(-3deg); }
  }
  /* Star field */
  body::after {
    content:''; position:fixed; inset:0; z-index:-1;
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1px 1px at 30% 60%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 50% 10%, rgba(255,255,255,0.7) 0%, transparent 100%),
      radial-gradient(1px 1px at 70% 40%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 90% 80%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 15% 85%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1px 1px at 45% 30%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 65% 70%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 25% 15%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 80% 55%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1px 1px at 40% 90%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 95% 25%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 5% 50%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 60% 15%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1px 1px at 75% 90%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 35% 45%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1.5px 1.5px at 88% 10%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 55% 80%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1px 1px at 20% 40%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 72% 60%, rgba(255,255,255,0.5) 0%, transparent 100%);
    animation: starTwinkle 4s ease-in-out infinite alternate;
  }
  @keyframes starTwinkle {
    0%{ opacity:0.6; }
    100%{ opacity:1; }
  }
  [data-theme="dark"] body {
    background: #08080E;
  }
  [data-theme="dark"] body::before {
    background:
      radial-gradient(ellipse 60% 50% at 20% 80%, rgba(255,107,107,0.15) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 85% 20%, rgba(255,107,107,0.10) 0%, transparent 55%),
      radial-gradient(ellipse 40% 40% at 50% 50%, rgba(140,90,220,0.08) 0%, transparent 50%),
      #08080E;
  }
  ::selection { background:var(--pri); color:#fff; }

  .app {
    width:1180px; max-width:calc(100vw - 32px);
    height:760px; max-height:calc(100vh - 32px);
    display:flex; flex-direction:column;
    border-radius:var(--r-xl);
    background: var(--glass-L4-bg);
    backdrop-filter: var(--glass-L4-blur);
    -webkit-backdrop-filter: var(--glass-L4-blur);
    border:1px solid var(--bd-glass);
    box-shadow:
      0 0 0 0.5px rgba(0,0,0,0.02),
      0 8px 32px rgba(0,0,0,0.3),
      inset 0 1px 0 rgba(255,255,255,0.15);
    overflow:hidden; position:relative;
    animation: appDrift 30s ease-in-out infinite alternate;
  }
  @keyframes appDrift {
    0%{ transform:rotate(0deg); }
    100%{ transform:rotate(-0.6deg); }
  }
  .ab { flex:1; display:flex; min-height:0; position:relative; }

  /* ===== SIDEBAR — Liquid Glass ===== */
  .sb {
    width:var(--sw); flex-shrink:0; display:flex; flex-direction:column;
    background: var(--glass-L2-bg);
    backdrop-filter: var(--glass-L2-blur);
    -webkit-backdrop-filter: var(--glass-L2-blur);
    border-right:1px solid var(--bd);
    position:relative;
    box-shadow: inset -1px 0 0 var(--bd-glass);
  }
  .sb-top { padding:14px 14px 0; display:flex; flex-direction:column; gap:14px; }
  .sb-header {
    display:flex; align-items:center; justify-content:flex-end; height:28px;
  }
  .sb-header-actions { display:flex; align-items:center; gap:6px; }

  /* Traffic lights — always visible, no blur */
  .traffic { position:fixed; left:12px; top:14px; display:flex; gap:6px; z-index:150; }
  .t-dot { width:10px; height:10px; border-radius:50%; }
  .t-c { background:#ff5f57; } .t-m { background:#febc2e; } .t-x { background:#28c840; }
  .sbn {
    width:24px; height:24px; display:flex; align-items:center; justify-content:center;
    border-radius:var(--r-sm); border:none; cursor:pointer;
    background:transparent; color:var(--tx3); transition:var(--tr);
  }
  .sbn:hover { background:var(--ghost); color:var(--tx); }
  .sbn svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }

  /* Sidebar Collapse — floating toggle button */
  .sb.collapsed { width:0; min-width:0; overflow:hidden; border-right:none; }
  .sb.collapsed .sb-top,
  .sb.collapsed .sf { display:none; }
  .sb.collapsed + .traffic + .sb-float { opacity:1; pointer-events:auto; }
  .sb.collapsed + .traffic + .sb-float + .ma { border-radius:12px 0 0 12px; }
  .sb-float {
    position:absolute; left:58px; top:14px; z-index:100;
    width:28px; height:28px; border-radius:8px; border:1px solid var(--bd2);
    display:flex; align-items:center; justify-content:center;
    background:var(--glass-L3-bg); backdrop-filter:var(--glass-L2-blur); -webkit-backdrop-filter:var(--glass-L2-blur);
    color:var(--tx2); cursor:pointer; opacity:0; pointer-events:none;
    transition:opacity 0.2s;
  }
  .sb-float:hover { background:var(--ghost); color:var(--tx); }
  .sb-float svg { width:14px; height:14px; }

  /* Segmented Tabs — Icon-only consciousness modes */
  .seg {
    display:flex; padding:3px; border-radius:10px;
    background: var(--glass-L3-bg);
    backdrop-filter: var(--glass-L0-blur);
    -webkit-backdrop-filter: var(--glass-L0-blur);
  }
  .segb {
    flex:1; text-align:center; padding:6px 0; font-size:var(--fs-caption);
    font-weight:var(--fw-medium); color:var(--tx3); border-radius:7px;
    cursor:pointer; transition:var(--tr); border:none; background:transparent; font-family:var(--ff);
    display:flex; align-items:center; justify-content:center; gap:4px;
  }
  .segb:hover { color:var(--tx2); }
  .segb.on {
    background: var(--glass-L3-bg);
    backdrop-filter: var(--glass-L0-blur);
    -webkit-backdrop-filter: var(--glass-L0-blur);
    color:var(--pri); box-shadow:0 0 16px rgba(232,84,84,0.15);
    font-weight:var(--fw-semibold);
    animation: pulseGlow 3s ease-in-out infinite;
  }
  @keyframes pulseGlow {
    0%,100%{ box-shadow:0 0 12px rgba(232,84,84,0.12); }
    50%{ box-shadow:0 0 24px rgba(232,84,84,0.25); }
  }
  [data-theme="dark"] .segb.on {
    background: rgba(232,84,84,0.12);
    box-shadow:0 0 20px rgba(232,84,84,0.08);
  }
  .segb svg { width:16px; height:16px; stroke:currentColor; stroke-linecap:round; stroke-linejoin:round; transition:transform 0.4s cubic-bezier(0.22,1,0.36,1); }
  .segb:hover svg { transform:rotate(-72deg) scale(1.1); }
  .segb.on svg { }

  /* Nav List */
  .nav-list { display:flex; flex-direction:column; gap:1px; }
  .nl {
    display:flex; align-items:center; gap:10px; padding:7px 10px;
    border-radius:var(--r-sm); cursor:pointer; transition:var(--tr);
    font-size:var(--fs-body); font-weight:var(--fw-medium); color:var(--tx2);
    position:relative;
  }
  .nl:hover { background:var(--ghost); color:var(--tx); }
  .nl.on { background:var(--accent-bg); color:var(--pri); font-weight:var(--fw-semibold); }
  .nl.on::before {
    content:''; position:absolute; left:-10px; top:50%; transform:translateY(-50%);
    width:3px; height:18px; border-radius:3px; background:var(--pri);
  }
  .nl svg { width:15px; height:15px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; transition:transform 0.3s ease, stroke-width 0.2s; }
  .nl:hover svg { transform:rotate(-72deg) scale(1.15); }
  .nl.on svg { stroke-width:2.2; }

  /* Recents */
  .re { padding:0 10px; }
  .re-h { font-size:10px; font-weight:var(--fw-semibold); text-transform:uppercase; letter-spacing:0.8px; color:var(--tx-meta); margin-bottom:4px; padding:0 2px; }
  .re-i {
    display:flex; align-items:center; gap:8px; padding:6px 6px;
    border-radius:var(--r-sm); cursor:pointer; transition:var(--tr);
    font-size:var(--fs-small); color:var(--tx2);
  }
  .re-i:hover { background:var(--ghost); color:var(--tx); }
  .re-i.ghost { opacity:0.45; cursor:default; pointer-events:none; }
  .re-i.ghost .t { font-style:italic; }
  .re-i .dot { width:4px; height:4px; border-radius:50%; background:var(--pri); flex-shrink:0; }
  .re-i .circle { width:6px; height:6px; border-radius:50%; border:1.5px solid var(--tx-meta); flex-shrink:0; }
  .re-i .t { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .re-time { font-size:9px; color:var(--tx3); flex-shrink:0; }

  /* User Bar — Liquid Glass */
  .sf {
    padding:8px 10px; display:flex; align-items:center; gap:8px;
    border-top:1px solid var(--bd);
    background: var(--glass-L2-bg);
    backdrop-filter: var(--glass-L2-blur);
    -webkit-backdrop-filter: var(--glass-L2-blur);
    margin-top:auto;
    box-shadow: inset 0 1px 0 var(--bd-glass);
  }
  .sa {
    width:24px; height:24px; border-radius:6px;
    background:linear-gradient(135deg,var(--pri),var(--pri2));
    display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:var(--fw-bold);
    color:#fff; flex-shrink:0;
  }
  .su-info { flex:1; min-width:0; }
  .su-name { font-size:var(--fs-body); font-weight:var(--fw-medium); color:var(--tx); }
  .su-plan { font-size:9px; color:var(--tx-meta); }
  .sf-actions { display:flex; align-items:center; gap:2px; }
  .sf-btn {
    width:26px; height:26px; display:flex; align-items:center; justify-content:center;
    border-radius:var(--r-sm); border:none; cursor:pointer;
    background:transparent; color:var(--tx3); transition:var(--tr);
  }
  .sf-btn:hover { background:var(--ghost); color:var(--tx); }
  .sf-btn svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }

  /* ===== MAIN — Liquid Glass ===== */
  .ma { flex:1; display:flex; flex-direction:column; min-width:0;
    background: var(--glass-L1-bg); backdrop-filter: var(--glass-L1-blur);
    -webkit-backdrop-filter: var(--glass-L1-blur); position:relative; }

  /* ===== VIEW: 对话 (Chat) ===== */
  .vw-chat { flex:1; display:flex; flex-direction:column; align-items:center; }
  .vw-chat .wc-inner { max-width:640px; width:100%; display:flex; flex-direction:column; align-items:center; gap:24px; padding:40px 24px; flex:1; justify-content:center; }
  .hero { display:flex; align-items:center; gap:14px; }
  .hero-svg { width:36px; height:36px; flex-shrink:0; }
  .hero-svg svg { width:36px; height:36px; animation: heroPulse 4s ease-in-out infinite; }
  @keyframes heroPulse {
    0%,100%{ filter:drop-shadow(0 0 6px rgba(232,84,84,0.2)) drop-shadow(0 0 12px rgba(232,84,84,0.1)); transform:scale(1) rotate(0deg); }
    50%{ filter:drop-shadow(0 0 12px rgba(232,84,84,0.35)) drop-shadow(0 0 24px rgba(232,84,84,0.15)); transform:scale(1.04) rotate(-8deg); }
  }
  .hero h1 { font-family:var(--ff-serif); font-size:var(--fs-hero); font-weight:var(--fw-medium); letter-spacing:-0.02em; color:var(--tx); line-height:var(--lh-tight); }

  .cic { width:100%; border-radius:var(--r-2xl); padding:16px;
    background: var(--glass-L2-bg); backdrop-filter: var(--glass-L2-blur);
    -webkit-backdrop-filter: var(--glass-L2-blur);
    border:1px solid var(--bd2); box-shadow:var(--shadow-sm); transition:var(--tr); display:flex; flex-direction:column; gap:12px; }
  .cic:focus-within { border-color:var(--bd2); box-shadow:var(--shadow-md); }
  .cic textarea { width:100%; background:transparent; border:none; outline:none; resize:none; font-family:var(--ff); font-size:var(--fs-body-lg); line-height:var(--lh-normal); color:var(--tx); min-height:64px; padding:2px 2px; }
  .cic textarea::placeholder { color:var(--tx3); }
  .cic-actions { display:flex; align-items:center; justify-content:space-between; }
  .cic-left { display:flex; align-items:center; }
  .cic-attach { width:32px; height:32px; display:flex; align-items:center; justify-content:center; border-radius:50%; cursor:pointer; transition:var(--tr); color:var(--tx3); border:none; background:transparent; }
  .cic-attach:hover { background:var(--ghost); color:var(--tx); }
  .cic-attach svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
  .cic-right { display:flex; align-items:center; gap:6px; }
  .vc-btn {
    width:34px; height:34px; display:flex; align-items:center; justify-content:center;
    border-radius:50%; cursor:pointer; transition:var(--tr);
    border:none; background:transparent; color:var(--tx3); position:relative;
  }
  .vc-btn:hover { background:var(--ghost); color:var(--tx2); }
  .vc-btn svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .vc-lang svg { stroke-width:1.6; }
  .vc-send {
    background:var(--bg-raised); border:1px solid var(--bd);
    width:36px; height:36px;
  }
  .vc-send:hover { background:var(--pri); border-color:var(--pri); color:#fff; }
  .vc-send:disabled { opacity:0.3; cursor:default; }
  .vc-send svg { width:18px; height:14px; stroke-width:2; transition:opacity 0.3s, transform 0.3s; }
  .vc-send .s-mic { position:absolute; }
  .vc-send .s-wav { opacity:0; transform:scale(0.6); }
  .vc-send:hover .s-mic { opacity:0; transform:scale(0.6) rotate(-15deg); }
  .vc-send:hover .s-wav { opacity:1; transform:scale(1); }
  .qa { display:flex; flex-wrap:wrap; gap:6px; justify-content:center; }
  .qa-btn { display:flex; align-items:center; gap:5px; padding:6px 14px; border-radius:20px; font-size:var(--fs-small); font-weight:var(--fw-medium); background:transparent; border:1px solid var(--bd); cursor:pointer; color:var(--tx3); transition:var(--tr); font-family:var(--ff); }
  .qa-btn:hover { background:var(--ghost); border-color:var(--tx3); color:var(--tx); }
  .qa-btn svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }

  /* Chat messages */
  .cs { flex:1; overflow-y:auto; padding:16px 24px; display:none; flex-direction:column; gap:14px; width:100%; }
  .msg { display:flex; gap:10px; max-width:78%; animation:fi 0.25s ease-out; }
  .msg.r { align-self:flex-end; flex-direction:row-reverse; }
  .msg.l { align-self:flex-start; }
  .msg.c { align-self:center; }
  .ma2 { width:28px; height:28px; border-radius:8px; flex-shrink:0; display:flex; align-items:center; justify-content:center; margin-top:4px; }
  .msg.r .ma2 { background:linear-gradient(135deg,var(--pri),var(--pri2)); }
  .msg.r .ma2 svg { color:#fff; }
  .msg.l .ma2 { background:var(--ghost); }
  .msg.l .ma2 svg { color:var(--pri); }
  .mb { padding:10px 16px; border-radius:var(--r-lg); font-size:var(--fs-body); font-weight:var(--fw-regular); line-height:var(--lh-loose); position:relative; }
  .msg.r .mb { background:linear-gradient(135deg,var(--pri),var(--pri2)); color:#fff; }
  .msg.l .mb { background:var(--glass-L1-bg); backdrop-filter:var(--glass-L1-blur); -webkit-backdrop-filter:var(--glass-L1-blur); border:1px solid var(--bd); }
  .mb code { background:rgba(0,0,0,0.15); padding:1px 6px; border-radius:4px; font-family:var(--fm); font-size:var(--fs-small); }
  .msg.l .mb code { background:var(--bg-raised); color:var(--tx); }
  .mb-t { font-size:var(--fs-caption); opacity:0.35; margin-top:4px; }
  .sc { display:inline-block; width:2px; height:13px; background:var(--pri); animation:bl 0.8s step-end infinite; vertical-align:middle; margin-left:2px; }

  /* ===== VIEW: Chat — Top Bar ===== */
  .ch-top { display:flex; align-items:center; justify-content:flex-end; padding:10px 20px; gap:8px; flex-shrink:0; }
  .ch-upgrade { padding:3px 12px; border-radius:20px; font-size:var(--fs-caption); color:var(--tx3); border:1px solid var(--bd); cursor:pointer; background:var(--glass-L2-bg); backdrop-filter:var(--glass-L2-blur); -webkit-backdrop-filter:var(--glass-L2-blur); transition:var(--tr); font-family:var(--ff); }
  .ch-upgrade:hover { background:var(--ghost-hover); color:var(--tx); border-color:var(--bd2); }
  .ch-icon-btn { width:24px; height:24px; display:flex; align-items:center; justify-content:center; color:var(--tx3); border:none; background:none; cursor:pointer; border-radius:4px; transition:var(--tr); }
  .ch-icon-btn:hover { color:var(--tx); }
  .ch-icon-btn svg { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }

  /* ===== VIEW: Cowork — Onboarding Card ===== */
  .vw-cowork { flex:1; display:none; align-items:center; justify-content:center; }
  .onboard-center { display:flex; flex-direction:column; align-items:center; gap:18px; max-width:420px; text-align:center; }
  .onboard-card { width:100%; border-radius:var(--r-2xl); padding:40px 32px; background:var(--glass-L3-bg); backdrop-filter:var(--glass-L3-blur); -webkit-backdrop-filter:var(--glass-L3-blur); border:1px solid var(--bd2); box-shadow:var(--shadow-md); display:flex; align-items:center; justify-content:center; }
  .onboard-toggle { display:flex; align-items:center; gap:10px; }
  .ot-off { font-size:var(--fs-display); font-weight:var(--fw-medium); color:var(--tx3); font-family:var(--ff-serif); }
  .ot-on { font-size:var(--fs-display); font-weight:var(--fw-semibold); color:var(--pri); font-family:var(--ff-serif); }
  .ot-divider { display:flex; align-items:center; }
  .onboard-title { font-family:var(--ff-serif); font-size:var(--fs-display); font-weight:var(--fw-bold); color:var(--tx); line-height:var(--lh-tight); }
  .onboard-desc { font-size:var(--fs-body); color:var(--tx3); line-height:var(--lh-normal); max-width:360px; }
  .onboard-btn { padding:8px 24px; border-radius:var(--r-md); font-size:var(--fs-body); font-weight:var(--fw-semibold); border:none; cursor:pointer; background:var(--tx); color:var(--bg-base); transition:var(--tr); font-family:var(--ff); }
  .onboard-btn:hover { opacity:0.85; }

  /* ===== VIEW: Code — Onboarding Card ===== */
  .vw-code { flex:1; display:none; align-items:center; justify-content:center; }
  .oc-code { background:var(--glass-L3-bg); }
  .oc-thumb { width:100%; border-radius:var(--r-lg); overflow:hidden; background:#0E0C0A; border:1px solid var(--bd); }
  .oct-top { display:flex; align-items:center; gap:6px; padding:8px 12px; background:rgba(255,255,255,0.04); border-bottom:1px solid rgba(255,255,255,0.06); }
  .oct-dot { width:8px; height:8px; border-radius:50%; }
  .oct-lbl { font-size:var(--fs-caption); color:var(--tx3); font-family:var(--fm); margin-left:6px; }
  .oct-body { padding:14px 16px; font-family:var(--fm); font-size:11px; line-height:1.6; color:var(--tx2); position:relative; min-height:100px; }
  .oct-body .kw { color:var(--des); }
  .oct-body .fn { color:var(--suc); }
  .oct-body .hl { color:var(--pri); }
  .oct-inv { position:absolute; bottom:12px; right:14px; font-size:22px; opacity:0.5; }

  /* ===== RECENTS NEW STYLES ===== */

  .pipeline-item { display:flex; align-items:center; justify-content:space-between; padding:6px 8px; border-radius:var(--r-sm); font-size:var(--fs-small); }
  .pipeline-item:hover { background:var(--ghost); }
  .pipeline-item .s { color:var(--tx2); }
  .pipeline-item .st { font-family:var(--fm); font-size:var(--fs-caption); }
  .pipeline-item .st.ok { color:var(--suc); }
  .pipeline-item .st.run { color:var(--pri); }
  .pipeline-item .st.pen { color:var(--tx-meta); }

  /* ===== OVERLAY PANELS ===== */
  .overlay-panel {
    position:fixed; inset:0; z-index:200;
    display:none; align-items:center; justify-content:center;
    background:rgba(0,0,0,0.5); backdrop-filter:blur(8px);
    animation:fo 0.15s ease-out;
  }
  .overlay-panel.open { display:flex; }
  .overlay-box {
    width:520px; max-width:calc(100vw - 60px); max-height:calc(100vh - 60px);
    display:flex; flex-direction:column; border-radius:var(--r-xl);
    background:var(--glass-L4-bg); backdrop-filter:var(--glass-L4-blur);
    -webkit-backdrop-filter:var(--glass-L4-blur);
    border:1px solid var(--bd-glass);
    box-shadow:0 0 0 0.5px rgba(0,0,0,0.02), 0 16px 48px rgba(0,0,0,0.15);
    animation:mo 0.25s ease-out; overflow:hidden;
  }
  .overlay-h { display:flex; align-items:center; justify-content:space-between; padding:16px 20px; flex-shrink:0; border-bottom:1px solid var(--bd); }
  .overlay-h h2 { font-size:var(--fs-heading); font-weight:var(--fw-semibold); color:var(--tx); }
  .overlay-h .close { width:28px; height:28px; display:flex; align-items:center; justify-content:center; border-radius:50%; border:none; cursor:pointer; background:transparent; color:var(--tx3); transition:var(--tr); }
  .overlay-h .close:hover { background:var(--ghost); color:var(--tx); }
  .overlay-h .close svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
  .overlay-bd { flex:1; overflow-y:auto; padding:16px 20px; }

  /* ===== POPOVER MENU ===== */
  .popover {
    display:none; position:absolute; bottom:calc(100% + 8px); left:0; z-index:300;
  }
  .popover.open { display:block; }
  .popover-card {
    width:256px; padding:8px; border-radius:16px;
    background:var(--glass-L4-bg); backdrop-filter:var(--glass-L4-blur);
    -webkit-backdrop-filter:var(--glass-L4-blur);
    border:1px solid var(--bd2); box-shadow:0 8px 32px rgba(0,0,0,0.12);
    display:flex; flex-direction:column; gap:2px;
  }
  .pop-hd { display:flex; align-items:center; gap:10px; padding:8px 8px 6px 8px; }
  .pop-av { width:36px; height:36px; border-radius:50%; background:var(--ghost); display:flex; align-items:center; justify-content:center; font-weight:var(--fw-semibold); color:var(--tx); border:1px solid var(--bd); flex-shrink:0; }
  .pop-info { display:flex; flex-direction:column; }
  .pop-name { font-size:var(--fs-small); font-weight:var(--fw-semibold); color:var(--tx); line-height:1.3; }
  .pop-email { font-size:var(--fs-caption); color:var(--tx3); line-height:1.3; }
  .pop-sep { height:1px; background:var(--bd); margin:4px 8px; }
  .pop-item {
    display:flex; align-items:center; gap:10px; width:100%; padding:8px 10px; border:none; border-radius:10px;
    background:transparent; color:var(--tx2); font-size:var(--fs-small); font-family:var(--ff);
    cursor:pointer; text-align:left; transition:var(--tr);
  }
  .pop-item:hover { background:var(--ghost); }
  .pop-item svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }
  .pop-shortcut { margin-left:auto; font-size:var(--fs-caption); color:var(--tx3); font-family:var(--fm); }
  .pop-chev { margin-left:auto; color:var(--tx3); }
  .pop-logout { color:var(--tx3); }
  .pop-logout:hover { color:var(--red); background:rgba(232,84,84,0.08); }

  /* ===== SETTINGS MODAL ===== */
  .st-modal {
    width:720px; max-width:calc(100vw - 60px); height:560px; max-height:calc(100vh - 60px);
    display:flex; border-radius:20px; overflow:hidden;
    background:var(--glass-L4-bg); backdrop-filter:var(--glass-L4-blur);
    -webkit-backdrop-filter:var(--glass-L4-blur);
    border:1px solid var(--bd-glass);
    box-shadow:0 0 0 0.5px rgba(0,0,0,0.02), 0 16px 48px rgba(0,0,0,0.15);
    animation:mo 0.25s ease-out; overflow:hidden;
  }
  .st-sidebar {
    width:200px; flex-shrink:0; padding:16px 12px; display:flex; flex-direction:column; gap:4px;
    border-right:1px solid var(--bd); background:rgba(0,0,0,0.02);
  }
  .st-search {
    position:relative; display:flex; align-items:center; margin-bottom:8px;
  }
  .st-search svg { position:absolute; left:10px; width:13px; height:13px; fill:none; stroke:var(--tx3); stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; pointer-events:none; }
  .st-search input {
    width:100%; padding:7px 10px 7px 30px; border-radius:10px; border:1px solid var(--bd);
    background:var(--glass-L1-bg); font-size:var(--fs-caption); font-family:var(--ff);
    color:var(--tx); outline:none; transition:var(--tr);
  }
  .st-search input:focus { border-color:var(--tx-meta); }
  .st-search input::placeholder { color:var(--tx3); }
  .st-kbd {
    position:absolute; right:8px; font-size:10px; font-family:var(--fm); color:var(--tx3);
    padding:1px 5px; border-radius:4px; border:1px solid var(--bd); background:var(--glass-L1-bg);
    pointer-events:none;
  }
  .st-grp {
    font-size:10px; font-weight:var(--fw-semibold); text-transform:uppercase; letter-spacing:0.8px;
    color:var(--tx3); padding:12px 10px 4px 10px;
  }
  .st-item {
    display:flex; align-items:center; gap:8px; padding:7px 10px; border-radius:8px;
    font-size:var(--fs-caption); color:var(--tx2); cursor:pointer; transition:var(--tr);
  }
  .st-item:hover { background:var(--ghost); }
  .st-item.on { background:var(--ghost); color:var(--tx); font-weight:var(--fw-medium); }
  .st-item svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }
  .st-content { flex:1; display:flex; flex-direction:column; overflow:hidden; }
  .st-top { display:flex; align-items:center; justify-content:space-between; padding:16px 24px; flex-shrink:0; }
  .st-title { font-size:var(--fs-heading); font-weight:var(--fw-semibold); color:var(--tx); }
  .st-body { flex:1; overflow-y:auto; padding:0 24px 24px 24px; }
  .st-section { display:none; } .st-section:first-of-type { display:block; }
  .st-h2 { font-size:var(--fs-large); font-weight:var(--fw-semibold); color:var(--tx); margin-bottom:16px; }
  .st-card {
    border-radius:14px; border:1px solid var(--bd); background:var(--glass-L1-bg);
    backdrop-filter:var(--glass-L1-blur); -webkit-backdrop-filter:var(--glass-L1-blur);
    padding:14px 16px; margin-bottom:20px;
  }
  .st-card-row { display:flex; align-items:center; justify-content:space-between; }
  .st-card-info { display:flex; flex-direction:column; gap:2px; }
  .st-lbl { font-size:var(--fs-small); font-weight:var(--fw-semibold); color:var(--tx); }
  .st-desc { font-size:var(--fs-caption); color:var(--tx3); line-height:1.4; }
  .st-av { width:40px; height:40px; border-radius:50%; background:var(--ghost); display:flex; align-items:center; justify-content:center; font-weight:var(--fw-bold); color:var(--tx); border:1px solid var(--bd); flex-shrink:0; }
  .st-field { margin-bottom:16px; }
  .st-field .st-lbl { display:block; margin-bottom:5px; font-size:var(--fs-caption); }
  .st-input {
    width:100%; padding:9px 14px; border-radius:12px; border:1px solid var(--bd);
    background:var(--glass-L1-bg); font-size:var(--fs-small); font-family:var(--ff);
    color:var(--tx); outline:none; transition:var(--tr); box-sizing:border-box;
  }
  .st-input:focus { border-color:var(--tx-meta); box-shadow:0 0 0 3px rgba(0,0,0,0.04); }
  .st-input::placeholder { color:var(--tx3); }
  select.st-input { appearance:none; -webkit-appearance:none; background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 8 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 3l2 2 2-2' fill='none' stroke='%23999' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); background-repeat:no-repeat; background-position:right 12px center; background-size:10px; padding-right:32px; cursor:pointer; }

  /* ════════════════════════════════════════════════
     Accessibility: Reduce Transparency Fallback
     — solidifies all glass surfaces to opaque with
       semantic borders (WCAG 4.5:1 minimum)
     ════════════════════════════════════════════════ */
  @media (prefers-reduced-transparency: reduce) {
    .app { background: var(--bg-base); backdrop-filter: none; -webkit-backdrop-filter: none; border-color: var(--bd2); box-shadow: var(--shadow-md); }
    .sb { background: var(--bg-base); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .ma { background: var(--gray-50); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .sf { background: var(--gray-100); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .seg { background: var(--gray-100); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .segb.on { background: var(--accent-bg); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .cic { background: var(--white); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .popover-card { background: var(--white); backdrop-filter: none; -webkit-backdrop-filter: none; border-color: var(--bd2); }
    .overlay-box { background: var(--white); backdrop-filter: none; -webkit-backdrop-filter: none; border-color: var(--bd2); }
    .st-modal { background: var(--white); backdrop-filter: none; -webkit-backdrop-filter: none; border-color: var(--bd2); }
    .onboard-card { background: var(--white); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .ch-upgrade { background: var(--gray-50); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .sb-float { background: var(--gray-100); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .msg.l .mb { background: var(--gray-50); backdrop-filter: none; -webkit-backdrop-filter: none; }
    .overlay-panel { background: rgba(0,0,0,0.6); backdrop-filter: none; -webkit-backdrop-filter: none; }
    [data-theme="dark"] .ma { background: var(--gray-50); }
    [data-theme="dark"] .popover-card { background: var(--gray-100); }
    [data-theme="dark"] .overlay-box { background: var(--gray-100); }
    [data-theme="dark"] .st-modal { background: var(--gray-100); }
    [data-theme="dark"] .app { background: var(--gray-50); }
    [data-theme="dark"] .sb { background: var(--gray-50); }
    [data-theme="dark"] .cic { background: var(--gray-100); }
    [data-theme="dark"] .onboard-card { background: var(--gray-100); }
  }

  /* Reduced motion — disable animations, keep transitions functional */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.1s !important;
    }
  }

  @keyframes fi { from{opacity:0;transform:translateY(4px)} to{opacity:1;transform:translateY(0)} }
  @keyframes bl { 0%,100%{opacity:1} 50%{opacity:0} }
  @keyframes fo { from{opacity:0} to{opacity:1} }
  @keyframes mo { from{opacity:0;transform:scale(0.96)} to{opacity:1;transform:scale(1)} }

  ::-webkit-scrollbar { width:4px; }
  ::-webkit-scrollbar-thumb { background:var(--tx-meta); border-radius:4px; }
  ::-webkit-scrollbar-thumb:hover { background:var(--tx3); }

  /* 五色辅助类: 红白黑绿黄 */
  .c-red { color:var(--red); } .c-white { color:#fff; } .c-black { color:#1A1A1A; } .c-green { color:var(--green); } .c-yellow { color:var(--yellow); }
  .bg-red { background:var(--red); } .bg-green { background:var(--green); } .bg-yellow { background:var(--yellow); }

</style>
</head>
<body>
<div class="app">
  <div class="ab">

    <!-- ═══ SIDEBAR ═══ -->
    <aside class="sb" id="sidebar">
      <div class="sb-top">
        <!-- Window Header -->
        <div class="sb-header">
          <div class="sb-header-actions">
            <button class="sbn" id="sidebarToggle" onclick="toggleSidebar()">
              <svg viewBox="0 0 14 14"><line x1="10" y1="3" x2="10" y2="11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><polyline points="7,5 5,7 7,9" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button class="sbn" onclick="showToast('搜索 (开发中)')">
              <svg viewBox="0 0 14 14"><circle cx="6" cy="6" r="3.5" stroke="currentColor" stroke-width="1.2" fill="none"/><line x1="9" y1="9" x2="12.5" y2="12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            </button>
          </div>
        </div>

        <!-- Segmented Control — icon-only consciousness modes -->
        <div class="seg">
          <button class="segb on" data-view="chat" onclick="switchView(this,'chat')">
            <svg viewBox="0 0 16 16"><path d="M8 2l1.8 4.2L14 8l-4.2 1.8L8 14l-1.8-4.2L2 8l4.2-1.8z" stroke="currentColor" stroke-width="1" fill="none" stroke-linejoin="round"/><circle cx="8" cy="8" r="1.5" fill="currentColor" stroke="none"/></svg>
            对话
          </button>
          <button class="segb" data-view="cowork" onclick="switchView(this,'cowork')">
            <svg viewBox="0 0 16 16"><path d="M6 3l1.2 2.8L10 7l-2.8 1.2L6 11l-1.2-2.8L2 7l2.8-1.2z" stroke="currentColor" stroke-width="1" fill="none" stroke-linejoin="round"/><path d="M10 7.5l1.2 2.8L14 11l-2.8 1.2L10 15l-1.2-2.8L6 11l2.8-1.2z" stroke="currentColor" stroke-width="0.8" fill="none" stroke-linejoin="round" opacity="0.45"/></svg>
            团队
          </button>
          <button class="segb" data-view="code" onclick="switchView(this,'code')">
            <svg viewBox="0 0 16 16"><polygon points="8,2 13,5.5 13,10.5 8,14 3,10.5 3,5.5" stroke="currentColor" stroke-width="1" fill="none" stroke-linejoin="round"/><line x1="8" y1="5" x2="8" y2="11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            代码
          </button>
        </div>

        <!-- Dynamic Nav List -->
        <div class="nav-list" id="navList"></div>

        <!-- Dynamic Recents -->
        <div class="re" id="recentList"></div>
      </div>

      <!-- User Bar — click avatar for popover menu -->
      <div class="sf" id="userBar">
        <div class="sa" onclick="togglePopover(event)" style="cursor:pointer">N</div>
        <div class="su-info" onclick="togglePopover(event)" style="cursor:pointer">
          <div class="su-name">neotrix</div>
          <div class="su-plan">dolpinsy@gmail.com</div>
        </div>
        <div class="sf-actions">
          <button class="sf-btn" onclick="openSettingsModal()">
            <svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="2.5" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M7 1.5v2M7 10.5v2M1.5 7h2M10.5 7h2M3.5 3.5l1.4 1.4M9.1 9.1l1.4 1.4M3.5 10.5l1.4-1.4M9.1 4.9l1.4-1.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
          </button>
        </div>

        <!-- User Popover Menu -->
        <div class="popover" id="userPopover">
          <div class="popover-card">
            <div class="pop-hd">
              <div class="pop-av">N</div>
              <div class="pop-info">
                <div class="pop-name">neotrix</div>
                <div class="pop-email">dolpinsy@gmail.com</div>
              </div>
            </div>
            <div class="pop-sep"></div>
            <button class="pop-item" onclick="openSettingsModal();closePopover()"><svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="2.5" stroke="currentColor" stroke-width="1" fill="none"/><line x1="7" y1="1.5" x2="7" y2="3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="7" y1="10.5" x2="7" y2="12.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="1.5" y1="7" x2="3.5" y2="7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="10.5" y1="7" x2="12.5" y2="7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>Settings<span class="pop-shortcut">⌘,</span></button>
            <button class="pop-item"><svg viewBox="0 0 14 14"><path d="M7 2A5 5 0 102 7" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/><polygon points="7,2 10,4 7,6" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>Language<svg class="pop-chev" viewBox="0 0 8 8"><line x1="3" y1="2" x2="6" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="3" y1="6" x2="6" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></button>
            <button class="pop-item"><svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1" fill="none"/><line x1="7" y1="7" x2="7" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><circle cx="7" cy="10" r=".5" stroke="currentColor" stroke-width="1" fill="none"/></svg>Get help</button>
            <div class="pop-sep"></div>
            <button class="pop-item"><svg viewBox="0 0 14 14"><line x1="7" y1="1.5" x2="7" y2="12.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="2" y1="7" x2="12" y2="7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>Upgrade plan</button>
            <button class="pop-item"><svg viewBox="0 0 14 14"><line x1="7" y1="2" x2="7" y2="12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><polyline points="4,9 7,12 10,9" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>Get apps and extensions</button>
            <button class="pop-item"><svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1" fill="none"/><line x1="7" y1="6" x2="7" y2="9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><circle cx="7" cy="4.5" r=".5" stroke="currentColor" stroke-width="1" fill="none"/></svg>Learn more<svg class="pop-chev" viewBox="0 0 8 8"><line x1="3" y1="2" x2="6" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="3" y1="6" x2="6" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></button>
            <div class="pop-sep"></div>
            <button class="pop-item pop-logout"><svg viewBox="0 0 14 14"><line x1="7" y1="2" x2="7" y2="8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><polyline points="4,5 7,8 10,5" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><line x1="2.5" y1="10" x2="11.5" y2="10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>Log out</button>
          </div>
        </div>
      </div>
    </aside>

    <!-- Traffic lights — always visible, no glass -->
    <div class="traffic">
      <span class="t-dot t-c"></span>
      <span class="t-dot t-m"></span>
      <span class="t-dot t-x"></span>
    </div>

    <!-- Floating toggle for collapsed sidebar -->
    <button class="sb-float" id="sidebarFloat" onclick="toggleSidebar()">
      <svg viewBox="0 0 14 14"><line x1="10" y1="3" x2="10" y2="11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><polyline points="7,5 5,7 7,9" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <!-- ═══ MAIN ═══ -->
    <main class="ma">



      <!-- ═══ VIEW: Chat (对话) ═══ -->
      <div class="vw-chat" id="viewChat">
        <div class="ch-top">
          <button class="ch-upgrade">Free plan <span style="font-weight:var(--fw-semibold)">• Upgrade</span></button>
          <button class="ch-icon-btn"><svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.2" fill="none"/><line x1="7" y1="7" x2="7" y2="4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="7" y1="7" x2="9.5" y2="8.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></button>
        </div>
        <div class="wc-inner" id="heroSection">
          <div class="hero">
            <div class="hero-svg">
              <svg viewBox="0 0 32 32" fill="none">
                <path d="M16 2l4 8 8 4-8 4-4 8-4-8-8-4 8-4 4-8z" fill="var(--pri)" opacity="0.25"/>
                <path d="M16 6l2.5 5 5.5 2.5-5.5 2.5-2.5 5-2.5-5L8 13.5l5.5-2.5 2.5-5z" fill="var(--pri)"/>
                <circle cx="16" cy="13.5" r="2.5" fill="var(--pri)" stroke="none"/>
                <circle cx="16" cy="13.5" r="1" fill="#fff" stroke="none"/>
                <path d="M4 20q4-4 8 0t8-8 8 4" stroke="var(--pri2)" stroke-width="0.8" stroke-linecap="round" opacity="0.4" fill="none"/>
              </svg>
            </div>
            <h1>Good afternoon, Neo</h1>
          </div>
          <div class="cic">
            <textarea id="chatInput" rows="2" placeholder="Type / for skills" oninput="autoResize(this)" onkeydown="handleKey(event)"></textarea>
            <div class="cic-actions">
              <div class="cic-left">
                <button class="cic-attach"><svg viewBox="0 0 16 16"><line x1="8" y1="3" x2="8" y2="11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="4" y1="8" x2="12" y2="8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button>
              </div>
              <div class="cic-right">
                <button class="vc-btn vc-lang" onclick="showToast('🎤 语音输入已开启')" title="语音输入">
                  <svg viewBox="0 0 16 16"><rect x="5.5" y="2" width="5" height="7" rx="2.5" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M3 7v.5a5 5 0 0010 0V7" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/><line x1="8" y1="12" x2="8" y2="14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="5" y1="14" x2="11" y2="14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                </button>
                <button class="vc-btn vc-send" id="sendBtn" disabled onclick="sendMsg()" title="发送">
                  <svg class="s-mic" viewBox="0 0 18 14"><path d="M5 5v2a4 4 0 008 0V5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/><line x1="9" y1="11" x2="9" y2="13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="3" y1="13" x2="15" y2="13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><rect x="6" y="2" width="6" height="5" rx="3" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>
                  <svg class="s-wav" viewBox="0 0 18 14"><line x1="3" y1="10" x2="3" y2="4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="7" y1="12" x2="7" y2="2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="11" y1="11" x2="11" y2="3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="15" y1="9" x2="15" y2="5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>
        <div class="cs" id="chatScroll" style="display:none"></div>
      </div>

      <!-- ═══ VIEW: Cowork (协同助理) ═══ -->
      <div class="vw-cowork" id="viewCowork">
        <div class="onboard-center">
          <div class="onboard-card">
            <div class="onboard-toggle">
              <span class="ot-off">Chat</span>
              <span class="ot-divider"><svg width="40" height="20" viewBox="0 0 40 20"><rect x="0" y="4" width="40" height="12" rx="6" fill="var(--bd2)"/><circle cx="28" cy="10" r="5" fill="var(--pri)"/></svg></span>
              <span class="ot-on">Cowork</span>
            </div>
          </div>
          <h2 class="onboard-title">Power through tedious tasks</h2>
          <p class="onboard-desc">Cowork lets Claude complete work in the background. Describe what you need and come back to finished work.</p>
          <button class="onboard-btn" onclick="showToast('Cowork 初始化 (开发中)')">Get Cowork</button>
        </div>
      </div>

      <!-- ═══ VIEW: Code (代码开发) ═══ -->
      <div class="vw-code" id="viewCode">
        <div class="onboard-center">
          <div class="onboard-card oc-code">
            <div class="oc-thumb">
              <div class="oct-top"><span class="oct-dot" style="background:#ff5f57"></span><span class="oct-dot" style="background:#febc2e"></span><span class="oct-dot" style="background:#28c840"></span><span class="oct-lbl">engine_core.rs</span></div>
              <div class="oct-body">
                <span class="kw">pub struct</span> <span class="fn">ReasoningEngine</span> {<br/>
                <span class="hl">  gateway: Arc&lt;GatewayV2&gt;</span>,<br/>
                e8_state: <span class="fn">E8State</span>,<br/>
                confidence: f64,<br/>
                }<br/>
                <span class="oct-inv">👾</span>
              </div>
            </div>
          </div>
          <h2 class="onboard-title">Ship features, not lines</h2>
          <p class="onboard-desc">Run parallel sessions on your real codebase — each with its own terminal, editor, and preview — so you can take a change from idea to merged.</p>
          <button class="onboard-btn" onclick="showToast('Claude Code 初始化 (开发中)')">Get Claude Code</button>
        </div>
      </div>

<!-- ═══ OVERLAY: 能力注册表 ═══ -->
