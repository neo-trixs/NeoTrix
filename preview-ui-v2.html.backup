<!-- ═══ OVERLAY: 设置面板 (Settings Modal) ═══ -->
<div class="overlay-panel" id="overlaySettings">
  <div class="st-modal">
    <div class="st-sidebar">
      <div class="st-search">
        <svg viewBox="0 0 14 14"><circle cx="6" cy="6" r="4" stroke="currentColor" stroke-width="1.2" fill="none"/><line x1="9.5" y1="9.5" x2="13" y2="13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <input type="text" placeholder="Search" />
        <span class="st-kbd">⌘K</span>
      </div>
      <div class="st-nav">
        <div class="st-grp">Settings</div>
        <div class="st-item on" onclick="selectSetting(this,'profile')">
          <svg viewBox="0 0 14 14"><circle cx="7" cy="4.5" r="3" stroke="currentColor" stroke-width="1" fill="none"/><path d="M2 13a5 5 0 0110 0" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round"/></svg>Profile
        </div>
        <div class="st-item" onclick="selectSetting(this,'appearance')">
          <svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1" fill="none"/><line x1="7" y1="2" x2="7" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="7" y1="10" x2="7" y2="12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="2" y1="7" x2="4" y2="7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="10" y1="7" x2="12" y2="7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>Appearance
        </div>
        <div class="st-item" onclick="selectSetting(this,'speech')">
          <svg viewBox="0 0 14 14"><line x1="4" y1="3" x2="4" y2="11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="7" y1="1" x2="7" y2="13" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="10" y1="4" x2="10" y2="10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>Speech
        </div>
        <div class="st-item" onclick="selectSetting(this,'compute')">
          <svg viewBox="0 0 14 14"><rect x="2" y="2" width="10" height="10" rx="1.5" stroke="currentColor" stroke-width="1" fill="none"/><circle cx="7" cy="7" r="1.5" stroke="currentColor" stroke-width="1" fill="none"/></svg>Computer use
        </div>
        <div class="st-grp">Desktop app</div>
        <div class="st-item" onclick="selectSetting(this,'limits')">
          <svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1" fill="none"/><line x1="7" y1="4" x2="7" y2="8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><circle cx="7" cy="10" r=".4" fill="currentColor"/></svg>Account limits
        </div>
        <div class="st-item" onclick="selectSetting(this,'billing')">
          <svg viewBox="0 0 14 14"><rect x="1.5" y="4.5" width="11" height="7" rx="1.5" stroke="currentColor" stroke-width="1" fill="none"/><circle cx="7" cy="8" r="1.5" stroke="currentColor" stroke-width="1" fill="none"/><line x1="4" y1="4.5" x2="4" y2="3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="10" y1="4.5" x2="10" y2="3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>Billing
        </div>
        <div class="st-item" onclick="selectSetting(this,'privacy')">
          <svg viewBox="0 0 14 14"><rect x="2.5" y="6" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="1" fill="none"/><path d="M4.5 6V4a2.5 2.5 0 015 0v2" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>Privacy
        </div>
        <div class="st-item" onclick="selectSetting(this,'data')">
          <svg viewBox="0 0 14 14"><ellipse cx="7" cy="4" rx="4.5" ry="2" stroke="currentColor" stroke-width="1" fill="none"/><path d="M2.5 4v2.5c0 1.1 2 2 4.5 2s4.5-.9 4.5-2V4" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round"/><path d="M2.5 6.5V9c0 1.1 2 2 4.5 2s4.5-.9 4.5-2V6.5" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round"/></svg>Data controls
        </div>
      </div>
    </div>
    <div class="st-content">
      <div class="st-top">
        <span class="st-title">Settings</span>
        <button class="close" onclick="closeOverlay('overlaySettings')"><svg viewBox="0 0 14 14"><line x1="3" y1="3" x2="11" y2="11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><line x1="11" y1="3" x2="3" y2="11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button>
      </div>
      <div class="st-body">
        <div class="st-section" id="stProfile">
          <h2 class="st-h2">Profile</h2>
          <div class="st-card">
            <div class="st-card-row">
              <div class="st-card-info">
                <div class="st-lbl">Avatar</div>
                <div class="st-desc">Your profile picture representing your account.</div>
              </div>
              <div class="st-av">N</div>
            </div>
