{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-build/schema.json",
  "productName": "NeoTrix",
  "version": "0.18.0",
  "identifier": "ai.neotrix.desktop",
  "build": {
    "beforeDevCommand": "cd \"$(git rev-parse --show-toplevel)/neocodex-frontend\" && npm run dev",
    "beforeBuildCommand": "cd \"$(git rev-parse --show-toplevel)/neocodex-frontend\" && npm ci && npm run build",
    "frontendDist": "../neocodex-frontend/dist",
    "devUrl": "http://localhost:1421"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "NeoTrix Desktop V2",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["windowBackground"],
          "radius": 12
        },
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://cdn.jsdelivr.net http://localhost:* http://127.0.0.1:*; img-src 'self' data: https:; frame-src 'self' http://localhost:* http://127.0.0.1:*; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "appimage",
      "deb",
      "rpm",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.svg",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "openssl",
          "ca-certificates"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.neotrix.ai/update/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0Q0IwQURGMDM3MzI4MUUKUldRZUtITUQzd3JMZFArL0xCM1BQZlpsdHlvUXFWaXc2cEk0WElsL21Sc05oaEgzK2x0RGwvQXQK"
    }
  }
}