{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-build/schema.json",
  "productName": "NeoTrix",
  "version": "0.18.0",
  "identifier": "ai.neotrix.desktop",
  "build": {
    "beforeDevCommand": "cd \"$(git rev-parse --show-toplevel)/neocodex-frontend\" && npm run dev",
    "beforeBuildCommand": "cd \"$(git rev-parse --show-toplevel)/neocodex-frontend\" && npm ci && npm run build",
    "frontendDist": "../neocodex-frontend/dist",
    "devUrl": "http://localhost:1421"
  },
  "app": {
    "windows": [
      {
        "title": "NeoTrix Desktop V2",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; script-src-attr 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' data: https:; frame-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "appimage",
      "msi"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "openssl",
          "ca-certificates"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.neotrix.ai/update/{{target}}/{{current_version}}"
      ],
      "pubkey": "Z6H2pSM2XdraNQHZwul9ygc9EdWnFmV0DASod02i/R0"
    }
  }
}