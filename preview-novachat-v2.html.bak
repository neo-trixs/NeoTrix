  /* ===== Cowork Session Management ===== */
  const CW_DATA = [
    { name:'架构讨论', status:'进行中', tasks:3, done:1, fail:0, agents:[{n:'分析员',on:true},{n:'架构师',on:true},{n:'审查员',on:false}] },
    { name:'代码审查 Sprint', status:'进行中', tasks:5, done:3, fail:0, agents:[{n:'审查员',on:true},{n:'检查员',on:true}] },
    { name:'文档生成', status:'已完成', tasks:2, done:2, fail:0, agents:[{n:'写手',on:false}] },
  ];

  function renderCowork(){
    const sl = document.getElementById('cwSessionList');
    if(!sl) return;
    sl.innerHTML = CW_DATA.map((s,i) => {
      const pct = s.tasks > 0 ? Math.round(s.done/s.tasks*100) : 0;
      return `<div class="cw-sitem${i===0?' active':''}" onclick="selectCwSession(${i})">
        ${escHtml(s.name)}
        <span class="s">${s.done}/${s.tasks} 任务 · ${pct}%</span>
      </div>`;
    }).join('');
    selectCwSession(0);
  }

  function selectCwSession(idx){
    const s = CW_DATA[idx] || CW_DATA[0];
    document.querySelectorAll('.cw-sitem').forEach((el,i) => el.classList.toggle('active', i===idx));
    document.getElementById('cwEmpty').style.display = 'none';
    document.getElementById('cwContent').style.display = 'flex';
    document.getElementById('cwDetailTitle').textContent = escHtml(s.name);
    document.getElementById('cwDetailStatus').textContent = `${s.tasks} 任务 · ${s.done} 完成 · ${s.fail} 失败`;
    document.getElementById('cwHBadge').textContent = s.status;

    const tl = document.getElementById('cwTaskList');
    if(tl){
      const tasks = [];
      for(let i=0;i<s.tasks;i++){
        const done = i < s.done;
        const fail = !done && i < s.done + s.fail;
        tasks.push({ name: done ? `任务 #${i+1}` : (fail ? `任务 #${i+1}` : `任务 #${i+1}`), done, fail });
      }
      tl.innerHTML = tasks.map(t => {
        const cls = t.done ? 'done' : (t.fail ? 'fail' : '');
        const label = t.done ? '已完成' : (t.fail ? '失败' : '进行中');
        return `<div class="cw-task"><span class="dot ${cls}"></span><span class="tname">${escHtml(t.name)}</span><span class="tstat">${label}</span></div>`;
      }).join('');
    }

    const al = document.getElementById('cwAgentList');
    if(al){
      al.innerHTML = s.agents.map(a => {
        const color = a.on ? 'var(--suc)' : 'var(--tx-meta)';
        return `<div class="cw-agent"><span class="adot" style="background:${color}"></span>${escHtml(a.n)}</div>`;
      }).join('');
    }
  }

  /* ===== Code Tab Switching ===== */
  const CODE_SAMPLES = [
    { lang:'Rust', code:'fn main() {\n    println!("Hello, NeoTrix!");\n    let engine = ReasoningEngine::new();\n    engine.run();\n}' },
    { lang:'Rust', code:'pub fn compute(input: &str) -> Result<f64> {\n    let parsed: f64 = input.parse()?;\n    Ok(parsed * std::f64::consts::PI)\n}' },
    { lang:'TOML', code:'[package]\nname = "neotrix"\nversion = "0.19.0"\nedition = "2021"\n\n[dependencies]\nserde = { version = "1", features = ["derive"] }' },
  ];

  function switchCodeTab(el, idx){
    document.querySelectorAll('.cd-tab').forEach(t => t.classList.remove('on'));
    el.classList.add('on');
    const sample = CODE_SAMPLES[idx] || CODE_SAMPLES[0];
    const viewer = document.getElementById('codeViewer');
    if(viewer){
      document.getElementById('codeLang').textContent = sample.lang;
      const lines = sample.code.split('\n').length;
      const nums = Array.from({length:lines}, (_,i) => i+1).join('<br>');
      let html = sample.code;
      const kw = ['fn','pub','let','mut','Result','Ok','f64','std','use','match','for','in','if','else','return','struct','impl','enum','trait'];
      kw.forEach(k => { html = html.replace(new RegExp('\\b'+k+'\\b','g'), '<span class="kw">'+k+'</span>'); });
      html = html.replace(/"([^"]*)"/g, '<span class="hl">"$1"</span>');
      html = html.replace(/\/\/.*/g, m => '<span class="cm">'+escHtml(m)+'</span>');
      html = html.replace(/\b[A-Z]\w+/g, m => '<span class="fn">'+m+'</span>');
      viewer.innerHTML = `<span class="cd-ln">${nums}</span>${html}`;
    }
  }

  function copyCode(){
    const active = document.querySelector('.cd-tab.on');
    const idx = active ? parseInt(active.dataset.file) : 0;
    const sample = CODE_SAMPLES[idx] || CODE_SAMPLES[0];
    navigator.clipboard.writeText(sample.code).then(() => showToast('代码已复制'));
  }

  function switchProvider(val){
    showToast('切换提供者: ' + val);
  }

  function sendMsg(){
    const inp=document.getElementById('chatInput');
    const txt=inp.value.trim();if(!txt)return;
    if(!isChatMode){
      isChatMode=true;
      document.getElementById('heroSection').style.display='none';
      const cs=document.getElementById('chatScroll');
      cs.style.display='flex';
      cs.innerHTML='';
    }
    const s=document.getElementById('chatScroll');
    const d=new Date();
    const t=`${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
    const u=document.createElement('div');u.className='msg r';
    u.innerHTML=`<div class="ma2"><svg class="icon" viewBox="0 0 14 14"><circle cx="7" cy="4.5" r="2.5" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M2 12.5a5 5 0 0110 0" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg></div><div class="mb">${escHtml(txt)}<div class="mb-t">${t}</div></div>`;
    s.appendChild(u);
    inp.value='';inp.style.height='auto';
    document.getElementById('sendBtn').disabled=true;
    s.scrollTop=s.scrollHeight;
    openRbSidebar();
    const ti=document.createElement('div');ti.className='msg l';
    ti.innerHTML='<div class="ma2"><svg class="icon" viewBox="0 0 14 14"><rect x="2" y="3" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none"/><circle cx="7" cy="7" r="1.5" stroke="currentColor" stroke-width="1" fill="none"/></svg></div><div class="mb"><span class="typing"><span></span><span></span><span></span></span></div>';
    s.appendChild(ti);s.scrollTop=s.scrollHeight;
    setTimeout(()=>{
      ti.remove();
      const a=document.createElement('div');a.className='msg l';
      const rs=[
        '好的，我来逐步分析这个问题。',
        '收到，基于当前上下文，这是我的分析结果。',
        '没问题！我已经分析了你的请求，以下是我的思考。'
      ];
      const doc=chatDocs[Math.floor(Math.random()*chatDocs.length)];
      a.innerHTML=`<div class="ma2"><svg class="icon" viewBox="0 0 14 14"><rect x="2" y="3" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none"/><circle cx="7" cy="7" r="1.5" stroke="currentColor" stroke-width="1" fill="none"/></svg></div><div class="mb"><p>${rs[Math.floor(Math.random()*rs.length)]}</p><div class="artifacts"><div class="art-link" onclick="showFilePreviewFromChat('${doc.name}',chatDocs[${chatDocs.indexOf(doc)}].content)"><svg viewBox="0 0 12 12"><path d="M10.5 5v4.5a1 1 0 01-1 1h-7a1 1 0 01-1-1v-7a1 1 0 011-1H5" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.5 1.5h3v3" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M6.5 5.5l4-4" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round"/></svg><span>${doc.name}</span></div></div><span class="sc"></span><div class="mb-t">${t}</div></div>`;
      s.appendChild(a);s.scrollTop=s.scrollHeight;
    },600+Math.random()*400);
  }
  function sendSuggestion(t){
    document.getElementById('chatInput').value=t;
    sendMsg();
  }

  function openSettings(){
    showToast('设置面板 (开发中)');
  }

  /* ===== Missing Functions ===== */
  function clearChat(){
    actions.newChat();
    showToast('已清空对话');
  }

  /* ===== Keyboard Shortcuts ===== */
  document.addEventListener('keydown', e => {
    if((e.metaKey || e.ctrlKey) && e.key === ','){ e.preventDefault(); openSettingsModal(); }
    if((e.metaKey || e.ctrlKey) && e.key === 'k'){ e.preventDefault();
      const inp = document.querySelector('.st-search input');
      if(inp && document.getElementById('overlaySettings').classList.contains('open')){ inp.focus(); return; }
      showToast('按 Cmd+K 搜索设置'); openSettingsModal();
      setTimeout(() => { const si = document.querySelector('.st-search input'); if(si) si.focus(); }, 100);
    }
    if(e.key === 'Escape'){
      document.querySelectorAll('.overlay-panel.open').forEach(p => p.classList.remove('open'));
      closePopover();
      updateTrafficVisibility();
    }
    if(e.key === '?' && !e.target.closest('textarea, input')){
      showToast('快捷键: ⌘, 设置 · ⌘K 搜索 · Esc 关闭 · ? 帮助');
    }
  });

  /* ===== Auto Init ===== */
  // DOM is already loaded at this point (script at end of body)
  renderSidebar('chat');
  renderCowork();
  // Send button state
  const ci = document.getElementById('chatInput');
  if(ci) ci.dispatchEvent(new Event('input'));

  /* ===== POPOVER & SETTINGS MODAL ===== */
  function toggleUserPopover(e){
    const popover = document.getElementById('userPopover');
    if (popover.contains(e.target)) { e.stopPropagation(); return; }
    const isOpen = popover.style.display === 'block';
    if (isOpen) {
      popover.style.display = 'none';
    } else {
      const bar = document.getElementById('userBar');
      const r = bar.getBoundingClientRect();
      popover.style.left = r.left + 'px';
      popover.style.bottom = (window.innerHeight - r.top + 8) + 'px';
      popover.style.display = 'block';
    }
    e.stopPropagation();
  }
  function closePopover(){
    document.getElementById('userPopover').style.display = 'none';
  }
  document.addEventListener('click',function(e){
    const p=document.getElementById('userPopover');
    const b=document.getElementById('userBar');
    if(p.style.display==='block'&&!b.contains(e.target))closePopover();
  });

  function updateTrafficVisibility(){
    const open = document.querySelector('.overlay-panel.open');
    document.querySelector('.traffic').style.opacity = open ? '0' : '1';
    document.querySelector('.traffic').style.pointerEvents = open ? 'none' : 'auto';
  }

  function openOverlay(id){
    const el=document.getElementById(id);
    if(el)el.classList.add('open');
    updateTrafficVisibility();
  }

  function closeOverlay(id){
    const el=document.getElementById(id);
    if(el)el.classList.remove('open');
    updateTrafficVisibility();
  }

  function openSettingsModal(){
    closePopover();
    openOverlay('overlaySettings');
  }

  function selectSetting(el,section){
    document.querySelectorAll('.st-item').forEach(i=>i.classList.remove('on'));
    el.classList.add('on');
    document.querySelectorAll('.st-section').forEach(s=>s.classList.remove('open'));
    const t=document.getElementById('st'+section.charAt(0).toUpperCase()+section.slice(1));
    if(t)t.classList.add('open');
    if(section==='gateway') renderStGateway();
  }

  function renderStGateway(){
    const llmEl = document.getElementById('stGwLlmList');
    if(llmEl) llmEl.innerHTML = FREE_LLM_DATA.map(p => {
      const cls = p.good ? 'good' : 'dead';
      const barW = p.good ? Math.max(30, 100 - p.lat / 6) : 0;
      const barColor = p.lat < 400 ? 'var(--suc)' : p.lat < 700 ? 'var(--yellow)' : 'var(--des)';
      return `<div class="px-item"><span class="px-iname">${p.name}</span><span class="px-iprov">${p.prov}</span><span class="px-idot ${cls}"></span><div class="px-ibar"><div class="px-ibar-f" style="width:${barW}%;background:${barColor}"></div></div><span class="px-ilat">${p.good ? p.lat + 'ms' : '—'}</span><span class="px-irpm">${p.rpm}</span></div>`;
    }).join('');
    document.getElementById('stGwLlmMeta').textContent = FREE_LLM_DATA.filter(p=>p.good).length + '/' + FREE_LLM_DATA.length + ' 在线';

    const nodeEl = document.getElementById('stGwNodeList');
    if(nodeEl) nodeEl.innerHTML = PROXY_DATA.map(p => {
      const cls = p.good ? 'good' : 'dead';
      const barW = p.good ? Math.max(30, 100 - p.lat / 2) : 0;
      const barColor = p.lat < 60 ? 'var(--suc)' : p.lat < 120 ? 'var(--yellow)' : 'var(--des)';
      return `<div class="px-item"><span class="px-ireg">${p.reg}</span><span class="px-iname">${p.name}</span><span class="px-idot ${cls}"></span><div class="px-ibar"><div class="px-ibar-f" style="width:${barW}%;background:${barColor}"></div></div><span class="px-ilat">${p.good ? p.lat + 'ms' : '—'}</span></div>`;
    }).join('');
    document.getElementById('stGwNodeMeta').textContent = PROXY_DATA.filter(p=>p.good).length + '/' + PROXY_DATA.length + ' 在线';
  }

  /* ════════════════════════════════════════════════
     NovaChat Enhancements — functional only
     ════════════════════════════════════════════════ */

  /* === Stacked Toast === */
  function showToast(msg){
    const stack=document.getElementById('toastStack');
    const t=document.createElement('div');t.className='toast-item';
    t.textContent=msg;
    stack.appendChild(t);
    requestAnimationFrame(()=>t.classList.add('show'));
    setTimeout(()=>{t.classList.remove('show');t.classList.add('hide');setTimeout(()=>t.remove(),250);},1500);
  }

  function autoResize(el){
    el.style.height='auto';
    el.style.height=Math.min(el.scrollHeight,160)+'px';
  }
  function handleKey(e){
    const inp=e.target;
    if(e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); sendMsg(); return; }
    document.getElementById('sendBtn').disabled=!inp.value.trim();
  }
  function escHtml(str){
    if(!str)return'';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  /* === Enhanced sendMsg with tool calls, code blocks, actions === */
  function sendMsg(){
    const inp=document.getElementById('chatInput');
    const txt=inp.value.trim();if(!txt)return;
    if(!isChatMode){
      isChatMode=true;
      document.getElementById('heroSection').style.display='none';
      const cs=document.getElementById('chatScroll');
      cs.style.display='flex';
      cs.innerHTML='';
    }
    const s=document.getElementById('chatScroll');
    const d=new Date();
    const t=`${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
    const u=document.createElement('div');u.className='msg r';
    u.innerHTML=`<div class="ma2"><svg class="icon" viewBox="0 0 14 14"><circle cx="7" cy="4.5" r="2.5" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M2 12.5a5 5 0 0110 0" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg></div><div class="mb">${escHtml(txt)}<div class="mb-t">${t}</div></div>`;
    s.appendChild(u);
    inp.value='';inp.style.height='auto';
    document.getElementById('sendBtn').disabled=true;
    s.scrollTop=s.scrollHeight;
    openRbSidebar();

    const ti=document.createElement('div');ti.className='msg l';
    ti.innerHTML='<div class="ma2"><svg class="icon" viewBox="0 0 14 14"><rect x="2" y="3" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none"/><circle cx="7" cy="7" r="1.5" stroke="currentColor" stroke-width="1" fill="none"/></svg></div><div class="mb"><span class="typing"><span></span><span></span><span></span></span></div>';
    s.appendChild(ti);s.scrollTop=s.scrollHeight;

    setTimeout(()=>{
      ti.remove();
      const rs=[
        '好的，我来逐步分析这个问题。',
        '收到，基于当前上下文，这是我的分析结果。',
        '没问题！我已经分析了你的请求，以下是我的思考。'
      ];
      const doc=chatDocs[Math.floor(Math.random()*chatDocs.length)];
      const replyText=rs[Math.floor(Math.random()*rs.length)];
      const mb = document.createElement('div');mb.className='mb';

      /* Tool calls */
      const tc1=document.createElement('div');tc1.className='tc done';
      tc1.innerHTML='<div class="tc-icon"><svg viewBox="0 0 14 14"><polyline points="2,7 5,10 12,4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div><span class="tc-name">搜索知识库</span><span class="tc-status">3 条结果</span>';
      mb.appendChild(tc1);

      const p=document.createElement('p');p.textContent=replyText;mb.appendChild(p);

      /* Code block */
      const codeSample='fn analyze(state: &E8State) -> f64 {\n    match state {\n        E8State::Ground => 0.92,\n        E8State::Arousal => 0.78,\n        E8State::Flow => 0.95,\n        _ => 0.5,\n    }\n}';
      const codeBlock=document.createElement('div');codeBlock.className='cb';
      const lines = codeSample.split('\n').length;
      const nums = Array.from({length:lines},(_,i)=>i+1).join('\n');
      codeBlock.innerHTML=`<div class="cb-h"><span class="cb-lang">rust</span><button class="cb-copy" onclick="navigator.clipboard.writeText('${escHtml(codeSample)}').then(()=>showToast('已复制'))"><svg viewBox="0 0 12 12"><rect x="2.5" y="1.5" width="7" height="9" rx="1" stroke="currentColor" stroke-width="1.1" fill="none"/><path d="M1 4v6.5a1 1 0 001 1H8" stroke="currentColor" stroke-width="1.1" fill="none"/></svg></button></div><div class="cb-body"><span class="cb-ln">${nums}</span><span class="cb-code">fn <span style="color:#D73A49">analyze</span>(state: &amp;E8State) -&gt; f64 {\n    match state {\n        E8State::Ground =&gt; 0.92,\n        E8State::Arousal =&gt; 0.78,\n        E8State::Flow =&gt; 0.95,\n        _ =&gt; 0.5,\n    }\n}</span></div>`;
      mb.appendChild(codeBlock);

      /* Citations */
      const cit=document.createElement('div');cit.style.cssText='display:flex;gap:4px;margin:6px 0;flex-wrap:wrap';
      cit.innerHTML='<span style="padding:2px 8px;border-radius:10px;background:var(--ghost);border:1px solid var(--bd);font-size:10px;color:var(--tx2)">E8 状态机 · L4</span><span style="padding:2px 8px;border-radius:10px;background:var(--ghost);border:1px solid var(--bd);font-size:10px;color:var(--tx2)">GWT 谐振网络 · L5</span>';
      mb.appendChild(cit);

      /* Artifacts */
      const artDiv=document.createElement('div');artDiv.className='artifacts';
      artDiv.innerHTML=`<div class="art-link" onclick="showFilePreviewFromChat('${doc.name}',chatDocs[${chatDocs.indexOf(doc)}].content)"><svg viewBox="0 0 12 12"><path d="M10.5 5v4.5a1 1 0 01-1 1h-7a1 1 0 01-1-1v-7a1 1 0 011-1H5" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.5 1.5h3v3" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M6.5 5.5l4-4" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="round"/></svg><span>${doc.name}</span></div>`;
      mb.appendChild(artDiv);

      /* Timestamp */
      const mt=document.createElement('div');mt.className='mb-t';mt.textContent=t;
      mb.appendChild(mt);

      /* Message actions */
      const actions=document.createElement('div');actions.className='ma-actions';
      const icons = [
        {n:'copy',d:'M8.5 3.5h2a1 1 0 011 1v5a1 1 0 01-1 1h-5a1 1 0 01-1-1v-2'}, // copy
        {n:'thumbs',d:'M7 12.5c-2 0-3.5-1-4.5-3h-1v-5h1C4 2 5.5 1.5 7 1.5c2 0 3 1.5 2.5 3.5h2a1 1 0 011 1v2a1 1 0 01-1 1h-1.5'}, // thumbs up
        {n:'thumbs',d:'M7 1.5c2 0 3.5 1 4.5 3h1v5h-1C10 12 8.5 12.5 7 12.5c-2 0-3-1.5-2.5-3.5h-2a1 1 0 01-1-1v-2a1 1 0 011-1h1.5'}, // thumbs down
        {n:'refresh',d:'M1.5 7A5.5 5.5 0 017 1.5 5.5 5.5 0 0112.5 7'}, // refresh
      ];
      icons.forEach((ic,i)=>{
        const btn=document.createElement('button');btn.className='ma-btn'+(i===1?' on':'');
        btn.innerHTML=`<svg viewBox="0 0 14 14"><path d="${ic.d}" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>${ic.n==='copy'?'<line x1="6" y1="7" x2="10" y2="7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>':''}${ic.n==='thumbs'?'<circle cx="7" cy="12" r=".5" fill="currentColor"/>':''}${ic.n==='refresh'?'<polyline points="9,4.5 12.5,7 9,9.5" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>':''}</svg>`;
        btn.onclick=(e)=>{e.stopPropagation();showToast(['已复制','已赞','已踩','已重新生成'][i]);};
        actions.appendChild(btn);
      });
      mb.appendChild(actions);

      const a=document.createElement('div');a.className='msg l';
      a.appendChild(mb);
      s.appendChild(a);s.scrollTop=s.scrollHeight;
    },600+Math.random()*400);
  }

  /* === Command Palette === */
  function openCommandPalette(){
    const p=document.getElementById('cmdPalette');
    p.style.display='flex';
    const inp=document.getElementById('cpInput');
    inp.value='';inp.focus();
    filterCommands('');
  }

  function filterCommands(q){
    const commands = [
      {grp:'对话',name:'新对话',kbd:'⌘N',action:"actions.newChat()"},
      {grp:'对话',name:'清空对话',kbd:'⌘⇧C',action:"clearChat()"},
      {grp:'视图',name:'切换到对话',kbd:'⌘1',action:"switchView(document.querySelector('.segb[data-view=chat]'),'chat')"},
      {grp:'视图',name:'切换到协同',kbd:'⌘2',action:"switchView(document.querySelector('.segb[data-view=cowork]'),'cowork')"},
      {grp:'视图',name:'切换到代码',kbd:'⌘3',action:"switchView(document.querySelector('.segb[data-view=code]'),'code')"},
      {grp:'设置',name:'打开设置',kbd:'⌘,',action:"openSettingsModal()"},
      {grp:'设置',name:'切换主题',kbd:'',action:"toggleTheme()"},
      {grp:'设置',name:'快捷键',kbd:'⌘?',action:"openKeyboardShortcuts()"},
    ];
    const el=document.getElementById('cpResults');
    const ql=q.toLowerCase();
    const filtered = commands.filter(c=>c.name.toLowerCase().includes(ql)||c.grp.toLowerCase().includes(ql));
    const groups = {};
    filtered.forEach(c=>{if(!groups[c.grp])groups[c.grp]=[];groups[c.grp].push(c);});
    el.innerHTML=Object.entries(groups).map(([grp,cmds])=>`<div class="cp-grp"><div class="cp-grp-label">${grp}</div>${cmds.map(c=>`<button class="cp-item" onclick="document.getElementById('cmdPalette').style.display='none';${c.action}"><svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="1" fill="currentColor"/></svg>${c.name}${c.kbd?'<span class="cp-kbd">'+c.kbd+'</span>':''}</button>`).join('')}</div>`).join('');
  }

  /* === Keyboard Shortcuts Panel === */
  function openKeyboardShortcuts(){
    document.getElementById('keyboardShortcuts').style.display='flex';
  }

  /* === Code Output === */
  function toggleCodeOutput(){
    document.getElementById('codeOutput').classList.toggle('open');
  }
  function runCode(){
    const ob=document.getElementById('codeOutputBody');
    const output=document.getElementById('codeOutput');
    output.classList.add('open');
    const steps=[
      {text:'$ cargo build --release', cls:'info'},
      {text:'Compiling neotrix-core v0.19.0', cls:'ok'},
      {text:'Compiling neotrix-frontend v0.19.0', cls:'ok'},
      {text:'Finished release [optimized] target(s) in 3.42s', cls:'ok'},
    ];
    ob.innerHTML='';
    steps.forEach((s,i)=>{
      setTimeout(()=>{
        ob.innerHTML+=`<span class="${s.cls}">${escHtml(s.text)}</span>\n`;
        ob.scrollTop=ob.scrollHeight;
      },i*300);
    });
  }

  /* Add run button handler */
  document.querySelector('.cd-tb-btn[title="运行"]').onclick = function(){
    showToast('运行中...');
    runCode();
  };

  /* === Enhanced Keyboard Shortcuts === */
  document.addEventListener('keydown', e => {
    const m = e.metaKey || e.ctrlKey;
    if(m && e.key === 'k'){ e.preventDefault();
      if(document.getElementById('overlaySettings').classList.contains('open')){
        const si=document.querySelector('.st-search input');if(si)si.focus();return;
      }
      openCommandPalette();
    }
    if(m && e.key === '/'){ e.preventDefault(); document.getElementById('chatInput').focus(); }
    if(m && e.key === 'n'){ e.preventDefault(); actions.newChat(); }
    if(m && e.shiftKey && e.key === 'C'){ e.preventDefault(); clearChat(); }
    if(m && e.key === 'b'){ e.preventDefault(); toggleSidebar(); }
    if(m && e.key === '1'){ e.preventDefault(); switchView(document.querySelector('.segb[data-view="chat"]'),'chat'); }
    if(m && e.key === '2'){ e.preventDefault(); switchView(document.querySelector('.segb[data-view="cowork"]'),'cowork'); }
    if(m && e.key === '3'){ e.preventDefault(); switchView(document.querySelector('.segb[data-view="code"]'),'code'); }
    if(e.key === '?' && !e.target.closest('textarea, input')){ openKeyboardShortcuts(); }
  });

  function toggleTheme(){
    const h=document.documentElement;
    const isDark=h.getAttribute('data-theme')==='dark';
    h.setAttribute('data-theme',isDark?'light':'dark');
    const lbl=document.getElementById('popThemeLabel');
    if(lbl)lbl.textContent=isDark?'亮色':'暗色';
    showToast(isDark?'已切换为亮色模式':'已切换为暗色模式');
  }

  function toggleSidebar(){
    document.querySelector('.sb').classList.toggle('collapsed');
  }

</script>

<!-- Stacked Toast Container -->
<div class="toast-stack" id="toastStack"></div>

<!-- Command Palette Overlay -->
<div class="overlay-panel" id="cmdPalette" style="display:none" onclick="if(event.target===this)this.style.display='none'">
  <div class="overlay-box" style="max-width:380px;margin-top:10vh">
    <div class="cp-search">
      <svg viewBox="0 0 14 14"><circle cx="6" cy="6" r="3.5" stroke="currentColor" stroke-width="1.2" fill="none"/><line x1="9" y1="9" x2="12.5" y2="12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      <input type="text" id="cpInput" placeholder="搜索命令..." oninput="filterCommands(this.value)" autofocus />
    </div>
    <div id="cpResults" style="max-height:300px;overflow-y:auto"></div>
  </div>
</div>

<!-- Keyboard Shortcuts Overlay -->
<div class="overlay-panel" id="keyboardShortcuts" style="display:none" onclick="if(event.target===this)this.style.display='none'">
  <div class="overlay-box" style="max-width:320px;margin-top:12vh">
    <div class="overlay-h"><h2 style="font-size:14px;font-weight:600">快捷键</h2><div class="tlg-close"><span class="tlg-dot tlg-r" onclick="document.getElementById('keyboardShortcuts').style.display='none'" title="关闭"></span></div></div>
    <div class="overlay-bd">
      <div class="ks-grid">
        <div class="ks-row"><span class="ks-key">⌘K</span><span class="ks-desc">命令面板</span></div>
        <div class="ks-row"><span class="ks-key">⌘/</span><span class="ks-desc">搜索/技能</span></div>
        <div class="ks-row"><span class="ks-key">⌘N</span><span class="ks-desc">新对话</span></div>
        <div class="ks-row"><span class="ks-key">⌘⇧C</span><span class="ks-desc">清空对话</span></div>
        <div class="ks-row"><span class="ks-key">⌘B</span><span class="ks-desc">切换侧栏</span></div>
        <div class="ks-row"><span class="ks-key">⌘,</span><span class="ks-desc">设置</span></div>
        <div class="ks-row"><span class="ks-key">⌘?</span><span class="ks-desc">快捷键</span></div>
      </div>
    </div>
  </div>
</div>

</body>
</html>
