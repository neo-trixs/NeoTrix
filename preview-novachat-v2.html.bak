          <svg viewBox="0 0 14 14"><ellipse cx="7" cy="4" rx="4.5" ry="2" stroke="currentColor" stroke-width="1" fill="none"/><path d="M2.5 4v2.5c0 1.1 2 2 4.5 2s4.5-.9 4.5-2V4" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round"/><path d="M2.5 6.5V9c0 1.1 2 2 4.5 2s4.5-.9 4.5-2V6.5" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="round"/></svg>数据控制
