            <div class="px-kpi-card"><div class="px-kpi-val">12</div><div class="px-kpi-lbl">代理节点</div><span class="px-kpi-trend up">↑ 2</span></div>
            <div class="px-kpi-card"><div class="px-kpi-val">92%</div><div class="px-kpi-lbl">可用率</div><span class="px-kpi-trend up">↑ 0.5%</span></div>
          </div>
